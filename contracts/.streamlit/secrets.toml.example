# Kopiuj do secrets.toml lokalnie LUB ustaw te wartości w panelu Streamlit Cloud
# (Settings → Secrets). Plik secrets.toml jest gitignored.
#
# Hasło dostępowe — bez tego apka jest otwarta publicznie (NIE rób tego w produkcji)
APP_PASSWORD = "ustaw-tutaj-jakies-bezpieczne-haslo"

# SMTP — wybierz JEDEN z poniższych zestawów (Hostinger ZALECANY)

# Wariant A — Hostinger (kontakt@hoopconnect.pl)
# Używa Twojego hasła do skrzynki w Hostinger Email. Maile lecą "from"
# Twojego prawdziwego adresu, bez sztuczek typu "via gmail.com".
SMTP_HOST = "smtp.hostinger.com"
SMTP_PORT = "465"
SMTP_USER = "kontakt@hoopconnect.pl"
SMTP_PASSWORD = "<haslo-do-skrzynki>"   # Hasło logowania do hPanel → Email
SMTP_FROM = "kontakt@hoopconnect.pl"
SMTP_FROM_NAME = "Mikołaj Kretowicz · HoopConnect"

# Wariant B — Gmail App Password (alternatywa)
# Działa, ale w nagłówku może być widać "via gmail.com" dla niektórych klientów.
# Wygeneruj na myaccount.google.com → Security → 2-Step Verification → App passwords.
# SMTP_HOST = "smtp.gmail.com"
# SMTP_PORT = "587"
# SMTP_USER = "twoj.gmail@gmail.com"
# SMTP_PASSWORD = "xxxxxxxxxxxxxxxx"   # 16 znaków BEZ spacji
# SMTP_FROM = "kontakt@hoopconnect.pl"
# SMTP_FROM_NAME = "Mikołaj Kretowicz · HoopConnect"
