# Kopiuj do secrets.toml lokalnie LUB ustaw te wartości w panelu Streamlit Cloud
# (Settings → Secrets). Plik secrets.toml jest gitignored.
#
# Hasło dostępowe — bez tego apka jest otwarta publicznie (NIE rób tego w produkcji)
APP_PASSWORD = "ustaw-tutaj-jakies-bezpieczne-haslo"

# SMTP — przykład Gmail App Password (wygeneruj na myaccount.google.com → Security
# → 2-Step Verification → App passwords; 16-znakowy kod)
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USER = "kontakt@hoopconnect.pl"
SMTP_PASSWORD = "xxxxxxxxxxxxxxxx"   # App Password z Google (16 znaków, BEZ spacji)
SMTP_FROM = "kontakt@hoopconnect.pl"
SMTP_FROM_NAME = "Mikołaj Kretowicz · HoopConnect"
