---
/**
 * PlayerCard — 1:1 port karty zawodnika z aplikacji (src/components/ui/PlayerCard3D.jsx + HexAvatar.jsx).
 * Płaska plakietka keycard (clip-path na .pc3d-face), tilt przez --rx/--ry na .pc3d-card,
 * holograficzny połysk liczony z tiltu. Wymiar bazowy 300x452, skalowanie przez --pcs na wrapperze.
 * Style są globalne (is:global), bo karty stylują też strony (skala, przyciemnienie, tryb podglądu).
 *
 * Wydajność (wygląd bez zmian względem apki):
 * - Cień karty nie jest filtrem na obracanej warstwie, tylko osobnym, nieruchomym elementem .pc3d-sh
 *   w środku karty. Przeglądarka maluje go raz razem z kartą, zamiast liczyć rozmycie przy każdej
 *   klatce, w której coś się rusza w pobliżu (błysk po liniach, obrót karty).
 * - Połysk (.pc3d-holo, .pc3d-spec) to gotowy gradient na warstwie, którą tilt obraca i przesuwa
 *   transformem. Matematycznie daje to ten sam obraz, co gradient z kątem i środkiem liczonym z tiltu,
 *   ale ruch karty nie wymusza przemalowania. Stare przeglądarki (bez sin() w CSS) zostają przy gradiencie.
 * - Zmienna --pc-edge (opcjonalna, ustawia strona) dokłada do cienia jasną krawędź karty.
 * Ikonki aren to miniatury WebP 128 px (public/arenas/thumb, robi je scripts/optimize-assets.mjs):
 * na karcie mają 32 px, więc oryginały PNG 500 px (po ~230 kB) byłyby czystym balastem.
 */
interface Props {
  name: string          // tu: nazwa pozycji (karty poglądowe bez nazwisk)
  letter: string        // inicjał w hexie
  arena: number         // 1..6 (indeks grafiki areny)
  arenaName: string
  nextArena?: string
  pct: number           // % paska XP do następnej areny
  toNext: number        // ile XP brakuje
  wins: number
  kotc: number
  hcId: string
  frame?: 'default' | 'none'
  uid: string           // unikalne id gradientu SVG
  lazy?: boolean        // karta poniżej pierwszego ekranu: grafiki doładowują się przy scrollu
  background?: string   // adres obrazu tła karty (apka: card_items.asset_path); bez niego karta wygląda jak dotąd
}
// Tilt spoczynkowy bierze się z --rx0/--ry0 ustawianych przez rodzica (np. hover prostuje kartę).
const { name, letter, arena, arenaName, nextArena, pct, toNext, wins, kotc, hcId, frame = 'default', uid, lazy = false, background } = Astro.props
const load = lazy ? 'lazy' : undefined
const p = Math.max(6, Math.min(100, pct))
---
<div class="pc3d-wrap">
  <div class="pc3d-card">
    <div class="pc3d-sh" aria-hidden="true"><i class="pc3d-sil"></i></div>
    <div class:list={['pc3d-face', 'pc3d-sil', { 'pc3d-hasbg': !!background }]}>
      {background && <div class="pc3d-bg" style={`background-image:url("${background}")`}></div>}
      <div class="pc3d-holo"></div>
      <div class="pc3d-spec"></div>
      <div class="pc3d-slot"></div>
      <div class="pc3d-content">
        <div class="pc3d-hdr">
          <img src="/hoop.svg" alt="" width="26" height="26" />
          <div class="pc3d-wm">HOOP<i>CONNECT</i></div>
        </div>

        <div class="pc3d-av">
          <svg width="118" height="118" viewBox="-16 -16 122 122" style="flex-shrink:0; overflow:visible" aria-hidden="true">
            <defs>
              <linearGradient id={`av-${uid}`} x1="20%" y1="0%" x2="80%" y2="100%">
                <stop offset="0%" stop-color="#7BC8F8" /><stop offset="40%" stop-color="#5BB8F5" /><stop offset="100%" stop-color="#1B3A6B" />
              </linearGradient>
              <filter id={`gf-${uid}`} x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="6" /></filter>
            </defs>
            <polygon points="45,-6 93,22 93,68 45,96 -3,68 -3,22" fill="none" stroke="rgba(91,184,245,0.55)" stroke-width="18" filter={`url(#gf-${uid})`} opacity="0.55" />
            <polygon points="45,9 84,33 84,61 45,87 6,61 6,33" fill="rgba(0,0,0,0.30)" />
            <polygon points="45,6 82,32 82,58 45,84 8,58 8,32" fill={`url(#av-${uid})`} />
            <polygon points="45,6 8,32 45,42" fill="rgba(255,255,255,0.28)" />
            <polygon points="45,6 82,32 45,42" fill="rgba(255,255,255,0.13)" />
            <polygon points="8,32 8,58 45,48 45,42" fill="rgba(91,184,245,0.15)" />
            <polygon points="82,32 82,58 45,48 45,42" fill="rgba(0,0,0,0.22)" />
            <polygon points="45,6 82,32 82,58 45,84 8,58 8,32" fill="none" stroke="rgba(255,255,255,0.40)" stroke-width="1.5" stroke-linejoin="round" />
            <text x="45" y="49" text-anchor="middle" dominant-baseline="middle" fill="white" font-size="30" font-weight="800" font-family="'Barlow Condensed', Barlow, sans-serif">{letter}</text>
            {frame !== 'none' && <image href="/frames/earlyaccess.webp" x="-16" y="-16" width="122" height="122" preserveAspectRatio="xMidYMid meet" />}
          </svg>
        </div>

        <div class="pc3d-name">{name}</div>
        <div class="pc3d-arena">{arenaName} · Arena {arena}</div>

        <div class="pc3d-prog">
          <img class="pc3d-ah" src={`/arenas/thumb/arena-${arena}.webp`} alt="" width="32" height="32" loading={load} decoding="async" />
          <div class="pc3d-track">
            <div class="pc3d-fill" style={`width:${p}%`}></div>
            <div class="pc3d-node" style={`left:${p}%`}></div>
          </div>
          {nextArena && arena < 6 && <img class="pc3d-ah next" src={`/arenas/thumb/arena-${arena + 1}.webp`} alt="" width="32" height="32" loading={load} decoding="async" />}
        </div>
        <div class="pc3d-cap">
          {nextArena ? <>Jeszcze <b>{toNext} XP</b> do areny {nextArena}</> : <>Szczyt osiągnięty, <b>{arenaName}</b></>}
        </div>

        <div class="pc3d-stats">
          <div class="pc3d-stat"><b>{wins}</b><span>Wygrane mecze</span></div>
          <div class="pc3d-stat"><b>{kotc}</b><span>Wygrane KotC</span></div>
        </div>

        <div class="pc3d-foot">
          <div class="id">HC-ID · <b>{hcId}</b></div>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* Wrapper rezerwuje przeskalowany footprint (transform nie zmienia boxu layoutu). */
  .pc3d-wrap { --pcs: 1; width: calc(300px * var(--pcs)); height: calc(452px * var(--pcs)); position: relative; }
  /* Skala od lewego górnego rogu (footprint wrappera), ale OBRÓT wokół środka karty, jak w apce:
     translate do środka (150, 226) → perspektywa i obrót → translate z powrotem. */
  .pc3d-card { --rx: var(--rx0, -8); --ry: var(--ry0, -14); position: absolute; top: 0; left: 0; width: 300px; height: 452px;
    transform-origin: 0 0;
    transform: scale(var(--pcs)) translate(150px, 226px) perspective(1150px)
      rotateX(calc(var(--rx)*1deg)) rotateY(calc(var(--ry)*1deg)) translate(-150px, -226px);
    transition: transform .35s cubic-bezier(.2,.7,.2,1);
    user-select: none; -webkit-user-select: none; }
  /* Cień (i opcjonalna jasna krawędź) sylwetki: malowany raz, razem z warstwą karty */
  .pc3d-sh { position: absolute; inset: 0; pointer-events: none; filter: drop-shadow(0 9px 18px rgba(0,0,0,0.34)) var(--pc-edge,); }
  .pc3d-sh i { position: absolute; inset: 0; background: #0d1f38; }
  .pc3d-sil { clip-path: path('M22,0 L278,0 Q300,0 300,22 L300,400 Q300,414 286,414 L210,414 Q196,414 192,428 L182,440 Q178,452 164,452 L22,452 Q0,452 0,430 L0,22 Q0,0 22,0 Z'); }
  .pc3d-face { position: absolute; inset: 0; padding: 18px 20px 14px; display: flex; flex-direction: column;
    background: linear-gradient(157deg, #16304f 0%, #0d1f38 46%, #0a1830 100%); border: 1px solid rgba(150,200,255,.28); }
  .pc3d-face::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 40%;
    background: linear-gradient(180deg, rgba(150,205,255,.16), transparent); pointer-events: none; }
  /* Tło karty (opcjonalne): obraz + gradientowa nakładka, żeby tekst był czytelny; karta z tłem ma cieplejszy połysk */
  .pc3d-bg { position: absolute; inset: 0; z-index: 0; background-size: cover; background-position: center; background-repeat: no-repeat; }
  .pc3d-bg::after { content: ''; position: absolute; inset: 0;
    background: linear-gradient(158deg, rgba(236,72,153,.30) 0%, rgba(168,60,224,.30) 46%, rgba(30,8,50,.66) 100%); }
  .pc3d-holo { position: absolute; inset: 0; pointer-events: none; z-index: 4; mix-blend-mode: screen; opacity: .5;
    background: linear-gradient(calc(118deg + var(--ry)*1.6deg),
      rgba(0,240,220,0) 8%, rgba(120,200,255,.42) 30%, rgba(190,130,255,.42) 46%,
      rgba(255,150,210,.30) 56%, rgba(120,255,220,.34) 72%, rgba(0,240,220,0) 92%); }
  .pc3d-hasbg .pc3d-holo { opacity: .58;
    background: linear-gradient(calc(118deg + var(--ry)*1.6deg),
      rgba(255,120,210,0) 8%, rgba(255,120,210,.42) 28%, rgba(190,110,255,.46) 46%,
      rgba(255,185,120,.34) 60%, rgba(120,220,255,.30) 74%, rgba(255,120,210,0) 92%); }
  .pc3d-spec { position: absolute; inset: 0; pointer-events: none; z-index: 5; mix-blend-mode: screen;
    background: radial-gradient(120% 80% at calc(50% + var(--ry)*1.5%) calc(38% - var(--rx)*1.4%),
      rgba(255,255,255,.4), rgba(255,255,255,.05) 40%, transparent 60%); }
  .pc3d-slot { position: absolute; top: 8px; left: 50%; transform: translateX(-50%); z-index: 7; width: 54px; height: 9px;
    border-radius: 999px; background: #050c18; box-shadow: inset 0 1px 2px rgba(0,0,0,.8), 0 1px 0 rgba(150,200,255,.14); }
  .pc3d-content { position: relative; z-index: 6; display: flex; flex-direction: column; height: 100%; }
  .pc3d-hdr { display: flex; align-items: center; gap: 9px; margin-top: 10px; margin-bottom: 4px; }
  .pc3d-hdr img { width: 26px; height: 26px; flex: none; filter: drop-shadow(0 2px 6px rgba(60,140,220,.5)); }
  .pc3d-wm { font-family: var(--display); font-weight: 900; font-size: 20px; letter-spacing: .06em; text-transform: uppercase; line-height: 1; color: #EAF2FF; }
  .pc3d-wm i { font-style: normal; color: #5BB8F5; }
  .pc3d-av { display: flex; justify-content: center; margin: 6px auto 2px; }
  .pc3d-name { text-align: center; font-family: var(--display); font-weight: 900; font-size: 28px; letter-spacing: .01em; text-transform: uppercase; line-height: 1; margin-top: 6px; color: #F2F7FF; }
  .pc3d-arena { text-align: center; font-family: var(--display); font-weight: 700; font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: #8FD3FF; margin-top: 5px; }
  .pc3d-prog { display: flex; align-items: center; gap: 11px; margin: 10px 2px 0; }
  .pc3d-ah { width: 32px; height: 32px; object-fit: contain; flex: none; filter: drop-shadow(0 2px 8px rgba(0,0,0,.5)); }
  .pc3d-ah.next { opacity: .38; filter: grayscale(.5) drop-shadow(0 2px 6px rgba(0,0,0,.4)); }
  .pc3d-track { flex: 1; position: relative; height: 6px; border-radius: 999px; background: rgba(150,200,255,.13); box-shadow: inset 0 0 0 1px rgba(150,200,255,.06); }
  .pc3d-fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 999px; background: linear-gradient(90deg, #1E6BB0, #8FD3FF); box-shadow: 0 0 12px rgba(120,200,255,.55); }
  .pc3d-node { position: absolute; top: 50%; width: 11px; height: 11px; border-radius: 50%; transform: translate(-50%,-50%); background: #EAF7FF; box-shadow: 0 0 10px 2px rgba(150,220,255,.9), 0 0 0 3px rgba(120,200,255,.22); }
  .pc3d-cap { text-align: center; margin-top: 7px; font-family: var(--display); font-weight: 700; font-size: 9.5px; letter-spacing: .12em; text-transform: uppercase; color: #86a6c6; }
  .pc3d-cap b { color: #8FD3FF; }
  .pc3d-stats { display: flex; gap: 7px; margin-top: 11px; }
  .pc3d-stat { flex: 1; text-align: center; background: rgba(8,20,40,.5); border: 1px solid rgba(150,200,255,.12); border-radius: 10px; padding: 8px 4px; }
  .pc3d-stat b { display: block; font-family: var(--display); font-weight: 900; font-size: 17px; color: #EAF2FF; line-height: 1; }
  .pc3d-stat span { font-family: var(--display); font-weight: 700; font-size: 8px; letter-spacing: .12em; color: #7d9cbb; text-transform: uppercase; }
  .pc3d-foot { margin-top: auto; padding-top: 12px; border-top: 1px solid rgba(150,200,255,.12); }
  .pc3d-foot .id { font-family: var(--display); font-weight: 700; font-size: 9px; letter-spacing: .1em; color: #6f8dab; line-height: 1.5; }
  .pc3d-foot .id b { color: #a9c6e4; }

  /* Połysk bez przemalowywania: gradient stoi na warstwie, tilt ją obraca (holo) i przesuwa (spec).
     holo: linear-gradient(0deg) na kwadracie 560 px, obrót o kąt gradientu i skala wzdłuż osi tak,
     żeby długość linii gradientu była taka, jak dla prostokąta 300x452 pod tym kątem (|sin|*300 + |cos|*452).
     spec: elipsa 360 x 361.6 px (czyli 120% x 80% karty) na polu 434 px, przesuwana o tyle, o ile
     przesuwał się środek gradientu (1.5% szerokości i 1.4% wysokości na stopień). */
  @supports (width: calc(1px * sin(1deg))) {
    .pc3d-holo { inset: auto; left: 50%; top: 50%; width: 560px; height: 560px; margin: -280px 0 0 -280px;
      --ha: calc(118deg + var(--ry) * 1.6deg);
      background: linear-gradient(0deg,
        rgba(0,240,220,0) 8%, rgba(120,200,255,.42) 30%, rgba(190,130,255,.42) 46%,
        rgba(255,150,210,.30) 56%, rgba(120,255,220,.34) 72%, rgba(0,240,220,0) 92%);
      transform: rotate(var(--ha)) scaleY(calc((max(sin(var(--ha)), -1 * sin(var(--ha))) * 300 + max(cos(var(--ha)), -1 * cos(var(--ha))) * 452) / 560)); }
    .pc3d-hasbg .pc3d-holo { background: linear-gradient(0deg,
      rgba(255,120,210,0) 8%, rgba(255,120,210,.42) 28%, rgba(190,110,255,.46) 46%,
      rgba(255,185,120,.34) 60%, rgba(120,220,255,.30) 74%, rgba(255,120,210,0) 92%); }
    .pc3d-spec { inset: auto; left: -67px; top: -45.24px; width: 434px; height: 434px;
      background: radial-gradient(360px 361.6px at 50% 50%, rgba(255,255,255,.4), rgba(255,255,255,.05) 40%, transparent 60%);
      transform: translate(calc(var(--ry) * 4.5px), calc(var(--rx) * -6.328px)); }
  }
  /* Karta sterowana skryptem (.pc-live): transformy idą wprost z JS na trzy elementy, a połysk ma własne warstwy,
     więc ruch to samo składanie warstw na karcie graficznej, bez stylu całego poddrzewa i bez malowania. */
  .pc-live .pc3d-card { transition: none; will-change: transform; }
  .pc-live .pc3d-holo, .pc-live .pc3d-spec { will-change: transform; }
</style>
