---
/**
 * TrainWeek: rozkład tygodnia dla 3, 4, 5 i 6 dni treningowych (SCHEDULES z src/pages/HomePage.jsx,
 * te same tablice ma RecoveryPage.jsx i SettingsPanel.jsx). Przyciski liczby dni wyglądają jak
 * „Plan tygodnia" w ustawieniach apki; hexy dni jak w kalendarzu apki (CalendarPage.jsx).
 * T = trening, R = regeneracja, O = wolne. Rozkładu konkretnych dni w apce się nie wybiera:
 * wynika z liczby dni.
 *
 * Wszystkie cztery rozkłady są w HTML; widoczny wybiera atrybut data-days na .tw (przełącza skrypt
 * strony po kliknięciu przycisku). Zmienia się tylko opacity. Bez JS widać rozkład dla 4 dni.
 * Rozmiary w em (1em = 10px przy --trs: 1), skalę ustawia rodzic; --tw-fit (długość) ogranicza
 * 1em do szerokości ekranu.
 */
const SCHEDULES: Record<number, string[]> = {
  3: ['T', 'O', 'T', 'O', 'T', 'R', 'O'],
  4: ['T', 'T', 'O', 'T', 'T', 'R', 'O'],
  5: ['T', 'T', 'R', 'T', 'T', 'T', 'O'],
  6: ['T', 'T', 'T', 'R', 'T', 'T', 'T'],
}
const DAYS = ['Pn', 'Wt', 'Śr', 'Cz', 'Pt', 'Sb', 'Nd']
const FULL = ['poniedziałek', 'wtorek', 'środa', 'czwartek', 'piątek', 'sobota', 'niedziela']
const KIND: Record<string, string> = { T: 'trening', R: 'regeneracja', O: 'wolne' }
const OPTIONS = [3, 4, 5, 6]
const START = 4
---
<div class="tw" data-days={START}>
  <div class="tw-pick" role="group" aria-label="Liczba dni treningowych w tygodniu">
    {OPTIONS.map((n) => (
      <button class="tw-n" type="button" data-n={n} aria-pressed={n === START ? 'true' : 'false'}><b>{n}</b><span>dni</span></button>
    ))}
  </div>
  <div class="tw-rows">
    {OPTIONS.map((n) => (
      <ol class="tw-row" data-for={n} aria-label={`Rozkład tygodnia przy ${n} dniach treningowych`} aria-hidden={n === START ? undefined : 'true'}>
        {SCHEDULES[n].map((t, i) => (
          <li class={`tw-${t}`}><span class="tw-hex"><i>{DAYS[i]}</i></span><span class="tw-sr">{FULL[i]}: {KIND[t]}</span></li>
        ))}
      </ol>
    ))}
  </div>
  <p class="tw-legend" aria-hidden="true">
    <span class="tw-T"><span class="tw-hex"><i></i></span>Trening</span>
    <span class="tw-R"><span class="tw-hex"><i></i></span>Regeneracja</span>
    <span class="tw-O"><span class="tw-hex"><i></i></span>Wolne</span>
  </p>
</div>

<style is:global>
  .tw { font-size: min(calc(10px * var(--trs, 1)), var(--tw-fit, 100px)); width: 33.6em; display: grid; gap: 2em; color: #EEF4FF; font-family: var(--body); text-align: center; }
  .tw-pick { display: flex; gap: 0.8em; }
  .tw-n { flex: 1; min-width: 0; padding: 1.1em 0 0.9em; border: 0; border-radius: 1em; cursor: pointer; font: inherit; color: inherit;
    background: rgba(255,255,255,0.025); box-shadow: inset 0 0 0 1.5px rgba(150,200,255,0.14); }
  .tw-n b { display: block; font-family: var(--display); font-weight: 900; font-size: 1.9em; line-height: 1; color: #6F86A6; }
  .tw-n span { display: block; margin-top: 0.3em; font-size: 0.8em; letter-spacing: 0.06em; line-height: 1; color: #5C6F88; }
  .tw-n[aria-pressed="true"] { background: rgba(91,184,245,0.12); box-shadow: inset 0 0 0 1.5px rgba(91,184,245,0.5); }
  .tw-n[aria-pressed="true"] b { color: #5BB8F5; }

  /* Cztery rozkłady leżą w jednej komórce; widoczny jest ten z data-for = data-days */
  .tw-rows { display: grid; }
  .tw-row { grid-area: 1 / 1; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(7, 4em); gap: 0.93em; opacity: 0;
    pointer-events: none; transition: opacity var(--dur-2, .64s) var(--ease, ease); }
  .tw[data-days="3"] .tw-row[data-for="3"], .tw[data-days="4"] .tw-row[data-for="4"],
  .tw[data-days="5"] .tw-row[data-for="5"], .tw[data-days="6"] .tw-row[data-for="6"] { opacity: 1; }
  .tw-row li { position: relative; }
  .tw-hex { position: relative; display: grid; place-items: center; width: 4em; height: 4.6em;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%); background: rgba(255,255,255,0.07); }
  .tw-hex i { font-style: normal; font-family: var(--display); font-weight: 700; font-size: 1.3em; letter-spacing: 0.02em; line-height: 1; color: rgba(255,255,255,0.34); }
  /* trening: pełny hex (jak dzień zaliczony w kalendarzu apki); regeneracja: błękitny; wolne: przygaszony */
  .tw-T .tw-hex { background: linear-gradient(135deg, #4a5a6f 0%, #9ab4c8 38%, #daeeff 52%, #a8c2d6 64%, #4e6070 100%); }
  .tw-T .tw-hex i { color: #0B1626; font-weight: 800; }
  .tw-R .tw-hex { background: rgba(91,184,245,0.30); }
  .tw-R .tw-hex i { color: #7ECBFF; }
  .tw-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .tw-legend { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.8em 2em; font-size: 1.2em; color: #9FB0C8; }
  .tw-legend > span { display: inline-flex; align-items: center; gap: 0.6em; }
  .tw-legend .tw-hex { width: 1.2em; height: 1.38em; }
</style>
