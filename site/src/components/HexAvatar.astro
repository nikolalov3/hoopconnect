---
/**
 * HexAvatar: 1:1 port hexa z inicjałem z apki (src/components/ui/HexAvatar.jsx).
 * Opcjonalna ramka PNG (Early Access) i poświata. Skaluje się przez CSS width/height (viewBox).
 */
interface Props {
  letter: string
  size?: number
  frame?: boolean
  glow?: boolean
  uid: string
  class?: string
}
const { letter, size = 44, frame = false, glow = false, uid, class: cls } = Astro.props
---
<svg class:list={['hexav', cls]} width={size} height={size} viewBox="-16 -16 122 122" style="flex-shrink:0; overflow:visible" aria-hidden="true">
  <defs>
    <linearGradient id={`av-${uid}`} x1="20%" y1="0%" x2="80%" y2="100%">
      <stop offset="0%" stop-color="#7BC8F8" /><stop offset="40%" stop-color="#5BB8F5" /><stop offset="100%" stop-color="#1B3A6B" />
    </linearGradient>
    {glow && <filter id={`gf-${uid}`} x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="6" /></filter>}
  </defs>
  {glow && <polygon points="45,-6 93,22 93,68 45,96 -3,68 -3,22" fill="none" stroke="rgba(91,184,245,0.55)" stroke-width="18" filter={`url(#gf-${uid})`} opacity="0.55" />}
  <polygon points="45,9 84,33 84,61 45,87 6,61 6,33" fill="rgba(0,0,0,0.30)" />
  <polygon points="45,6 82,32 82,58 45,84 8,58 8,32" fill={`url(#av-${uid})`} />
  <polygon points="45,6 8,32 45,42" fill="rgba(255,255,255,0.28)" />
  <polygon points="45,6 82,32 45,42" fill="rgba(255,255,255,0.13)" />
  <polygon points="8,32 8,58 45,48 45,42" fill="rgba(91,184,245,0.15)" />
  <polygon points="82,32 82,58 45,48 45,42" fill="rgba(0,0,0,0.22)" />
  <polygon points="45,6 82,32 82,58 45,84 8,58 8,32" fill="none" stroke="rgba(255,255,255,0.40)" stroke-width="1.5" stroke-linejoin="round" />
  <text x="45" y="49" text-anchor="middle" dominant-baseline="middle" fill="white" font-size="30" font-weight="800" font-family="'Barlow Condensed', Barlow, sans-serif">{letter}</text>
  {frame && <image href="/earlyaccess.png" x="-16" y="-16" width="122" height="122" preserveAspectRatio="xMidYMid meet" />}
</svg>
