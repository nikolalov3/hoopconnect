---
/**
 * RankBoard: tablica rankingu przeniesiona z apki (src/pages/RankPage.jsx, app.hoopconnect.pl/rank):
 * zakładki tekstowe z przesuwaną kreską, filtr miasta na ściętych przyciskach, wiersze na liniach,
 * znak areny, top 3 w kolorze medalu, wiersz „Ty" na niebiesko, wartość zawsze w ostatniej kolumnie.
 * To element produktu w HTML, nie zrzut ekranu. Zmieniasz wygląd tablicy w apce → popraw też tutaj.
 * Dane są POGLĄDOWE (ci sami gracze, co na kartach z boiska na stronie głównej).
 *
 * Rozmiary w em (1em = 10px przy --rbs: 1), więc tablicę skaluje jedna zmienna --rbs na rodzicu.
 * Zakładki działają (klik przełącza tablicę). `story`: przy wejściu na ekran wartości nabijają się
 * od zera, potem „Ty" dostaje +75 XP za wygrany mecz i wyprzedza gracza nad sobą (zamiana miejsc
 * transformem). Bez JS i przy ograniczonym ruchu widać statyczną tablicę.
 */
import HexAvatar from './HexAvatar.astro'
interface Props {
  uid: string
  story?: boolean
  cities?: boolean      // pokaż filtr miasta (ilustracja filtra, nieklikalna)
}
const { uid, story = false, cities = true } = Astro.props

// lvl = poziom areny (0 = Rozgrzewka bez grafiki, 1..6 = public/arenas/thumb/arena-N.webp)
type Pl = { id: string; name: string; l: string; f?: boolean; me?: boolean; arena: string; lvl: number; xp: number; w: number; g: number; kw: number; ks: number }
const P: Pl[] = [
  { id: 'alex', name: 'Alex', l: 'A', f: true, arena: 'Void Gem', lvl: 5, xp: 5940, w: 15, g: 22, kw: 4, ks: 9 },
  { id: 'kuba', name: 'Kuba', l: 'K', f: true, arena: 'Ankh Court', lvl: 4, xp: 4892, w: 12, g: 19, kw: 3, ks: 8 },
  { id: 'olek', name: 'Olek', l: 'O', arena: 'Golden Reign', lvl: 3, xp: 3552, w: 9, g: 16, kw: 2, ks: 6 },
  { id: 'me', name: 'Szymon', l: 'S', f: true, me: true, arena: 'Golden Reign', lvl: 3, xp: 3480, w: 10, g: 15, kw: 2, ks: 5 },
  { id: 'bartek', name: 'Bartek', l: 'B', f: true, arena: 'City Run', lvl: 2, xp: 2076, w: 7, g: 13, kw: 1, ks: 5 },
  { id: 'michal', name: 'Michał', l: 'M', arena: 'Street Court', lvl: 1, xp: 850, w: 4, g: 9, kw: 0, ks: 3 },
  { id: 'filip', name: 'Filip', l: 'F', arena: 'Rozgrzewka', lvl: 0, xp: 420, w: 2, g: 6, kw: 0, ks: 2 },
]
const MEDAL = ['#FFC940', '#C9D4E3', '#D9925B']
const byXp = [...P].sort((a, b) => b.xp - a.xp)
const byWins = [...P].sort((a, b) => b.w - a.w)
const byKotc = [...P].sort((a, b) => b.kw - a.kw || b.ks - a.ks)
const pct = (p: Pl) => Math.round((p.w / p.g) * 100)
// polska odmiana po liczebniku: 1 gra, 2-4 gry (poza 12-14), reszta gier
const pl = (n: number, one: string, few: string, many: string) => {
  const d = n % 10, h = n % 100
  return `${n} ${n === 1 ? one : d >= 2 && d <= 4 && !(h >= 12 && h <= 14) ? few : many}`
}
const TABS = [
  { key: 'xp', label: 'XP' }, { key: 'matches', label: 'Mecze' }, { key: 'kotc', label: 'King of the Court' },
]
const rowStyle = (i: number) => `--i:${i};${i < 3 ? `--medal:${MEDAL[i]}` : ''}`
const HEX = 'M12 2.6 20.1 7.3v9.4L12 21.4 3.9 16.7V7.3z'
---
<div class="rb" data-rb data-tab="xp" data-story={story ? '' : undefined}>
  <div class="rb-strip">
    <div class="rb-tabs" role="tablist" aria-label="Tablice rankingu">
      {TABS.map((t, i) => (
        <button class:list={['rb-tab', { on: i === 0 }]} type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={t.key}>{t.label}</button>
      ))}
    </div>
  </div>
  {cities && (
    <div class="rb-filters" aria-hidden="true">
      <span class="rb-fl">Miasto</span>
      <span class="rb-chip on">Wszystkie miasta</span>
      <span class="rb-chip">Kraków <small>20</small></span>
      <span class="rb-note">Dane przykładowe</span>
    </div>
  )}

  <div class="rb-board">
    <!-- XP -->
    <div class="rb-cols" data-for="xp"><span>#</span><span>Gracz</span><span class="x">Arena</span><span class="num">XP</span></div>
    <ol class="rb-list" data-for="xp">
      {byXp.map((p, i) => (
        <li class:list={['rb-row', { top: i < 3, me: p.me }]} style={rowStyle(i)} data-gain={p.me && story ? 75 : undefined}>
          <span class="rb-n">{i + 1}</span>
          <span class="rb-player">
            <HexAvatar letter={p.l} frame={!!p.f} uid={`${uid}x${p.id}`} />
            <span class="rb-id">
              <span class="rb-name"><span>{p.name}</span>{p.me && <i class="rb-you">Ty</i>}</span>
              <span class="rb-sub">
                {p.lvl
                  ? <img class="rb-am" src={`/arenas/thumb/arena-${p.lvl}.webp`} width="16" height="16" alt="" loading="lazy" decoding="async" />
                  : <svg class="rb-am" viewBox="0 0 24 24" aria-hidden="true"><path d={HEX} fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" /></svg>}
                {p.arena}
              </span>
            </span>
          </span>
          <span class="rb-ex rb-arena">
            {p.lvl
              ? <img class="rb-am" src={`/arenas/thumb/arena-${p.lvl}.webp`} width="28" height="28" alt="" loading="lazy" decoding="async" />
              : <svg class="rb-am" viewBox="0 0 24 24" aria-hidden="true"><path d={HEX} fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" /></svg>}
            <span>{p.arena}</span>
          </span>
          <span class="rb-val num" data-v={p.xp}>{p.xp}</span>
          {p.me && story && <span class="rb-gain" aria-hidden="true">+75 XP</span>}
        </li>
      ))}
    </ol>

    <!-- Mecze -->
    <div class="rb-cols" data-for="matches" hidden><span>#</span><span>Gracz</span><span class="num x">Mecze</span><span class="num x">% wygranych</span><span class="num">Wygrane</span></div>
    <ol class="rb-list" data-for="matches" hidden>
      {byWins.map((p, i) => (
        <li class:list={['rb-row', { top: i < 3, me: p.me }]} style={rowStyle(i)}>
          <span class="rb-n">{i + 1}</span>
          <span class="rb-player">
            <HexAvatar letter={p.l} frame={!!p.f} uid={`${uid}m${p.id}`} />
            <span class="rb-id">
              <span class="rb-name"><span>{p.name}</span>{p.me && <i class="rb-you">Ty</i>}</span>
              <span class="rb-sub">{pl(p.g, 'gra', 'gry', 'gier')} · {pct(p)}%</span>
            </span>
          </span>
          <span class="rb-ex num">{p.g}</span>
          <span class="rb-ex num">{pct(p)}%</span>
          <span class="rb-val num">{p.w}</span>
        </li>
      ))}
    </ol>

    <!-- King of the Court -->
    <div class="rb-cols" data-for="kotc" hidden><span>#</span><span>Gracz</span><span class="num x">Sesje</span><span class="num">Wygrane sesje</span></div>
    <ol class="rb-list" data-for="kotc" hidden>
      {byKotc.map((p, i) => (
        <li class:list={['rb-row', { top: i < 3, me: p.me }]} style={rowStyle(i)}>
          <span class="rb-n">{i + 1}</span>
          <span class="rb-player">
            <HexAvatar letter={p.l} frame={!!p.f} uid={`${uid}k${p.id}`} />
            <span class="rb-id">
              <span class="rb-name"><span>{p.name}</span>{p.me && <i class="rb-you">Ty</i>}</span>
              <span class="rb-sub">{pl(p.ks, 'sesja', 'sesje', 'sesji')}</span>
            </span>
          </span>
          <span class="rb-ex num">{p.ks}</span>
          <span class="rb-val num">{p.kw}</span>
        </li>
      ))}
    </ol>
  </div>
  {!cities && <p class="rb-note below">Dane przykładowe</p>}
</div>

<style>
  .rb { font-size: calc(10px * var(--rbs, 1)); width: 100%; max-width: 91.2em; margin-inline: auto; color: var(--text);
    font-family: var(--body); container-type: inline-size; text-align: left; }

  /* Zakładki: tekst + jedna kreska, którą skrypt przesuwa transformem pod aktywną zakładkę */
  .rb-strip { border-bottom: 1px solid var(--line-2); }
  .rb-tabs { position: relative; display: flex; gap: 3.4em; }
  .rb-tab { appearance: none; border: 0; background: none; margin: 0; padding: .73em 0 .68em; cursor: pointer; white-space: nowrap; color: var(--text-3);
    font-family: var(--display); font-weight: 700; font-size: 2.2em; line-height: 1; letter-spacing: .027em; text-transform: uppercase; transition: color .25s; }
  .rb-tab:hover { color: var(--text-2); }
  .rb-tab.on { color: var(--text); }
  .rb-tab:focus-visible { outline: 2px solid var(--accent-hi); outline-offset: 3px; }
  .rb-tabs::after { content: ''; position: absolute; left: 0; bottom: -1px; width: 100px; height: 2px; background: var(--accent-hi); transform-origin: 0 50%;
    transform: translateX(calc(var(--tx, 0) * 1px)) scaleX(calc(var(--tw, 0) / 100)); transition: transform .5s var(--ease); }

  /* Filtr miasta: małe matowe przyciski ze ściętym rogiem (::after = obrys, ::before = wypełnienie) */
  .rb-filters { display: flex; align-items: center; gap: .7em; padding: 1.6em 0 .6em; }
  .rb-fl { margin-right: .36em; font-size: 1.1em; font-weight: 600; letter-spacing: .145em; text-transform: uppercase; color: var(--text-3); }
  .rb-chip { --bd: var(--line-2); --fill: #131419; --cut: .62em; position: relative; isolation: isolate; z-index: 0; display: inline-flex; align-items: center; gap: .6em;
    padding: .62em 1em; font-size: 1.3em; font-weight: 600; line-height: 1.25; letter-spacing: .015em; color: var(--text-2); white-space: nowrap; }
  .rb-chip::after { content: ''; position: absolute; inset: 0; z-index: -2; background: var(--bd);
    clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, 0 100%); }
  .rb-chip::before { content: ''; position: absolute; inset: 1px; z-index: -1; background: var(--fill);
    clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, 0 100%); }
  .rb-chip.on { --bd: rgba(96,168,224,.6); --fill: #163D65; color: #EAF3FF; }
  .rb-chip small { font-size: .85em; font-weight: 600; color: var(--text-3); }
  .rb-chip.on small { color: var(--accent-hi); }
  .rb-note { margin: 0 0 0 auto; font-size: 1.25em; color: var(--text-3); white-space: nowrap; }
  .rb-note.below { margin: .9em .2em 0; text-align: right; }

  /* Tablica: siatka, linie tylko między wierszami */
  .rb-board { margin-top: .8em; }
  .rb-cols, .rb-row { display: grid; grid-template-columns: var(--rb-cols); column-gap: 1.4em; align-items: center; padding: 0 1.6em 0 .4em; }
  .rb-cols[hidden], .rb-list[hidden] { display: none; }
  [data-for="xp"] { --rb-cols: 5.2em minmax(0, 1fr) minmax(15em, 23.6em) 9.6em; }
  [data-for="matches"] { --rb-cols: 5.2em minmax(0, 1fr) 7.8em 12.6em 10em; }
  [data-for="kotc"] { --rb-cols: 5.2em minmax(0, 1fr) 7.8em 14.8em; }
  .rb-cols { padding-block: 1.2em 1em; border-bottom: 1px solid var(--line); }
  .rb-cols span { font-size: 1.1em; font-weight: 600; letter-spacing: .145em; text-transform: uppercase; color: var(--text-3); white-space: nowrap; }
  .rb-cols span:first-child { text-align: center; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }

  .rb-list { list-style: none; margin: 0; padding: 0; }
  .rb-row { position: relative; min-height: 6.4em; border-bottom: 1px solid var(--line); transition: transform .7s var(--ease), background .4s ease; }
  .rb-n { text-align: center; font-family: var(--display); font-weight: 700; font-size: 1.9em; line-height: 1; color: var(--text-3); font-variant-numeric: tabular-nums; }
  .rb-player { display: flex; align-items: center; gap: 1.3em; min-width: 0; padding-block: .9em; }
  .rb-player :global(.hexav) { width: 3.8em; height: 3.8em; flex: none; }
  .rb-id { min-width: 0; display: grid; }
  .rb-name { display: flex; align-items: center; gap: .56em; min-width: 0; font-size: 1.6em; font-weight: 600; line-height: 1.25; }
  .rb-name > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rb-you { flex: none; padding: .2em .6em; border: 1px solid rgba(111,195,255,.45); border-radius: 2px; font-style: normal; font-size: .625em; font-weight: 600;
    line-height: 1.2; letter-spacing: .12em; text-transform: uppercase; color: var(--accent-hi); }
  .rb-sub { display: none; }
  .rb-ex { color: var(--text-2); font-size: 1.45em; white-space: nowrap; }
  .rb-arena { display: flex; align-items: center; gap: .69em; min-width: 0; }
  .rb-arena > span { overflow: hidden; text-overflow: ellipsis; }
  .rb-am { flex: none; width: 1.93em; height: 1.93em; object-fit: contain; color: var(--text-3); }
  .rb-val { font-family: var(--display); font-weight: 800; font-size: 2.6em; line-height: 1; white-space: nowrap; }
  /* top 3: zwykłe wiersze, numer i wartość w kolorze medalu + delikatna smuga od lewej (jak w apce) */
  .rb-row.top { background: linear-gradient(90deg, color-mix(in srgb, var(--medal) 11%, transparent), transparent 46%); }
  .rb-row.top .rb-n { color: var(--medal); font-size: 2.7em; text-shadow: 0 0 .67em color-mix(in srgb, var(--medal) 55%, transparent); }
  .rb-row.top .rb-val { color: var(--medal); }
  .rb-row.me { background: linear-gradient(90deg, rgba(47,145,214,.24), rgba(47,145,214,.06)); }

  /* Wejście wierszy (przy pierwszym pokazaniu i po zmianie zakładki): tylko opacity i transform */
  .rb-list.enter .rb-row { animation: rb-in .5s var(--ease) both; animation-delay: calc(var(--i, 0) * 40ms); }
  @keyframes rb-in { from { opacity: 0; transform: translateY(.8em); } }
  .rb.rb-wait .rb-row { opacity: 0; }

  /* Historia: +75 XP za wygrany mecz i zamiana miejsc (wiersze mają tę samą wysokość, przesuw = 100%) */
  .rb-row.up { transform: translateY(-100%); z-index: 2; }
  .rb-row.down { transform: translateY(100%); }
  /* plakietka siada na górnej krawędzi wiersza, nad wartością XP: nie zasłania areny ani liczby */
  .rb-gain { position: absolute; z-index: 3; right: 1.1em; top: 0; padding: .3em .75em; border-radius: 2px; white-space: nowrap;
    font-family: var(--display); font-weight: 800; font-size: 1.3em; line-height: 1.2; letter-spacing: .04em; color: #06121F; background: #6FC3FF;
    box-shadow: 0 0 1.4em rgba(111,195,255,.55); opacity: 0; transform: translateY(10%) scale(.92);
    transition: opacity .4s var(--ease), transform .4s var(--ease); pointer-events: none; }
  .rb-gain.on { opacity: 1; transform: translateY(-50%) scale(1); }

  /* Wąska tablica (telefon): jak w apce, kolumny dodatkowe zwijają się do podtytułu wiersza */
  @container (max-width: 560px) {
    .rb-tabs { gap: 2.2em; }
    .rb-tab { font-size: 1.9em; }
    .rb-filters { display: none; }
    .rb-cols, .rb-row { grid-template-columns: 3.8em minmax(0, 1fr) auto; column-gap: 1em; padding: 0 .6em 0 0; }
    .rb-cols .x, .rb-ex { display: none; }
    .rb-row { min-height: 6em; }
    .rb-n { font-size: 1.7em; }
    .rb-row.top .rb-n { font-size: 2.3em; }
    .rb-player { gap: 1.1em; }
    .rb-name { font-size: 1.5em; }
    .rb-sub { display: flex; align-items: center; gap: .5em; margin-top: .17em; font-size: 1.2em; line-height: 1.3; color: var(--text-3); }
    .rb-sub .rb-am { width: 1.33em; height: 1.33em; }
    .rb-val { font-size: 2.3em; }
    .rb-gain { right: .5em; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rb.rb-wait .rb-row { opacity: 1; }
    .rb-tabs::after { transition: none; }
  }
</style>

<script>
  import { countUp, onceVisible, prefersReducedMotion, hasIO, wait } from '../scripts/motion'

  document.querySelectorAll<HTMLElement>('.rb[data-rb]').forEach((rb) => {
    const reduce = prefersReducedMotion()
    const lists = Array.from(rb.querySelectorAll<HTMLElement>('.rb-list'))
    const cols = Array.from(rb.querySelectorAll<HTMLElement>('.rb-cols'))
    const tabs = Array.from(rb.querySelectorAll<HTMLButtonElement>('.rb-tab'))
    const tabsBox = rb.querySelector<HTMLElement>('.rb-tabs')
    const listFor = (tab: string) => lists.find((l) => l.dataset.for === tab)
    const enter = (l?: HTMLElement) => {
      if (!l || reduce) return
      l.classList.remove('enter'); void l.offsetWidth; l.classList.add('enter')
    }

    // Kreska pod aktywną zakładką: pozycja i szerokość idą do zmiennych CSS (ruch samym transformem).
    const place = () => {
      const el = tabs.find((t) => t.classList.contains('on'))
      if (!el || !tabsBox) return
      tabsBox.style.setProperty('--tx', String(el.offsetLeft))
      tabsBox.style.setProperty('--tw', String(el.offsetWidth))
    }
    place()
    if ('ResizeObserver' in window) { const ro = new ResizeObserver(place); tabs.forEach((t) => ro.observe(t)) }

    // Zakładki: klik przełącza tablicę (zestaw kolumn i wierszy), wiersze wchodzą od nowa.
    const show = (tab: string) => {
      if (rb.dataset.tab === tab) return
      rb.dataset.tab = tab
      tabs.forEach((t) => { const on = t.dataset.tab === tab; t.classList.toggle('on', on); t.setAttribute('aria-selected', String(on)) })
      lists.forEach((l) => { l.hidden = l.dataset.for !== tab })
      cols.forEach((c) => { c.hidden = c.dataset.for !== tab })
      place()
      if (!rb.classList.contains('rb-wait')) enter(listFor(tab))
    }
    tabs.forEach((t) => t.addEventListener('click', () => show(t.dataset.tab || 'xp')))

    if (reduce || !hasIO()) return

    // Pierwsze wejście na ekran: wiersze wjeżdżają, XP nabija się od zera.
    const xp = listFor('xp')
    const vals = xp ? Array.from(xp.querySelectorAll<HTMLElement>('.rb-val')) : []
    vals.forEach((v) => { v.textContent = '0' })
    rb.classList.add('rb-wait')
    onceVisible(rb, async () => {
      rb.classList.remove('rb-wait')
      enter(listFor(rb.dataset.tab || 'xp'))
      vals.forEach((v) => { countUp(v, Number(v.dataset.v), 1100) })
      if (!rb.hasAttribute('data-story') || !xp) return

      // Historia: „Ty" wygrywa mecz (+75 XP) i wyprzedza gracza nad sobą.
      await wait(2000)
      const me = xp.querySelector<HTMLElement>('.rb-row[data-gain]')
      const prev = me?.previousElementSibling as HTMLElement | null
      const val = me?.querySelector<HTMLElement>('.rb-val')
      if (!me || !prev || !val) return
      const from = Number(val.dataset.v), to = from + Number(me.dataset.gain)
      me.querySelector('.rb-gain')?.classList.add('on')
      await wait(450)
      await countUp(val, to, 800, from)
      if (to <= Number(prev.querySelector<HTMLElement>('.rb-val')?.dataset.v)) return
      await wait(250)
      xp.classList.remove('enter')                       // transform wraca pod kontrolę klas .up / .down
      me.classList.add('up'); prev.classList.add('down')
      await wait(300)
      // W połowie ruchu numer i medal przechodzą na wyprzedzającego.
      const nMe = me.querySelector('.rb-n'), nPrev = prev.querySelector('.rb-n')
      if (nMe && nPrev) { const t = nMe.textContent; nMe.textContent = nPrev.textContent; nPrev.textContent = t }
      if (prev.classList.contains('top')) {
        me.classList.add('top'); me.style.setProperty('--medal', prev.style.getPropertyValue('--medal'))
        prev.classList.remove('top'); prev.style.removeProperty('--medal')
      }
      await wait(2800)
      me.querySelector('.rb-gain')?.classList.remove('on')
    }, 0.35)
  })
</script>
