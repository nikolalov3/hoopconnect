---
/**
 * ResultFlow: wynik meczu w trzech stanach (src/pages/ClubPage.jsx: ResultSheet, widoki HomeEntry i AwayConfirm).
 *   1  kapitan gospodarzy wpisuje wynik („Wpisz wynik", „Zatwierdź i wyślij rywalom")
 *   2  kapitan rywali potwierdza albo zgłasza inny wynik („Potwierdź wynik", limit 24h)
 *   3  mecz zakończony: slot (karta meczu z apki i XP)
 * Stan ustawia atrybut data-step na przodku (scena sticky); warstwy zmieniają się przez opacity i transform.
 * Bez JS widać stan 1. Rozmiary w em (1em = 10px przy --rfs: 1), skalę ustawia rodzic.
 *
 * Kolory stron jak w apce: gospodarze błękit, goście bursztyn (to kolor drużyny, nie Draft Score).
 * Drobne podpisy, które w apce są bursztynowe („limit 24h", tytuł potwierdzenia), tu są neutralne,
 * żeby pomarańcz na stronie nie mieszał się z Draft Score. Teksty przycisków 1:1 z pl/club.json.
 */
interface Props {
  home: string
  away: string
  score: [number, number]
  date: string
}
const { home, away, score, date } = Astro.props
const homeWon = score[0] > score[1]
const awayWon = score[1] > score[0]
---
<div class="rf">
  <div class="rf-sheet rf-1">
    <p class="rf-title">Wpisz wynik</p>
    <p class="rf-date">{date}</p>
    <p class="rf-hint">Kapitan rywali potwierdzi wynik · limit 24h</p>
    <div class="rf-score">
      <div class:list={['rf-box', 'home', { win: homeWon }]}><span>{home}</span><b data-rf={score[0]}>{score[0]}</b></div>
      <i>:</i>
      <div class:list={['rf-box', 'away', { win: awayWon }]}><span>{away}</span><b data-rf={score[1]}>{score[1]}</b></div>
    </div>
    <span class="rf-btn">Zatwierdź i wyślij rywalom</span>
    <span class="rf-sec">Wpisz później</span>
  </div>

  <div class="rf-sheet rf-2">
    <p class="rf-title">Potwierdź wynik</p>
    <p class="rf-date">{date}</p>
    <div class="rf-panel">
      <div class="home"><span>{home}</span><b>{score[0]}</b></div>
      <i>:</i>
      <div class="away"><span>{away}</span><b>{score[1]}</b></div>
    </div>
    <p class="rf-hint">Brak potwierdzenia → wynik zatwierdzi się za 24h</p>
    <span class="rf-btn">Potwierdzam wynik</span>
    <span class="rf-sec">Inny wynik</span>
    <span class="rf-sec">Wpisz później</span>
  </div>

  <div class="rf-3"><slot /></div>
</div>

<style is:global>
  .rf { font-size: calc(10px * var(--rfs, 1)); display: grid; justify-items: center; align-items: center; color: #E0EEFF;
    font-family: var(--body); text-align: center; pointer-events: none; }
  .rf > * { grid-area: 1 / 1; opacity: 0; transform: translateY(1.8em);
    transition: opacity var(--dur-2, .64s) var(--ease, ease), transform var(--dur-2, .64s) var(--ease, ease); }
  .rf-sheet { width: 32em; max-width: 100%; padding: 2.6em 2.2em 2em; border-radius: 2em; background: #08111E; border: 1px solid rgba(0,210,255,0.36);
    box-shadow: 0 2em 7em rgba(0,0,0,0.5), 0 0 4em rgba(0,180,255,0.08); }
  .rf-title { font-size: 0.95em; font-weight: 800; letter-spacing: 0.35em; text-indent: 0.35em; text-transform: uppercase; color: #7D93B0; line-height: 1.3; }
  .rf-date { margin-top: 0.4em; font-size: 1.15em; font-weight: 600; color: #6F86A6; line-height: 1.3; }
  .rf-hint { margin: 0.6em 0 2em; font-size: 1.05em; color: #9FB6D6; line-height: 1.5; }
  .rf-2 .rf-hint { margin: 0 0 1.6em; color: #6F86A6; }

  /* Dwa pola wyniku: wygrywająca strona świeci kolorem swojej drużyny (gospodarze błękit, goście bursztyn) */
  .rf-score { display: flex; align-items: flex-end; justify-content: center; gap: 1.2em; margin-bottom: 2em; }
  .rf-box { --c: #00CCFF; flex: 1; min-width: 0; }
  .rf-box.away { --c: #FFA820; }
  .rf-box span { display: block; margin-bottom: 0.9em; font-size: 0.9em; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; line-height: 1;
    color: color-mix(in srgb, var(--c) 62%, transparent); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rf-box b { display: block; padding: 0.22em 0; border-radius: 0.3em; font-family: var(--display); font-weight: 900; font-size: 4.6em; line-height: 1;
    letter-spacing: -0.02em; background: #04080F; box-shadow: inset 0 0 0 2px #1D3352; color: #E0EEFF; font-variant-numeric: tabular-nums; }
  .rf-box.win b { background: color-mix(in srgb, var(--c) 9%, #04080F); box-shadow: inset 0 0 0 2px var(--c); color: var(--c); }
  .rf-score > i { padding-bottom: 0.42em; font-style: normal; font-family: var(--display); font-weight: 900; font-size: 2.8em; line-height: 1; color: #2A5070; }

  .rf-panel { display: flex; align-items: center; justify-content: center; gap: 1.4em; margin: 1.8em 0; padding: 1.4em 2em; border-radius: 1.4em;
    background: rgba(0,204,255,0.04); border: 1px solid rgba(0,204,255,0.15); border-top-color: rgba(0,204,255,0.27); }
  .rf-panel > div { --c: #00CCFF; min-width: 0; }
  .rf-panel > .away { --c: #FFA820; }
  .rf-panel span { display: block; margin-bottom: 0.5em; font-size: 0.85em; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; line-height: 1;
    color: color-mix(in srgb, var(--c) 58%, transparent); max-width: 11em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rf-panel b { display: block; font-family: var(--display); font-weight: 900; font-size: 4.2em; line-height: 1; color: #E0EEFF; font-variant-numeric: tabular-nums; }
  .rf-panel > i { font-style: normal; font-family: var(--display); font-weight: 900; font-size: 2.4em; line-height: 1; color: #2A5070; }

  .rf-btn { display: block; margin-bottom: 0.84em; padding: 1.25em 0.4em; border-top: 2px solid #00E890; background: linear-gradient(135deg, #00E890, rgba(0,232,144,0.73));
    font-family: var(--display); font-weight: 900; font-size: 1.2em; letter-spacing: 0.22em; text-indent: 0.22em; text-transform: uppercase; line-height: 1; color: #04130C; }
  .rf-sec { display: block; margin-bottom: 0.72em; padding: 1.1em 0.4em; box-shadow: inset 0 0 0 1px rgba(255,255,255,0.08); font-size: 1.1em; font-weight: 500;
    line-height: 1; color: #6F86A6; }
  .rf-sec:last-child { margin-bottom: 0; }
  .rf-3 { display: grid; justify-items: center; }

  /* Stany: domyślnie (i bez JS) widać arkusz 1 */
  .rf > .rf-1 { opacity: 1; transform: none; }
  [data-step]:not([data-step="1"]) .rf > .rf-1 { opacity: 0; transform: translateY(-1.8em); }
  [data-step="2"] .rf > .rf-2 { opacity: 1; transform: none; }
  [data-step="3"] .rf > .rf-2 { transform: translateY(-1.8em); }
  [data-step="3"] .rf > .rf-3 { opacity: 1; transform: none; }
</style>
