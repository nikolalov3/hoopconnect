---
/**
 * ClubCourt: port panelu „Skład" z zakładki Klub (src/pages/ClubPage.jsx: Court + Token + SPOT + POS).
 * Połówka boiska 343x410 z pięcioma pozycjami. Zajęte miejsce to hex w kolorze pozycji z inicjałem
 * i imieniem, wolne to obrys z plusem i podpisem „Zaproś" (w apce tapnięcie otwiera zaproszenie:
 * link albo kod klubu). To element produktu w HTML, nie zrzut ekranu. Dane są poglądowe.
 *
 * Rozmiary w em (1em = 10px przy --ccs: 1): boisko skaluje zmienna --ccs na rodzicu, a --cc-fit
 * (długość) pozwala rodzicowi ograniczyć je do szerokości ekranu.
 * `swap`: para pozycji, którą strona zamienia klasą .cc-swapped na .cc (kapitan przestawia graczy).
 * Hexy jadą transformem, a kolor przechodzi na kolor nowej pozycji przez opacity. Podpis pozycji
 * zostaje na miejscu, bo pozycja należy do boiska, nie do gracza.
 * W apce obrys boiska i poświata hexów mają rozmycie; tu jest zwykła ramka i statyczny gradient.
 */
type Pos = 'PG' | 'SG' | 'SF' | 'C' | 'PF'
type Member = { name: string; l: string; frame?: boolean } | null
interface Props {
  uid: string
  members: Record<Pos, Member>
  swap?: [Pos, Pos]
}
const { uid, members, swap } = Astro.props

// Kolory tożsamości pozycji i punkty na boisku: 1:1 z ClubPage.jsx (POS, SPOT).
const POS: Record<Pos, { hi: string; lo: string; glow: string; label: string }> = {
  PG: { hi: '#4A80FF', lo: '#0A2070', glow: '74,128,255', label: 'Rozgrywający' },
  SG: { hi: '#00C880', lo: '#003828', glow: '0,200,128', label: 'Rzucający' },
  SF: { hi: '#FF8830', lo: '#501C04', glow: '255,136,48', label: 'Skrzydłowy' },
  C: { hi: '#9050FF', lo: '#200850', glow: '144,80,255', label: 'Środkowy' },
  PF: { hi: '#FF4070', lo: '#500820', glow: '255,64,112', label: 'Silny skrzydłowy' },
}
const SPOT: Record<Pos, [number, number]> = { PG: [23, 18], SG: [77, 18], SF: [20, 48], C: [50, 72], PF: [80, 48] }
const ORDER: Pos[] = ['PG', 'SG', 'SF', 'PF', 'C']

// Zamiana: o ile (w em boiska 34.3 x 41) przesuwa się gracz, żeby stanąć na drugiej pozycji z pary.
const other = (p: Pos): Pos | null => (swap && swap.includes(p) ? (swap[0] === p ? swap[1] : swap[0]) : null)
const delta = (p: Pos) => {
  const o = other(p)
  if (!o) return null
  return { x: ((SPOT[o][0] - SPOT[p][0]) / 100) * 34.3, y: ((SPOT[o][1] - SPOT[p][1]) / 100) * 41 }
}
---
<div class="cc">
  <div class="cc-floor">
    <svg viewBox="0 0 343 410" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id={`cc-fl-${uid}`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#13203A" /><stop offset="55%" stop-color="#0C1824" /><stop offset="100%" stop-color="#080F1A" />
        </linearGradient>
        <radialGradient id={`cc-sp-${uid}`} cx="50%" cy="2%" r="55%"><stop offset="0%" stop-color="rgba(0,150,255,0.12)" /><stop offset="100%" stop-color="rgba(0,150,255,0)" /></radialGradient>
        <radialGradient id={`cc-hp-${uid}`} cx="50%" cy="108%" r="48%"><stop offset="0%" stop-color="rgba(255,168,24,0.17)" /><stop offset="100%" stop-color="rgba(255,168,24,0)" /></radialGradient>
      </defs>
      <rect width="343" height="410" fill={`url(#cc-fl-${uid})`} />
      <rect width="343" height="410" fill={`url(#cc-sp-${uid})`} />
      <rect width="343" height="410" fill={`url(#cc-hp-${uid})`} />
      <!-- linia środkowa przy górnej krawędzi -->
      <line x1="0" y1="1" x2="343" y2="1" stroke="rgba(0,210,255,0.36)" stroke-width="1.5" />
      <path d="M 137 1 A 36 36 0 0 0 206 1" fill="none" stroke="rgba(0,210,255,0.20)" stroke-width="1.3" />
      <g stroke="rgba(0,210,255,0.36)" stroke-width="1.4" fill="none" stroke-linecap="round">
        <line x1="12" y1="1" x2="12" y2="398" /><line x1="331" y1="1" x2="331" y2="398" /><line x1="12" y1="398" x2="331" y2="398" />
        <!-- łuk za trzy -->
        <path d="M 12 272 A 204 204 0 0 1 331 272" />
        <!-- pole trzech sekund -->
        <rect x="122" y="260" width="99" height="138" fill="rgba(0,110,255,0.11)" stroke="rgba(0,210,255,0.35)" />
        <path d="M 122 260 A 49 49 0 0 1 221 260" />
        <path d="M 122 260 A 49 49 0 0 0 221 260" stroke="rgba(0,210,255,0.16)" stroke-dasharray="5 3" />
        <line x1="110" y1="295" x2="122" y2="295" stroke="rgba(0,210,255,0.20)" stroke-width="1.2" />
        <line x1="110" y1="327" x2="122" y2="327" stroke="rgba(0,210,255,0.20)" stroke-width="1.2" />
        <line x1="221" y1="295" x2="233" y2="295" stroke="rgba(0,210,255,0.20)" stroke-width="1.2" />
        <line x1="221" y1="327" x2="233" y2="327" stroke="rgba(0,210,255,0.20)" stroke-width="1.2" />
        <path d="M 146 398 A 25 25 0 0 0 197 398" stroke="rgba(0,210,255,0.18)" />
      </g>
      <!-- kosz: obręcz i tablica przy linii końcowej -->
      <circle cx="171.5" cy="377" r="13" fill="none" stroke="#FFA820" stroke-width="2.5" />
      <circle cx="171.5" cy="377" r="5.5" fill="rgba(255,168,32,0.14)" />
      <line x1="171.5" y1="390" x2="171.5" y2="393" stroke="#FFA820" stroke-width="1.5" opacity=".5" />
      <rect x="150" y="393" width="43" height="4" rx="1.5" fill="#FFA820" opacity=".9" />
    </svg>
  </div>

  {ORDER.map((p, i) => {
    const m = members[p]
    const o = other(p)
    const d = delta(p)
    return (
      <div class:list={['cc-spot', { 'cc-empty': !m, 'cc-swappable': !!d }]} data-pos={p}
        style={`left:${SPOT[p][0]}%; top:${SPOT[p][1]}%; --ti:${i}; --hi:${POS[p].hi}; --glow:${POS[p].glow};${d ? ` --sx:${d.x.toFixed(2)}em; --sy:${d.y.toFixed(2)}em;` : ''}`}>
        {m ? (
          <div class="cc-member">
            <span class="cc-hex">
              <svg viewBox="0 0 90 90" aria-hidden="true">
                <defs>
                  <linearGradient id={`cc-g-${uid}-${p}`} x1="20%" y1="0%" x2="80%" y2="100%"><stop offset="0%" stop-color={POS[p].hi} stop-opacity="0.8" /><stop offset="100%" stop-color={POS[p].lo} /></linearGradient>
                  {o && <linearGradient id={`cc-g-${uid}-${p}-b`} x1="20%" y1="0%" x2="80%" y2="100%"><stop offset="0%" stop-color={POS[o].hi} stop-opacity="0.8" /><stop offset="100%" stop-color={POS[o].lo} /></linearGradient>}
                </defs>
                <polygon points="45,9 84,33 84,61 45,87 6,61 6,33" fill="rgba(0,0,0,.42)" />
                <g class="cc-fill-a">
                  <polygon points="45,6 82,32 82,58 45,84 8,58 8,32" fill={`url(#cc-g-${uid}-${p})`} stroke={POS[p].hi} stroke-opacity=".8" stroke-width="2.2" stroke-linejoin="round" />
                </g>
                {o && (
                  <g class="cc-fill-b">
                    <polygon points="45,6 82,32 82,58 45,84 8,58 8,32" fill={`url(#cc-g-${uid}-${p}-b)`} stroke={POS[o].hi} stroke-opacity=".8" stroke-width="2.2" stroke-linejoin="round" />
                  </g>
                )}
                <polygon points="45,6 8,32 45,42" fill="rgba(255,255,255,.22)" />
                <polygon points="45,6 82,32 45,42" fill="rgba(255,255,255,.10)" />
                <polygon points="82,32 82,58 45,48 45,42" fill="rgba(0,0,0,.35)" />
                <text x="45" y="50" text-anchor="middle" dominant-baseline="middle" fill="white" font-size="31" font-weight="900" font-family="'Barlow Condensed', Barlow, sans-serif">{m.l}</text>
              </svg>
              {m.frame && (
                <svg class="cc-frame" viewBox="-16 -16 122 122" aria-hidden="true">
                  <image href="/frames/earlyaccess.webp" x="-16" y="-16" width="122" height="122" preserveAspectRatio="xMidYMid meet" />
                </svg>
              )}
            </span>
            <span class="cc-name">{m.name}</span>
          </div>
        ) : (
          <div class="cc-member">
            <span class="cc-hex">
              <svg viewBox="0 0 90 90" aria-hidden="true">
                <polygon points="45,6 82,32 82,58 45,84 8,58 8,32" fill="rgba(0,200,255,0.05)" stroke="rgba(0,200,255,0.34)" stroke-width="1.8" stroke-linejoin="round" />
                <line x1="45" y1="34" x2="45" y2="56" stroke="rgba(0,200,255,0.48)" stroke-width="2.4" stroke-linecap="round" />
                <line x1="34" y1="45" x2="56" y2="45" stroke="rgba(0,200,255,0.48)" stroke-width="2.4" stroke-linecap="round" />
              </svg>
            </span>
            <span class="cc-name">Zaproś</span>
          </div>
        )}
        <span class="cc-pos">{p}</span>
      </div>
    )
  })}
</div>

<style is:global>
  /* --ccs ustawia RODZIC; --cc-fit (długość) ogranicza 1em tak, żeby 34.3em zmieściło się w ekranie */
  .cc { font-size: min(calc(10px * var(--ccs, 1)), var(--cc-fit, 100px)); position: relative; width: 34.3em; aspect-ratio: 343 / 410;
    color: #E0EEFF; font-family: var(--body); text-align: center; }
  .cc-floor { position: absolute; inset: 0; border-radius: 2.2em; overflow: hidden; border: 1px solid rgba(0,220,255,0.46);
    box-shadow: 0 0 2.6em rgba(0,200,255,0.12), 0 2.4em 5em rgba(0,0,0,0.5); }
  .cc-floor::after { content: ''; position: absolute; top: 0; left: 8%; right: 8%; height: 2px;
    background: linear-gradient(90deg, transparent, #0099EE 30%, #55EEFF 50%, #0099EE 70%, transparent); }
  .cc-floor svg { display: block; width: 100%; height: 100%; }

  /* Środek bloku (hex + podpisy) stoi w punkcie pozycji, jak w apce */
  .cc-spot { position: absolute; z-index: 1; width: 7.8em; height: 10.4em; margin: -5.2em 0 0 -3.9em; }
  .cc-member { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center;
    transition: transform var(--dur-3, .9s) var(--ease, ease); }
  .cc-hex { position: relative; width: 7.8em; height: 7.8em; flex: none; }
  .cc-hex::before { content: ''; position: absolute; inset: -18%; border-radius: 50%; pointer-events: none;
    background: radial-gradient(circle, rgba(var(--glow), 0.42) 0%, rgba(var(--glow), 0.14) 38%, rgba(var(--glow), 0) 68%); }
  .cc-empty .cc-hex::before { display: none; }
  .cc-hex svg { position: relative; display: block; width: 100%; height: 100%; overflow: visible; }
  .cc-hex .cc-frame { position: absolute; inset: 0; overflow: hidden; }
  /* top liczony we własnym em (0.85 em boiska): 9.6em = 8.16em boiska, tuż pod hexem */
  .cc-pos { position: absolute; left: 0; right: 0; top: 9.6em; font-size: 0.85em; font-weight: 800; letter-spacing: 0.26em; line-height: 1;
    text-indent: 0.26em; text-transform: uppercase; color: var(--hi); }
  .cc-name { margin-top: 1.5em; font-size: 0.95em; font-weight: 600; line-height: 1; color: rgba(200,228,255,0.85);
    max-width: 8em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cc-empty .cc-pos { color: rgba(0,180,220,0.55); }
  .cc-empty .cc-name { font-size: 0.85em; font-weight: 400; color: rgba(0,180,220,0.6); }

  /* Zamiana pozycji (klasa .cc-swapped na .cc): gracz jedzie na drugą pozycję i przejmuje jej kolor */
  .cc-fill-b { opacity: 0; }
  .cc-fill-a, .cc-fill-b { transition: opacity var(--dur-3, .9s) var(--ease, ease); }
  .cc-swapped .cc-swappable .cc-member { transform: translate(var(--sx), var(--sy)); }
  .cc-swapped .cc-swappable .cc-fill-a { opacity: 0; }
  .cc-swapped .cc-swappable .cc-fill-b { opacity: 1; }
</style>
