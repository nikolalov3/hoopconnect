---
/**
 * MatchCard: 1:1 port karty meczu z zakładki Klub (src/pages/ClubPage.jsx: MatchCard + RosterGrid + HexSlot).
 * Wszystkie rozmiary w em (1em = 10px przy --mcs: 1), więc kartę skaluje jedna zmienna --mcs na rodzicu.
 * Stany sceny „Znajdź grę obok" (Twój hex zajmuje wolne miejsce, pasek zmienia tekst, ostatnie miejsce
 * się zapełnia) włącza rodzic klasą .mc-step-2 / .mc-step-3 na przodku. Style globalne (is:global).
 */
import HexAvatar from './HexAvatar.astro'
type P = { l: string; f?: boolean } | null
interface Props {
  uid: string
  mode?: '2v2' | '3v3' | '5v5'
  status: 'open' | 'completed'
  playing?: boolean       // tag „Grasz" (uczestniczysz) i akcentowa ramka, jak w apce
  dist?: string
  home: { name: string; mine?: boolean; players: P[] }
  away: { name: string; mine?: boolean; players: P[] }
  score?: [number, number]
  date: string
  address: string
  cta?: string            // pasek na dole (gdy są wolne miejsca)
  ctaAlt?: string         // tekst paska po dołączeniu (scena Klub)
  you?: string            // litera Twojego hexa: zajmuje pierwsze wolne miejsce gości (scena Klub, krok 2)
  fill?: string           // litera gracza, który zajmuje drugie wolne miejsce (scena Klub, krok 3)
}
const { uid, mode = '3v3', status, playing = false, dist, home, away, score, date, address, cta, ctaAlt, you, fill } = Astro.props
const MODE: Record<string, string> = { '2v2': '#9050FF', '3v3': '#00CCFF', '5v5': '#FFA820' }
const color = MODE[mode] ?? '#00CCFF'
const homeWon = !!score && score[0] > score[1]
const awayWon = !!score && score[1] > score[0]
let n = 0
const awaySlots = away.players.map((p) => (p ? { p, n: 0 } : { p: null, n: ++n }))
---
<div class:list={['mc', { 'mc-mine': playing || !!you }]} style={`--mc-color:${color}`}>
  <div class="mc-bloom" aria-hidden="true"></div>
  <div class="mc-in">
    <div class="mc-top">
      <div class="mc-tags">
        <span class="mc-mode">{mode}</span>
        {(playing || you) && <span class:list={['mc-tag', 'mc-you', { dyn: !playing }]}><i></i>Grasz</span>}
        {status === 'completed' && <span class="mc-tag mc-done">Zakończony</span>}
      </div>
      {dist && <span class="mc-dist"><svg viewBox="0 0 24 30" aria-hidden="true"><path d="M12 0C7.6 0 4 3.6 4 8c0 6 8 22 8 22s8-16 8-22c0-4.4-3.6-8-8-8zm0 12a4 4 0 1 1 0-8 4 4 0 0 1 0 8z"/></svg>{dist}</span>}
    </div>

    <div class="mc-duel">
      <span class:list={['mc-team', { mine: home.mine }]}>{home.name}</span>
      <div class="mc-row">
        {home.players.map((p, i) => p
          ? <HexAvatar letter={p.l} frame={!!p.f} uid={`${uid}h${i}`} />
          : <span class="mc-slot"><svg class="mc-slot-bg" viewBox="0 0 40 40"><polygon points="20,2 36,11 36,29 20,38 4,29 4,11" /></svg></span>)}
      </div>
      <div class="mc-mid">
        <i></i>
        {score
          ? <span class="mc-score"><b class:list={{ win: homeWon }}>{score[0]}</b><span>:</span><b class:list={{ win: awayWon }}>{score[1]}</b></span>
          : <span class="mc-vs">VS</span>}
        <i></i>
      </div>
      <div class="mc-row">
        {awaySlots.map((s, i) => s.p
          ? <HexAvatar letter={s.p.l} frame={!!s.p.f} uid={`${uid}a${i}`} />
          : <span class:list={['mc-slot', { 'mc-slot-you': s.n === 1 && !!you, 'mc-slot-fill': s.n === 2 && !!fill }]}>
              <svg class="mc-slot-bg" viewBox="0 0 40 40"><polygon points="20,2 36,11 36,29 20,38 4,29 4,11" /></svg>
              {s.n === 1 && you && <HexAvatar class="mc-me" letter={you} frame={true} uid={`${uid}me`} />}
              {s.n === 2 && fill && <HexAvatar class="mc-fillhex" letter={fill} uid={`${uid}fill`} />}
            </span>)}
      </div>
      <span class:list={['mc-team', { mine: away.mine }]}>{away.name}</span>
    </div>

    <div class="mc-when"><b>{date}</b><span>{address}</span></div>

    {cta && (
      <div class="mc-cta">
        <span class="mc-cta-tx">{ctaAlt ? <><span class="c1">{cta}</span><span class="c2">{ctaAlt}</span></> : cta}</span>
        <svg viewBox="0 0 12 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 2l8 8-8 8"/></svg>
      </div>
    )}
  </div>
</div>

<style is:global>
  /* --mcs ustawia RODZIC (nie definiujemy go tutaj, żeby nie nadpisać dziedziczenia) */
  .mc { --c: var(--mc-color, #00CCFF); font-size: calc(10px * var(--mcs, 1)); position: relative; width: 34.3em; max-width: 100%;
    border-radius: 2em; overflow: hidden; isolation: isolate; color: #E0EEFF; font-family: var(--body);
    background: linear-gradient(165deg, rgba(28,48,78,0.50) 0%, rgba(6,14,26,0.72) 100%);
    border: 1px solid rgba(160,200,255,0.18); -webkit-backdrop-filter: blur(20px) saturate(160%); backdrop-filter: blur(20px) saturate(160%); }
  .mc-mine { border-color: rgba(0,204,255,0.55); box-shadow: 0 0 0 1px rgba(0,204,255,0.16), 0 0 2.4em rgba(0,204,255,0.16); }
  .mc-bloom { position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background: radial-gradient(ellipse 70% 50% at 18% -8%, color-mix(in srgb, var(--c) 15%, transparent), transparent 60%); }
  .mc-bloom::after { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.20), transparent); }
  .mc-in { position: relative; z-index: 1; padding: 1.1em 1.5em 1.3em; }
  .mc-top { display: flex; align-items: center; justify-content: space-between; gap: .8em; margin-bottom: 1.2em; }
  .mc-tags { display: flex; align-items: center; gap: .6em; flex-wrap: wrap; }
  .mc-mode { padding: .3em 1em; border-radius: .7em; background: color-mix(in srgb, var(--c) 11%, transparent);
    font-family: var(--display); font-weight: 800; font-size: .95em; letter-spacing: .16em; text-transform: uppercase; color: var(--c); }
  .mc-tag { display: inline-flex; align-items: center; gap: .4em; padding: .3em .9em; border-radius: .6em; font-family: var(--display);
    font-weight: 800; font-size: .9em; letter-spacing: .1em; text-transform: uppercase; }
  .mc-you { background: rgba(0,204,255,0.13); border: 1px solid rgba(0,204,255,0.33); color: #55EEFF; }
  .mc-you i { width: .5em; height: .5em; border-radius: 50%; background: #55EEFF; box-shadow: 0 0 .5em #55EEFF; }
  .mc-done { padding: .2em .7em; background: rgba(0,232,144,0.07); border: 1px solid rgba(0,232,144,0.19); color: #00E890; font-weight: 700; }
  .mc-dist { display: flex; align-items: center; gap: .4em; font-size: 1em; font-weight: 700; color: #00CCFF; flex-shrink: 0; }
  .mc-dist svg { width: .8em; height: 1.1em; fill: #00CCFF; }
  .mc-duel { display: flex; flex-direction: column; gap: .5em; margin-bottom: 1.2em; }
  .mc-team { text-align: center; font-size: .95em; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; line-height: 1.2; color: #E0EEFF; }
  .mc-team.mine { color: #55EEFF; }
  .mc-row { display: flex; gap: 1em; justify-content: center; align-items: center; height: 5.4em; }
  .mc-row > .hexav { width: 5.4em; height: 5.4em; }
  .mc-slot { position: relative; width: 4.1em; height: 4.1em; display: grid; place-items: center; }
  .mc-slot-bg { width: 100%; height: 100%; overflow: visible; }
  .mc-slot polygon { fill: rgba(4,10,22,0.40); stroke: rgba(255,84,104,0.44); stroke-width: 1.4; stroke-dasharray: 3.2 2.6; }
  .mc-slot .hexav { position: absolute; top: -.65em; left: -.65em; width: 5.4em; height: 5.4em; }
  .mc-mid { display: flex; align-items: center; gap: 1.2em; margin: .4em 0; }
  .mc-mid i { flex: 1; height: 1px; background: linear-gradient(90deg, transparent, rgba(160,200,255,0.20)); }
  .mc-mid i:last-child { background: linear-gradient(90deg, rgba(160,200,255,0.20), transparent); }
  .mc-vs { font-family: var(--display); font-size: 1.2em; font-weight: 900; letter-spacing: .17em; color: rgba(160,200,255,0.45); flex-shrink: 0; }
  .mc-score { display: flex; align-items: center; gap: .8em; font-family: var(--display); font-weight: 900; line-height: 1; flex-shrink: 0; }
  .mc-score b { font-size: 2.2em; color: #E0EEFF; font-weight: 900; }
  .mc-score b.win { color: #00E890; text-shadow: 0 0 .64em rgba(0,232,144,0.28); }
  .mc-score > span { font-size: 1.2em; color: #172840; }
  .mc-when { display: flex; flex-direction: column; align-items: center; gap: .4em; text-align: center; }
  .mc-when b { font-family: var(--display); font-size: 1.4em; font-weight: 800; letter-spacing: .04em; color: #E0EEFF; line-height: 1.3; }
  .mc-when span { font-size: 1.15em; color: rgba(224,238,255,0.62); line-height: 1.3; }
  .mc-cta { margin-top: 1.4em; display: flex; align-items: center; justify-content: space-between; padding: 1.1em 1.5em; border-radius: 1.3em;
    background: linear-gradient(90deg, rgba(0,204,255,0.125), rgba(0,204,255,0.04)); border: 1px solid rgba(0,204,255,0.25);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.06), 0 0 1.8em rgba(0,204,255,0.08); color: #55EEFF; }
  .mc-cta-tx { font-family: var(--display); font-weight: 800; font-size: 1.05em; letter-spacing: .17em; text-transform: uppercase; display: grid; }
  .mc-cta-tx > span { grid-area: 1 / 1; white-space: nowrap; }
  .mc-cta > svg { width: .7em; height: 1.2em; flex-shrink: 0; }

  /* Stany sceny Klub (tylko opacity/transform). Domyślnie: wolne miejsca, pasek „Dołącz". */
  .mc-you.dyn, .mc-me, .mc-fillhex, .mc-cta-tx .c2 { opacity: 0;
    transition: opacity var(--dur-2, .64s) var(--ease, ease), transform var(--dur-2, .64s) var(--ease, ease); }
  .mc-me, .mc-fillhex { transform: scale(.4); }
  .mc-slot-bg, .mc-cta-tx .c1 { transition: opacity var(--dur-2, .64s) var(--ease, ease); }
  :is(.mc-step-2, .mc-step-3) .mc-you.dyn { opacity: 1; }
  :is(.mc-step-2, .mc-step-3) .mc-me { opacity: 1; transform: none; }
  :is(.mc-step-2, .mc-step-3) .mc-slot-you > .mc-slot-bg { opacity: 0; }   /* hex z inicjałem to też svg, stąd osobna klasa tła */
  :is(.mc-step-2, .mc-step-3) .mc-cta-tx .c1 { opacity: 0; }
  :is(.mc-step-2, .mc-step-3) .mc-cta-tx .c2 { opacity: 1; }
  .mc-step-3 .mc-fillhex { opacity: 1; transform: none; }
  .mc-step-3 .mc-slot-fill > .mc-slot-bg { opacity: 0; }
</style>
