---
/**
 * TrainDay: port ekranu „Dziś" z asystenta treningu (src/pages/HomePage.jsx: powitanie, postęp dnia,
 * sloty „Sesja poranna" i „Sesja główna" z kartami ćwiczeń). Dzień treningowy z dwoma ćwiczeniami
 * głównymi: w apce tak wygląda mniej więcej co trzeci dzień (pickDailyTrainings).
 * To element produktu w HTML. Dane poglądowe (nazwy ćwiczeń z tabeli trainings).
 *
 * mode="hero": stan w połowie dnia (2 z 4 zaliczone), z powitaniem i miejscem na pierścień (slot „ring").
 *   Od 900 px ekran rozkłada się na dwie kolumny (pierścień obok listy), żeby otwarcie strony nie było wieżą.
 * mode="scene": stan ustawia data-step na przodku (scena sticky):
 *   1  sesja poranna (reszta przygaszona) · 2  sesja główna · 3  wyciszenie · 4  dzień zaliczony.
 * Zmieniają się tylko opacity i transform (pasek postępu to scaleX). Bez JS widać stan 1.
 * Rozmiary w em (1em = 10px przy --trs: 1), skalę ustawia rodzic zmienną --trs.
 * Nagłówki slotów mają w apce emoji; na stronie zostaje sam tekst.
 */
import TrainCard from './TrainCard.astro'
interface Props { mode?: 'hero' | 'scene'; name?: string }
const { mode = 'hero', name = 'Szymon' } = Astro.props
const hero = mode === 'hero'
const COUNTS = [0, 1, 3, 4]   // zaliczone ćwiczenia w krokach sceny 1..4
---
<div class:list={['td', hero ? 'td-hero' : 'td-scene']}>
  <div class="td-side">
    {hero && <p class="td-hi">Cześć, {name}</p>}
    {Astro.slots.has('ring') && (
      <div class="td-ring">
        <p class="td-label">Twój postęp</p>
        <slot name="ring" />
      </div>
    )}
    <div class="td-prog">
      <div class="td-bar"><i></i></div>
      <p class="td-count">
        {hero
          ? <span class="on">2 / 4 sesji ukończonych dziś</span>
          : COUNTS.map((c, i) => <span class={`s${i + 1}`}>{c} / 4 sesji ukończonych dziś</span>)}
      </p>
      {!hero && <span class="td-done">Dzień zaliczony</span>}
    </div>
  </div>

  <div class="td-list">
    <p class="td-slot">Sesja poranna</p>
    <TrainCard n={1} title="Rozciąganie dynamiczne" pts={1} mult={14} diff={1} done={hero} />
    <p class="td-slot">Sesja główna</p>
    <TrainCard n={2} title="Trójki z narożnika" pts={2} mult={30} diff={2} done={hero} />
    <TrainCard n={3} title="Kozłowanie między pachołkami" pts={2} mult={40} diff={3} />
    <TrainCard n={4} title="Foam rolling" pts={2} mult={20} diff={1} />
  </div>
</div>

<style is:global>
  .td { --p: 0; font-size: calc(10px * var(--trs, 1)); width: 36em; max-width: 100%; display: grid; gap: 1.6em; padding: 2.4em 2.2em 2.6em; border-radius: 2.8em;
    text-align: left; color: #EEF4FF; font-family: var(--body); border: 1px solid rgba(150,200,255,0.12);
    background: radial-gradient(ellipse 80% 45% at 50% -5%, rgba(91,184,245,0.20) 0%, rgba(91,184,245,0) 62%), linear-gradient(170deg, #0C1F38 0%, #091828 42%, #060F1E 100%);
    box-shadow: 0 3em 7em rgba(0,0,0,0.55); }
  .td-hero { --p: 0.5; }
  .td-side, .td-list { min-width: 0; display: grid; gap: 1em; align-content: start; }
  .td-hi { font-family: var(--display); font-weight: 900; font-size: 3.4em; line-height: 1; text-transform: uppercase; letter-spacing: 0.01em; color: #F2F7FF; }
  .td-ring { display: grid; justify-items: center; gap: 0.8em; margin-top: 0.6em; }
  .td-label { justify-self: start; font-family: var(--display); font-weight: 800; font-size: 1.8em; letter-spacing: 0.03em; text-transform: uppercase; line-height: 1.1; }
  .td-prog { display: grid; justify-items: center; gap: 0.9em; margin-top: 0.4em; }
  .td-bar { width: 70%; height: 0.3em; border-radius: 0.2em; background: rgba(255,255,255,0.07); overflow: hidden; }
  .td-bar i { display: block; height: 100%; border-radius: inherit; background: #5BB8F5; transform-origin: 0 50%; transform: scaleX(var(--p));
    transition: transform var(--dur-3, .9s) var(--ease, ease); }
  .td-count { display: grid; justify-items: center; font-size: 1.2em; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; line-height: 1.2; color: #9FB0C8; }
  .td-count span { grid-area: 1 / 1; opacity: 0; transition: opacity var(--dur-1, .42s) var(--ease, ease); }
  .td-count .on, .td-count .s1 { opacity: 1; }
  .td-done { padding: 0.4em 1em; border-radius: 0.7em; font-family: var(--display); font-weight: 700; font-size: 1.2em; letter-spacing: 0.14em; text-transform: uppercase;
    line-height: 1.2; color: #00E676; background: rgba(0,230,118,0.10); box-shadow: inset 0 0 0 1px rgba(0,230,118,0.26); opacity: 0; transform: translateY(0.5em);
    transition: opacity var(--dur-2, .64s) var(--ease, ease), transform var(--dur-2, .64s) var(--ease, ease); }
  .td-slot { margin: 0.6em 0 0 0.2em; font-family: var(--display); font-weight: 700; font-size: 1.15em; letter-spacing: 0.26em; text-transform: uppercase;
    line-height: 1.2; color: #6F86A6; }
  .td-list > .td-slot:first-child { margin-top: 0; }
  @media (min-width: 900px) {
    .td-hero { width: 74em; grid-template-columns: 0.82fr 1fr; gap: 3.2em; align-items: center; padding: 3em 3em 3.2em; }
  }

  /* ── Stany sceny (data-step na przodku). Zmienne --d / --o czyta TrainCard. ── */
  [data-step="1"] .td-scene :is(.n2, .n3, .n4) { --o: 0.36; }
  [data-step="2"] .td-scene { --p: 0.25; }
  [data-step="2"] .td-scene .n1 { --d: 1; }
  [data-step="2"] .td-scene :is(.n1, .n4) { --o: 0.36; }
  [data-step="3"] .td-scene { --p: 0.75; }
  [data-step="3"] .td-scene :is(.n1, .n2, .n3) { --d: 1; --o: 0.36; }
  [data-step="4"] .td-scene { --p: 1; }
  [data-step="4"] .td-scene .tc { --d: 1; }
  [data-step="4"] .td-scene .td-done { opacity: 1; transform: none; }
  [data-step]:not([data-step="1"]) .td-scene .td-count .s1 { opacity: 0; }
  [data-step="2"] .td-scene .td-count .s2, [data-step="3"] .td-scene .td-count .s3, [data-step="4"] .td-scene .td-count .s4 { opacity: 1; }
</style>
