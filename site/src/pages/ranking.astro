---
import Base from '../layouts/Base.astro'
import RankBoard from '../components/RankBoard.astro'
import DraftRing from '../components/DraftRing.astro'
import { RANK_URL, APP_URL } from '../consts'

const title = 'Ranking graczy koszykówki 3x3'
const description =
  'Publiczny ranking HoopConnect: trzy tablice (XP, mecze, King of the Court), filtr po mieście ' +
  'i dokładna rozpiska, za co i ile XP dostajesz. Bez logowania.'

// Wartości XP z aplikacji (triggery: trg_award_match_xp, kotc_award_xp; trening z sufitem 100 XP na tydzień).
// Źródło: supabase/migrations/20260902_xp_rebalance.sql i 20260902_kotc_solo.sql. Trzymać zgodność.
const XP_MATCH = [
  { label: 'Wygrany mecz', xp: '+75', ds: '+50' },
  { label: 'Przegrany mecz lub remis', xp: '+40', ds: '+20' },
]
const XP_KOTC = [
  { label: '1. miejsce', xp: '+275', ds: '+120' },
  { label: '2. miejsce', xp: '+195', ds: '+70' },
  { label: '3. miejsce', xp: '+145', ds: '+40' },
  { label: '4. miejsce', xp: '+115', ds: '+25' },
  { label: '5. miejsce i dalej', xp: '+95', ds: '+10' },
]

// „W skrócie": cztery fakty tuż pod otwarciem (czytelne dla ludzi i dla wyszukiwarek odpowiedzi).
const BRIEF = [
  { t: 'Publiczny', d: 'Otwierasz go w przeglądarce, bez konta i bez logowania.' },
  { t: 'Trzy tablice', d: 'XP, mecze i King of the Court. Każda liczy co innego.' },
  { t: 'Filtr po mieście', d: 'Miasto pojawia się w filtrze, gdy ma co najmniej 10 graczy.' },
  { t: 'XP zostaje', d: 'Raz zdobyte nie spada. Draft Score do rankingu nie trafia.' },
]

// Scena „Trzy tablice": aktywny krok przełącza zakładkę tablicy (ten sam komponent, co w apce).
const BOARD_STEPS = [
  { t: 'XP: cała Twoja droga', d: 'Suma doświadczenia ze wszystkich meczów, sesji i treningów. XP nie spada, więc tu liczy się cała Twoja historia.' },
  { t: 'Mecze: kto gra i wygrywa', d: 'Wygrane, rozegrane mecze i procent zwycięstw. Możesz zawęzić do ostatnich 30 dni i sprawdzić, kto jest w formie teraz.' },
  { t: 'King of the Court: kto zostaje królem', d: 'Ile sesji skończyłeś jako mistrz i w ilu w ogóle grałeś.' },
]

const XP_VS_DS = [
  { t: 'XP', d: 'Za mecze, sesje i trening. Nigdy nie spada i odblokowuje kolejne areny.' },
  { t: 'Draft Score', d: 'Forma tygodnia, tylko dla Ciebie. W poniedziałek startuje od zera.' },
  { t: 'Most między nimi', d: 'Na koniec tygodnia 10% Draft Score zamienia się w stałe XP.' },
]

// FAQ rankingu: treść widoczna na stronie jest tą samą, która idzie do danych FAQPage.
const FAQ = [
  {
    q: 'Czy ranking HoopConnect jest publiczny?',
    a: 'Tak. Ranking otwierasz w przeglądarce pod adresem app.hoopconnect.pl/rank, bez konta i bez logowania. Link możesz podesłać każdemu.',
  },
  {
    q: 'Za co dostaję XP w HoopConnect?',
    a: 'Za mecz 3x3 dostajesz 75 XP za wygraną i 40 XP za przegraną lub remis. Za sesję King of the Court od 95 do 275 XP, ' +
      'zależnie od miejsca Twojej drużyny. Za trening z asystentem do 100 XP tygodniowo.',
  },
  {
    q: 'Czy XP może spaść?',
    a: 'Nie. Raz zdobyte XP zostaje na stałe. Buduje Twoją pozycję w rankingu i odblokowuje kolejne areny.',
  },
  {
    q: 'Czym różni się XP od Draft Score?',
    a: 'XP jest stałe i publiczne, widać je w rankingu. Draft Score to prywatny wskaźnik formy tygodnia: w poniedziałek startuje od zera, ' +
      'a na koniec tygodnia 10% z niego zamienia się w XP. Draft Score nie trafia do rankingu.',
  },
  {
    q: 'Dlaczego nie widzę swojego miasta w filtrze?',
    a: 'Miasto pojawia się w filtrze, gdy ma co najmniej 10 graczy. Do tego czasu jesteś widoczny w rankingu ogólnym.',
  },
  {
    q: 'Jak trafić do rankingu?',
    a: 'Załóż konto w aplikacji i rozegraj mecz 3x3 albo sesję King of the Court. Po zatwierdzeniu wyniku dostajesz XP i pojawiasz się na tablicy.',
  },
]
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((it) => ({ '@type': 'Question', name: it.q, acceptedAnswer: { '@type': 'Answer', text: it.a } })),
}
---
<Base title={title} description={description} schema={faqSchema}>
  <!-- ═══ 1. OTWARCIE: nagłówek, a pod nim tablica z apki, na której „Ty" wygrywa mecz i wskakuje wyżej ═══ -->
  <section class="page-hero">
    <div class="wrap">
      <span class="tag live hero-after"><b></b>Ranking na żywo · beta</span>
      <h1>
        <span class="ln"><span>Ranking</span></span>
        <span class="ln"><span class="hl">nie kłamie</span></span>
      </h1>
      <div class="hero-after">
        <p class="lead">Publiczny ranking HoopConnect liczy to, co naprawdę zagrałeś: XP, mecze i sesje King of the Court. Otwierasz go bez logowania.</p>
        <div class="cta-row">
          <a class="btn btn-primary btn-lg" href={RANK_URL} target="_blank" rel="noopener">Otwórz ranking na żywo<span class="arw">→</span></a>
          <a class="btn btn-ghost btn-lg" href={APP_URL} target="_blank" rel="noopener">Otwórz aplikację</a>
        </div>
      </div>
      <div class="hero-board hero-after">
        <RankBoard uid="rh" story />
      </div>
    </div>
  </section>

  <!-- ═══ 2. W SKRÓCIE ═══ -->
  <section class="ch brief">
    <div class="wrap">
      <h2 class="rv">W skrócie</h2>
      <dl class="facts rv">
        {BRIEF.map((f) => <div><dt>{f.t}</dt><dd>{f.d}</dd></div>)}
      </dl>
    </div>
  </section>

  <!-- ═══ 3. TRZY TABLICE: przyklejona tablica, krok przełącza zakładkę ═══ -->
  <section class="ch" id="tablice">
    <div class="wrap">
      <div class="ch-head rv rv-seq">
        <h2><span class="ln"><span>Trzy tablice.</span></span> <span class="ln"><span>Trzy odpowiedzi.</span></span></h2>
        <p class="lead">Nie ma jednej ogólnej listy, w której wszystko się rozmywa. Każda tablica odpowiada na inne pytanie.</p>
      </div>
      <div class="scene flip" data-scene="rank" data-step="1">
        <div class="scene-visual">
          <div class="scene-board">
            <RankBoard uid="rs" cities={false} />
          </div>
        </div>
        <ol class="steps">
          {BOARD_STEPS.map((s, i) => (
            <li class:list={['step', { on: i === 0 }]} data-i={i + 1}>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ═══ 4. ZA CO JEST XP: tabela wyników, liczby z aplikacji ═══ -->
  <section class="ch ch-center" id="xp">
    <div class="wrap">
      <div class="ch-head rv rv-seq">
        <h2><span class="ln"><span>Za co jest XP</span></span></h2>
        <p class="lead">Najwięcej daje granie z ludźmi. Trening pomaga, ale ma tygodniowy sufit, żeby boisko zawsze znaczyło więcej.</p>
      </div>
      <div class="xp-tables">
        <table class="xpt rv">
          <caption>Mecz 3x3</caption>
          <thead><tr><th scope="col">Wynik</th><th scope="col" class="c-xp"><img src="/brand/xp-96.webp" width="18" height="18" alt="" />XP</th><th scope="col" class="c-ds">Draft Score</th></tr></thead>
          <tbody>
            {XP_MATCH.map((r) => <tr><th scope="row">{r.label}</th><td class="c-xp">{r.xp}</td><td class="c-ds">{r.ds}</td></tr>)}
          </tbody>
        </table>
        <table class="xpt rv rv-d1">
          <caption>King of the Court <small>za sesję, według miejsca drużyny</small></caption>
          <thead><tr><th scope="col">Miejsce</th><th scope="col" class="c-xp"><img src="/brand/xp-96.webp" width="18" height="18" alt="" />XP</th><th scope="col" class="c-ds">Draft Score</th></tr></thead>
          <tbody>
            {XP_KOTC.map((r) => <tr><th scope="row">{r.label}</th><td class="c-xp">{r.xp}</td><td class="c-ds">{r.ds}</td></tr>)}
          </tbody>
        </table>
        <table class="xpt rv rv-d2">
          <caption>Trening z asystentem</caption>
          <thead><tr><th scope="col">Zakres</th><th scope="col" class="c-xp"><img src="/brand/xp-96.webp" width="18" height="18" alt="" />XP</th><th scope="col" class="c-ds">Draft Score</th></tr></thead>
          <tbody>
            <tr><th scope="row">Cały tydzień treningów</th><td class="c-xp">do +100</td><td class="c-ds">rośnie z każdym treningiem</td></tr>
          </tbody>
        </table>
      </div>
      <p class="xp-note rv">Tydzień treningu to mniej więcej jeden do dwóch wygranych meczów. Tak ma być: boisko liczy się bardziej.</p>
    </div>
  </section>

  <!-- ═══ 5. FILTR PO MIEŚCIE ═══ -->
  <section class="ch" id="miasta">
    <div class="wrap split">
      <div class="split-copy rv rv-seq">
        <h2><span class="ln"><span>Twoje miasto.</span></span> <span class="ln"><span>Twoja tablica.</span></span></h2>
        <p class="lead">Ranking zawężasz do swojego miasta jednym kliknięciem. Miasto pojawia się w filtrze, gdy ma co najmniej dziesięciu graczy, żeby było z kim się porównać.</p>
        <p class="fact">Brakuje Twojego miasta? Zbierz ekipę. Dziesięć kont i macie własną tablicę.</p>
      </div>
      <div class="city-mock rv rv-d1" aria-hidden="true">
        <p>Miasto</p>
        <div>
          <span class="opt on">Wszystkie miasta</span>
          <span class="opt">Kraków <small>20</small></span>
          <span class="opt next">Twoje miasto <small>od 10 graczy</small></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 6. XP A DRAFT SCORE ═══ -->
  <section class="ch" id="draft-score">
    <div class="wrap split">
      <DraftRing uid="rank" score={620} />
      <div class="split-copy rv rv-seq">
        <h2><span class="ln"><span>XP zostaje.</span></span> <span class="ln"><span>Draft Score znika.</span></span></h2>
        <p class="lead">XP to Twoja historia: stałe, publiczne, widoczne w rankingu. Draft Score to forma tygodnia: prywatna i liczona od poniedziałku.</p>
        <dl class="facts">
          {XP_VS_DS.map((f) => <div><dt>{f.t}</dt><dd>{f.d}</dd></div>)}
        </dl>
        <a class="inline-link" href="/asystent-treningu">Jak działa Draft Score<span class="arw">→</span></a>
      </div>
    </div>
  </section>

  <!-- ═══ 7. PYTANIA ═══ -->
  <section class="ch" id="pytania">
    <div class="wrap faq-grid">
      <div class="ch-head rv rv-seq">
        <h2><span class="ln"><span>Pytania o ranking</span></span></h2>
        <p class="lead">Najczęstsze pytania o XP i tablice. Reszta jest w pełnym <a class="inline-link lower" href="/faq">FAQ</a>.</p>
      </div>
      <div class="qa rv rv-d1">
        {FAQ.map((it) => (
          <details class="qa-item">
            <summary><span class="q">{it.q}</span><span class="chev" aria-hidden="true"></span></summary>
            <p>{it.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 8. ZAMKNIĘCIE ═══ -->
  <section class="ch ch-last ch-center" id="zagraj">
    <div class="wrap">
      <div class="ch-head rv rv-seq">
        <h2><span class="ln"><span>Twoje miejsce</span></span> <span class="ln"><span>już czeka</span></span></h2>
        <p class="lead">Załóż kartę gracza, zagraj mecz i zobacz swoje imię na tablicy. Mecze znajdziesz w zakładce <a class="inline-link lower" href="/klub">Klub</a>.</p>
        <div class="cta-row">
          <a class="btn btn-primary btn-lg" href={APP_URL} target="_blank" rel="noopener">Otwórz aplikację<span class="arw">→</span></a>
          <a class="btn btn-ghost btn-lg" href={RANK_URL} target="_blank" rel="noopener">Otwórz ranking</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* 1. Otwarcie */
  .page-hero .tag { margin-bottom: 26px; }
  .hero-board { --rbs: 1; position: relative; max-width: 912px; margin: clamp(40px, 5vw, 64px) auto 0; }
  /* plama światła pod tablicą, rozpływa się w tło strony */
  .hero-board::before { content: ''; position: absolute; z-index: -1; inset: -12% -22% -22%; pointer-events: none;
    background: radial-gradient(ellipse 60% 56% at 50% 46%, rgba(24,40,74,0.95) 0%, rgba(21,33,58,0.6) 42%, rgba(14,15,18,0) 74%); }
  @media (max-width: 699px) { .hero-board { --rbs: 0.98; } }

  /* 2. W skrócie: cztery fakty w dwóch kolumnach, bez pudełek */
  .brief { padding-top: clamp(72px, 9vw, 128px); }
  .brief h2 { font-size: clamp(22px, 2.4vw, 30px); letter-spacing: 1.2px; color: var(--text-2); margin-bottom: 26px; }
  .brief .facts { max-width: none; gap: 20px clamp(32px, 6vw, 88px); margin-bottom: 0; }
  @media (min-width: 860px) { .brief .facts { grid-template-columns: 1fr 1fr; } }

  /* 3. Trzy tablice: tablica przyklejona, kroki obok */
  .scene-board { --rbs: 1; width: 100%; max-width: 540px; }
  @media (max-width: 899px) {
    .scene-board { --rbs: 0.9; max-width: 360px; margin-inline: auto; }
    /* na telefonie w przyklejonym polu mieszczą się cztery pierwsze miejsca */
    .scene-board :global(.rb-row:nth-child(n+5)), .scene-board :global(.rb-note) { display: none; }
  }

  /* 4. Tabele XP: wyniki jak na tablicy, linie tylko między wierszami */
  .xp-tables { display: grid; gap: clamp(36px, 5vw, 56px); max-width: 860px; margin-inline: auto; text-align: left; }
  .xpt { width: 100%; border-collapse: collapse; }
  .xpt caption { text-align: left; font-family: var(--display); font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px;
    font-size: clamp(24px, 2.8vw, 34px); color: var(--text); padding-bottom: 10px; }
  .xpt caption small { display: block; margin-top: 4px; font-family: var(--body); font-weight: 400; text-transform: none; letter-spacing: 0;
    font-size: 14px; color: var(--text-3); }
  .xpt th, .xpt td { padding: 15px 0; border-bottom: 1px solid var(--line); vertical-align: baseline; }
  .xpt thead th { padding: 8px 0; font-size: 11px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; color: var(--text-3); text-align: left; }
  .xpt tbody th { font-weight: 400; text-align: left; color: var(--text-2); font-size: clamp(16px, 1.4vw, 18px); }
  .xpt .c-xp, .xpt .c-ds { text-align: right; width: 24%; white-space: nowrap; }
  .xpt thead .c-xp img { display: inline-block; width: 18px; height: 18px; vertical-align: -4px; margin-right: 6px; }
  .xpt td.c-xp { font-family: var(--display); font-weight: 700; font-size: clamp(26px, 3vw, 38px); line-height: 1; color: var(--accent-hi); font-variant-numeric: tabular-nums; }
  .xpt td.c-ds { font-family: var(--display); font-weight: 700; font-size: clamp(18px, 2vw, 24px); line-height: 1; color: var(--orange-hi); font-variant-numeric: tabular-nums; }
  .xpt tbody tr:last-child th, .xpt tbody tr:last-child td { border-bottom: 0; }
  .xpt tbody tr:only-child td.c-ds { font-family: var(--body); font-weight: 400; font-size: 14px; white-space: normal; color: var(--text-3); }
  .xp-note { margin: clamp(28px, 4vw, 44px) auto 0; text-align: center; color: var(--text-2); font-size: clamp(16px, 1.3vw, 18px); max-width: 52ch; }
  @media (max-width: 560px) { .xpt .c-ds { width: 30%; } .xpt .c-xp { width: 26%; } }

  /* 5. Filtr miasta: te same ścięte przyciski, co w apce; trzeci pokazuje próg 10 graczy */
  .city-mock { justify-self: center; width: min(100%, 420px); }
  .city-mock p { margin: 0 0 14px; font-size: 11px; font-weight: 600; letter-spacing: 1.6px; text-transform: uppercase; color: var(--text-3); }
  .city-mock div { display: flex; flex-wrap: wrap; gap: 10px; }
  .city-mock .opt { --bd: var(--line-2); --fill: #131419; --cut: 10px; position: relative; isolation: isolate; z-index: 0; display: inline-flex; align-items: center; gap: 10px;
    padding: 12px 18px; font-size: 16px; font-weight: 600; line-height: 1.25; color: var(--text-2); white-space: nowrap; }
  .city-mock .opt::after { content: ''; position: absolute; inset: 0; z-index: -2; background: var(--bd);
    clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, 0 100%); }
  .city-mock .opt::before { content: ''; position: absolute; inset: 1px; z-index: -1; background: var(--fill);
    clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, 0 100%); }
  .city-mock .opt.on { --bd: rgba(96,168,224,.6); --fill: #163D65; color: #EAF3FF; }
  .city-mock .opt small { font-size: 13px; font-weight: 600; color: var(--text-3); }
  .city-mock .opt.next { --bd: rgba(111,195,255,.42); --fill: #0F1823; color: var(--accent-hi); }
  .city-mock .opt.next small { color: rgba(111,195,255,.7); }

  /* 6. Pierścień po lewej na desktopie zostaje pierwszy w kodzie i w układzie */
  #draft-score :global(.ring-wrap) { justify-self: center; }
</style>

<script>
  import { initCounters, initScenes } from '../scripts/motion'

  initCounters()
  // Scena „Trzy tablice": krok 1 / 2 / 3 przełącza zakładkę XP / Mecze / King of the Court na przyklejonej tablicy.
  initScenes((scene, step) => {
    if (scene.dataset.scene !== 'rank') return
    const tab = ['xp', 'matches', 'kotc'][Number(step) - 1] ?? 'xp'
    scene.querySelector<HTMLButtonElement>(`.rb-tab[data-tab="${tab}"]`)?.click()
  })
</script>
