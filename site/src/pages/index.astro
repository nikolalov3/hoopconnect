  .ring { position: relative; width: clamp(150px, 20vw, 190px); flex-shrink: 0; }
  .ring svg { width: 100%; height: auto; transform: rotate(-90deg); }
  .ring-bg { fill: none; stroke: var(--line-2); stroke-width: 7; }
  .ring-fg { fill: none; stroke: var(--orange); stroke-width: 7; stroke-linecap: butt;
    stroke-dasharray: 327; stroke-dashoffset: 327; transition: stroke-dashoffset 1.4s .2s cubic-bezier(.2,.7,.2,1); }
