  .matchcard { --cut: 18px; --bd: rgba(111,195,255,0.35); --fill: var(--bg-2); padding: 1.5px;
    transform: rotateY(calc(var(--ry, 0) * 7deg)) rotateX(calc(var(--rx, 0) * -7deg)); transition: transform .3s ease;
    filter: drop-shadow(0 30px 60px rgba(0,0,0,0.55)); }
