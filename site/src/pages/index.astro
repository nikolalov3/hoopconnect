  @media (max-width: 719px) { .cm-big :global(.pc3d-wrap) { --pcs: 0.78; } }
  .cm-big .pc-brand { font-size: 12px; gap: 6px; } .cm-big .pc-brand img { width: 20px; height: 20px; }
  .cm-big .pc-hex { width: 104px; height: 104px; } .cm-big .pc-hex b { font-size: 36px; }
  .cm-big .pc-name { font-size: 22px; margin-top: 8px; } .cm-big .pc-arena { font-size: 12px; }
  .cm-big .pc-bar { height: 5px; margin-top: 8px; }
  .cm-big .pc-stats { gap: 8px; margin-top: 8px; } .cm-big .pc-stats > span { font-size: 10px; padding: 9px 4px; }
  .cm-big .pc-stats b { font-size: 26px; } .cm-big .pc-abbr { font-size: 13px; top: 14px; right: 16px; }
  .cm-tx .kicker { margin-bottom: 14px; }
  .cm-tx h2 { font-size: clamp(28px, 3.6vw, 40px); margin-bottom: 12px; }
  .cm-desc { color: var(--text-2); font-size: 16px; line-height: 1.55; margin-bottom: 18px; }
  .cm-legend { list-style: none; padding: 0; display: grid; gap: 10px; margin-bottom: 24px; }
  .cm-legend li { position: relative; padding-left: 18px; font-size: 14px; line-height: 1.5; color: var(--text-2); }
  .cm-legend li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 6px; height: 6px; background: var(--accent); transform: rotate(45deg); }
  .cm-legend b { color: var(--text); font-weight: 600; }
  @media (min-width: 720px) { .cm-card { grid-template-columns: auto 1fr; } }

  /* Tablet i telefon: mniejsze karty; na telefonie scena szersza niż ekran (kadr na środek boiska) */
  @media (max-width: 939px) {
