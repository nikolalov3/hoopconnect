---
import Base from '../layouts/Base.astro'
import PlayerCard from '../components/PlayerCard.astro'
import { APP_URL, RANK_URL, COACH_OFFER_URL, APP_SCHEMA } from '../consts'
import QRCode from 'qrcode'

// QR w zamknięciu: ktoś czyta na laptopie, gra z telefonu. Generowany w buildzie.
const qrSvg = await QRCode.toString(APP_URL, {
  type: 'svg', margin: 0, errorCorrectionLevel: 'M',
  color: { dark: '#0E0F12', light: '#FFFFFF' },
})

// Ticker pod linią końcową boiska: same fakty o produkcie, żadnych wymyślonych liczb.
const TICKER = [
  'King of the Court', 'Ranking XP na żywo', 'Siedem aren', 'Karta gracza', 'Asystent treningu',
  'Draft Score', 'Darmowa dla graczy', 'Kraków i cała Polska', 'Phone down, game up.',
]

// Pięć kart gracza na boisku (hero). Pozycje w % kontenera boiska. Dane poglądowe, bez nazwisk.
// Elementy karty = te same, co w apce: hex z inicjałem, arena, pasek XP do następnej areny, wygrane.
// toNext liczone z progów aren (500/1500/2700/3900/5500/7500) dla p% postępu.
const CARDS = [
  { pos: 'Rozgrywający', name: 'Kuba',     l: 'K', arena: 4, arenaName: 'Ankh Court',   next: 'Void Gem',     p: 62, toNext: 608,  w: 12, k: 3, id: '20251', frame: 'default', x: 41.4, y: 20.8,
    desc: 'Prowadzi grę i rozdaje piłkę. Najwięcej sesji King of the Court w ekipie.' },
  { pos: 'Rzucający', name: 'Michał',        l: 'M', arena: 1, arenaName: 'Street Court', next: 'City Run',     p: 35, toNext: 650,  w: 4,  k: 0, id: '20318', frame: 'none',    x: 58.6, y: 20.8,
    desc: 'Dopiero zaczyna. Pierwsza arena odblokowana po czterech wygranych.' },
  { pos: 'Skrzydłowy', name: 'Bartek',       l: 'B', arena: 2, arenaName: 'City Run',     next: 'Golden Reign', p: 48, toNext: 624,  w: 7,  k: 1, id: '20277', frame: 'default', x: 23.8, y: 56.3,
    desc: 'Gra regularnie w sobotnich sesjach. Pierwszy tytuł króla boiska za nim.' },
  { pos: 'Silny skrzydłowy', name: 'Olek', l: 'O', arena: 3, arenaName: 'Golden Reign', next: 'Ankh Court',   p: 71, toNext: 348,  w: 9,  k: 2, id: '20194', frame: 'none',    x: 76.2, y: 56.3,
    desc: 'Walczy pod koszem. Blisko kolejnej areny, brakuje kilku meczów.' },
  { pos: 'Środkowy', name: 'Alex',         l: 'A', arena: 5, arenaName: 'Void Gem',     next: 'Seraphim',     p: 22, toNext: 1560, w: 15, k: 4, id: '20102', frame: 'default', live: true, x: 50.0, y: 84.7,
    desc: 'Najwyżej w ekipie. Cztery wygrane sesje KotC i najwięcej meczów na koncie.' },
]

// Rozdział „Znajdź grę obok": telefon z zakładką Klub (odtworzony w HTML na podstawie brand/session.webp),
// trzy kroki tekstu; aktywny krok zmienia stan ekranu klasą (data-step na scenie).
const CLUB_STEPS = [
  { t: 'Widzisz, kto gra obok', d: 'Sesje z godziną, miejscem i składem. Dwa kilometry od Ciebie, sobota, 19:30.' },
  { t: 'Dołączasz', d: 'Jeden ruch. Twój hex ląduje w składzie i ekipa widzi, że wchodzisz.' },
  { t: 'Skład się zapełnia', d: 'Sześć miejsc, sześć hexów. Jest mecz. Reszta dzieje się na boisku.' },
]
// Hexy na ekranie telefonu: skład z zrzutu (K, M, F vs A, B + wolne miejsce, które zajmujesz Ty).
const PH_HOME = [{ l: 'K', f: true }, { l: 'M', f: false }, { l: 'F', f: true }]
const PH_AWAY = [{ l: 'A', f: false }, { l: 'B', f: true }]

// Losowanie w King of the Court: dziewięciu graczy solo, trzy trójki w kolorach z apki
// (src/features/kotc/KotcSolo.jsx: Blue / Green / Red). Przebieg losowania robi skrypt na dole.
const DRAW_PLAYERS = ['K', 'M', 'F', 'A', 'B', 'S', 'J', 'O', 'W']
const DRAW_TEAMS = [
  { name: 'Blue', color: '#3B82F6' }, { name: 'Green', color: '#22C55E' }, { name: 'Red', color: '#F43F5E' },
]

// Rozdział „Karta gracza": cztery kroki, każdy obraca kartę i podświetla jeden jej element.
const CARD_STEPS = [
  { t: 'Hex z inicjałem', d: 'Twój znak w składzie, w rankingu i na karcie. Ten sam wszędzie.' },
  { t: 'Arena', d: 'Siedem poziomów, od Rozgrzewki po Seraphim. Nazwa na karcie mówi, jak daleko zaszedłeś.' },
  { t: 'Pasek XP', d: 'Ile brakuje do następnej areny. Każdy mecz przesuwa go w prawo. Nigdy w lewo.' },
  { t: 'Wygrane mecze i KotC', d: 'Dwie liczby, których nie da się wyklikać. Tylko to, co zagrałeś.' },
]

// Siedem aren z apki (src/lib/arenas.js): Rozgrzewka bez ramki, potem sześć z grafiką z public/arenas.
const ARENAS = [
  { n: 0, name: 'Rozgrzewka', xp: 0 },
  { n: 1, name: 'Street Court', xp: 500 }, { n: 2, name: 'City Run', xp: 1500 }, { n: 3, name: 'Golden Reign', xp: 2700 },
  { n: 4, name: 'Ankh Court', xp: 3900 }, { n: 5, name: 'Void Gem', xp: 5500 }, { n: 6, name: 'Seraphim', xp: 7500 },
]

// Teaser FAQ na stronie głównej: cytowalne odpowiedzi + FAQPage schema (rich results).
const HOME_FAQ = [
  {
    q: 'Czym jest HoopConnect?',
    a: 'HoopConnect to darmowa aplikacja do koszykówki ulicznej 3x3 i indywidualnego treningu. ' +
      'Znajdujesz grę i graczy w okolicy, grasz King of the Court, trenujesz i zbierasz XP w publicznych rankingach.',
  },
  {
    q: 'Ile kosztuje HoopConnect?',
    a: 'Dla graczy aplikacja jest darmowa. Płatny jest osobny panel dla trenerów i klubów.',
  },
  {
    q: 'Jak znaleźć grę w koszykówkę 3x3 w okolicy?',
    a: 'W zakładce Klub widzisz, kto gra lub planuje sesję na boiskach w pobliżu. Dołączasz do meczu albo ' +
      'tworzysz własny, a aplikacja losuje trzyosobowe drużyny.',
  },
  {
    q: 'Czy HoopConnect ma coś dla trenerów?',
    a: 'Tak. Panel dla trenerów pozwala prowadzić drużynę: dodawać zawodników, sprawdzać frekwencję na ' +
      'treningach i rozliczać składki.',
  },
]
const homeFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: HOME_FAQ.map((it) => ({
    '@type': 'Question',
    name: it.q,
    acceptedAnswer: { '@type': 'Answer', text: it.a },
  })),
}
---
<Base schema={[APP_SCHEMA, homeFaqSchema]}>
  <!-- ═══ HERO ═══ -->
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
      <h1>Zostań królem<br /><span class="hl">swojego boiska</span></h1>
      <p class="lead">Widzisz, kto gra obok, i dołączasz jednym ruchem. Grasz 3x3. Wynik zostaje na Twojej karcie.</p>
      <div class="cta-row">
        <a class="btn btn-primary btn-lg" href={APP_URL} target="_blank" rel="noopener">Zagraj dziś<span class="arw">→</span></a>
      </div>
      <ul class="hero-proof">
        <li>Darmowa dla graczy</li>
        <li>Bez instalacji, z przeglądarki</li>
        <li>Ranking bez logowania</li>
      </ul>
      <p class="stage-hint"><span aria-hidden="true"></span>Dotknij podświetlonej karty.</p>
      </div>

      <!-- Boisko: na desktopie prawa kolumna, linia końcowa = dolna krawędź hero, pod nią pasek. Pięć kart na pozycjach. -->
      <div class="court-stage" id="courtStage">
      <svg class="court-bg" viewBox="-0.7800 0.6600 1.5600 0.8455" aria-hidden="true" preserveAspectRatio="none">
        <!-- Warstwa STATYCZNA (filtry, ziarno): maluje się raz. Boisko 3x3 15×11 m, linie FIBA, rzut perspektywiczny
             (kamera za linią końcową: d=10 m, h=15 m). Ta sama projekcja liczy pozycje kart (CARDS x/y). -->
        <defs>
          <linearGradient id="cg-ground" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#0E0F12" stop-opacity="0" />
            <stop offset="0.45" stop-color="#111A2B" stop-opacity="0.85" />
            <stop offset="1" stop-color="#16233D" />
          </linearGradient>
          <radialGradient id="cg-spot" cx="0.5" cy="0.5" r="0.5">
            <stop offset="0" stop-color="#6FC3FF" stop-opacity="0.26" />
            <stop offset="0.5" stop-color="#2F91D6" stop-opacity="0.10" />
            <stop offset="1" stop-color="#2F91D6" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="cg-hoop" cx="0.5" cy="0.5" r="0.5">
            <stop offset="0" stop-color="#BFE3FF" stop-opacity="0.6" />
            <stop offset="1" stop-color="#6FC3FF" stop-opacity="0" />
          </radialGradient>
          <filter id="cg-glow" x="-10%" y="-10%" width="120%" height="120%">
            <feGaussianBlur stdDeviation="0.005" result="b" />
            <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
          </filter>
          <filter id="cg-grain" x="0" y="0" width="100%" height="100%">
            <feTurbulence type="fractalNoise" baseFrequency="200" numOctaves="2" stitchTiles="stitch" />
            <feColorMatrix type="saturate" values="0" />
            <feComponentTransfer><feFuncA type="table" tableValues="0 0.5" /></feComponentTransfer>
          </filter>
        </defs>
        <path d="M-2.5000 1.5625 L2.5000 1.5625 L1.1009 0.6881 L-1.1009 0.6881 Z" fill="url(#cg-ground)" />
        <ellipse cx="0.0000" cy="1.1364" rx="0.7" ry="0.34" fill="url(#cg-spot)" />
        <path d="M-0.7500 1.5000 L0.7500 1.5000 L0.3571 0.7143 L-0.3571 0.7143 Z" fill="#2F91D6" fill-opacity="0.07" />
