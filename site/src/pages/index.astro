---
import Base from '../layouts/Base.astro'
import { APP_URL, RANK_URL, BRAND, APP_SCHEMA } from '../consts'

// Teaser FAQ na stronie głównej — cytowalne odpowiedzi + FAQPage schema (rich results).
const HOME_FAQ = [
  {
    q: 'Czym jest HoopConnect?',
    a: 'HoopConnect to darmowa aplikacja do koszykówki ulicznej 3x3 i indywidualnego treningu. ' +
      'Znajdujesz grę i graczy w okolicy, grasz King of the Court, trenujesz i zbierasz XP w publicznych rankingach.',
  },
  {
    q: 'Ile kosztuje HoopConnect?',
    a: 'Dla graczy aplikacja jest darmowa. Płatny jest osobny panel dla trenerów i klubów.',
  },
  {
    q: 'Jak znaleźć grę w koszykówkę 3x3 w okolicy?',
    a: 'W zakładce Klub widzisz, kto gra lub planuje sesję na boiskach w pobliżu. Dołączasz do meczu albo ' +
      'tworzysz własny, a aplikacja losuje trzyosobowe drużyny.',
  },
  {
    q: 'Czy HoopConnect ma coś dla trenerów?',
    a: 'Tak. Panel dla trenerów pozwala prowadzić drużynę: dodawać zawodników, sprawdzać frekwencję na ' +
      'treningach i rozliczać składki.',
  },
]
const homeFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: HOME_FAQ.map((it) => ({
    '@type': 'Question',
    name: it.q,
    acceptedAnswer: { '@type': 'Answer', text: it.a },
  })),
}
---
<Base schema={[APP_SCHEMA, homeFaqSchema]}>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="tag live"><b></b>{BRAND.tagline}</span>
        <h1>Mniej klikania,<br /><span class="hl">więcej grania</span></h1>
        <p class="lead">
          Każde osiedlowe boisko dostaje ranking, a każda sobotnia gra zaczyna się liczyć.
          HoopConnect zamienia spontaniczną koszykówkę 3x3 w rozgrywkę z wynikiem, historią i królem boiska.
          Znajdujesz grę w okolicy, dołączasz jednym ruchem, a apka układa składy i zapisuje zwycięstwa.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary btn-lg" href={APP_URL} target="_blank" rel="noopener">Otwórz aplikację<span class="arw">→</span></a>
          <a class="btn btn-ghost btn-lg" href="/klub">Jak to działa</a>
        </div>
      </div>
      <div class="hero-art">
        <div class="hero-ball" aria-hidden="true">
          <canvas id="hoop-ball"></canvas>
        </div>
      </div>
    </div>
  </section>

  <!-- CO ROBI -->
  <section class="section ruled">
    <div class="wrap">
      <div class="head">
        <h2>Koszykówka 3x3,<br />poukładana</h2>
        <p class="lead">Wszystko, czego potrzeba do gry: zbieranie graczy, sesje, składy, wynik i postępy. Reszta dzieje się na boisku.</p>
      </div>
      <div class="grid grid-3">
        <article class="feat">
          <h3>Znajdź grę 3x3 w okolicy</h3>
          <p>Sprawdź, kto gra lub planuje sesję na boisku w okolicy. Utwórz mecz, a inni dołączą, bez pisania po grupach.</p>
        </article>
        <article class="feat">
          <h3>King of the Court</h3>
          <p>Tworzysz sesję, gracze dołączają w apce lub kodem QR, a aplikacja losuje trzyosobowe drużyny. Wygrane się liczą.</p>
        </article>
        <article class="feat">
          <h3>XP i ranking graczy</h3>
          <p>Za mecze i zwycięstwa zdobywasz XP i wbijasz się w rankingi. Widać, kto realnie wychodzi na boisko.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ASYSTENT TRENINGU -->
  <section class="section ruled">
    <div class="wrap split">
      <div class="split-copy">
        <h2>Asystent treningu</h2>
        <p class="lead">
          Poza pickupem HoopConnect prowadzi Cię przez indywidualny trening i progresję na kolejne areny.
          Wchodzisz na wyższe poziomy dzięki aktywności, a apka trzyma Twój rozwój w jednym miejscu.
        </p>
        <a class="btn btn-ghost" href="/asystent-treningu">Zobacz, jak działa<span class="arw">→</span></a>
      </div>
      <figure class="shot cut-tr ar-tall">
        <img src="/brand/club.png" width="1120" height="2000" alt="Aplikacja HoopConnect" loading="lazy" />
      </figure>
    </div>
  </section>

  <!-- RANKING -->
  <section class="section ruled">
    <div class="wrap split reverse">
      <div class="split-copy">
        <span class="tag live"><b></b>Ranking na żywo · beta</span>
        <h2 class="mt">Ranking, który nagradza aktywność</h2>
        <p class="lead">
          Publiczny ranking przeglądasz według XP, liczby meczów i wyników King of the Court,
          z filtrem po mieście. Bez logowania, prosto z przeglądarki.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href={RANK_URL} target="_blank" rel="noopener">Zobacz ranking<span class="arw">→</span></a>
          <a class="btn btn-ghost" href="/ranking">Jak liczymy</a>
        </div>
      </div>
      <figure class="shot cut-tr ar-wide">
        <img src="/brand/rank.png" width="1200" height="675" alt="Publiczny ranking HoopConnect" loading="lazy" />
      </figure>
    </div>
  </section>

  <!-- O NAS PISZĄ -->
  <section class="section ruled">
    <div class="wrap press">
      <blockquote>
        „HoopConnect powstał, aby uporządkować koszykówkę uliczną i pozwolić graczom skupić się na grze."
      </blockquote>
      <a class="press-src" href="https://3x3basket.pl" target="_blank" rel="noopener">3x3basket.pl<span class="arw"> →</span></a>
    </div>
  </section>

  <!-- FAQ TEASER -->
  <section class="section ruled">
    <div class="wrap">
      <div class="head">
        <h2>Częste pytania</h2>
        <p class="lead">Krótko o tym, jak działa HoopConnect. Więcej w pełnym <a class="inline-link" href="/faq">FAQ</a>.</p>
      </div>
      <div class="home-faq">
        {HOME_FAQ.map((it) => (
          <details class="hf-item">
            <summary><span class="q">{it.q}</span><span class="chev" aria-hidden="true"></span></summary>
            <p>{it.a}</p>
          </details>
        ))}
      </div>
      <a class="btn btn-ghost faq-more" href="/faq">Zobacz wszystkie pytania<span class="arw">→</span></a>
    </div>
  </section>

  <!-- CTA -->
  <section class="section ruled">
    <div class="wrap">
      <div class="final panel cut-tr">
        <div>
          <h2>Zagraj jeszcze<br />jeden mecz</h2>
          <p class="lead">Najlepsza statystyka nie brzmi „spędziłem godzinę w aplikacji". Brzmi „zagrałem jeszcze jeden mecz".</p>
        </div>
        <a class="btn btn-primary btn-lg" href={APP_URL} target="_blank" rel="noopener">Otwórz aplikację<span class="arw">→</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(48px, 8vw, 104px); }
  .hero-grid { display: grid; gap: clamp(36px, 5vw, 64px); align-items: center; }
  .hero-copy .tag { margin-bottom: 26px; }
  .hero h1 { margin-bottom: 26px; }
  .hl { color: var(--accent-hi); }
  .hero .lead { margin-bottom: 34px; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 14px; }
  @media (min-width: 940px) { .hero-grid { grid-template-columns: 1.05fr 0.95fr; } }

  .hero-art { display: flex; justify-content: center; }
  .hero-ball { position: relative; width: 100%; max-width: 460px; aspect-ratio: 1; }
  /* miękka poświata pod piłką, żeby ciemny model odbił się od ciemnego tła */
  .hero-ball::before { content: ''; position: absolute; inset: 8%; border-radius: 50%;
    background: radial-gradient(circle at 50% 42%, rgba(120,140,170,0.18), rgba(47,145,214,0.06) 45%, transparent 70%);
    filter: blur(14px); z-index: 0; }
  .hero-ball canvas { position: relative; z-index: 1; width: 100%; height: 100%; display: block; }
  @media (max-width: 939px) { .hero-ball { max-width: 320px; } }

  .head { max-width: 760px; margin-bottom: clamp(36px, 5vw, 60px); }
  .head .kicker { margin-bottom: 20px; }
  .head h2 { margin-bottom: 20px; }

  .split { display: grid; gap: clamp(36px, 5vw, 64px); align-items: center; }
  .split-copy .kicker, .split-copy .tag { margin-bottom: 20px; }
  .split-copy h2 { margin-bottom: 20px; }
  .split-copy h2.mt { margin-top: 0; }
  .split-copy .lead { margin-bottom: 28px; }
  @media (min-width: 940px) {
    .split { grid-template-columns: 1fr 1fr; }
    .split.reverse .split-copy { order: 2; }
  }

  .press { max-width: 900px; }
  .press blockquote { font-family: var(--display); font-weight: 700; text-transform: none; letter-spacing: -0.3px;
    font-size: clamp(24px, 3.6vw, 40px); line-height: 1.18; margin: 22px 0 20px; }
  .press-src { font-family: var(--display); font-weight: 700; text-transform: uppercase; letter-spacing: 1px;
    color: var(--accent-hi); font-size: 15px; }

  .final { display: grid; gap: 28px; align-items: center; padding: clamp(32px, 5vw, 60px); }
  .final h2 { margin-bottom: 16px; }
  @media (min-width: 820px) { .final { grid-template-columns: 1fr auto; gap: 48px; } }

  .inline-link { color: var(--accent-hi); text-decoration: underline; text-underline-offset: 3px; }
  .home-faq { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
  .hf-item { border-bottom: 1px solid var(--line); }
  .hf-item summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between;
    gap: 20px; padding: 18px 4px; }
  .hf-item summary::-webkit-details-marker { display: none; }
  .hf-item .q { font-family: var(--display); font-weight: 600; font-size: clamp(16px, 2vw, 19px);
    letter-spacing: -0.2px; color: var(--text); line-height: 1.3; }
  .hf-item[open] .q { color: var(--accent-hi); }
  .hf-item .chev { flex-shrink: 0; width: 11px; height: 11px; border-right: 2px solid var(--text-2);
    border-bottom: 2px solid var(--text-2); transform: rotate(45deg); transition: transform .2s ease; margin-top: -4px; }
  .hf-item[open] .chev { transform: rotate(-135deg); margin-top: 4px; border-color: var(--accent-hi); }
  .hf-item p { color: var(--text-2); font-size: 15.5px; line-height: 1.65; margin: 0 4px 20px; max-width: 68ch; }
  .faq-more { margin-top: 24px; }
</style>

<script>
  import * as THREE from 'three'

  const canvas = document.getElementById('hoop-ball') as HTMLCanvasElement | null
  if (canvas) {
    const wrap = canvas.parentElement as HTMLElement
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    // ── Tekstura piłki: ciemnoszara skóra z pebble + trzy wielkie koła (szwy) ──
    // Trzy okręgi wielkie = klasyczny wygląd piłki: 2 pionowe (przez bieguny) + równik.
    function makeTexture(kind: 'color' | 'bump') {
      const W = 1024, H = 512
      const c = document.createElement('canvas'); c.width = W; c.height = H
      const x = c.getContext('2d')!
      x.fillStyle = kind === 'color' ? '#3a3b3f' : '#808080'
      x.fillRect(0, 0, W, H)
      // pebble (drobne ziarno skóry)
      for (let i = 0; i < 24000; i++) {
        const px = Math.random() * W, py = Math.random() * H, r = Math.random() * 1.5 + 0.3
        const up = Math.random() > 0.5
        x.beginPath(); x.arc(px, py, r, 0, Math.PI * 2)
        if (kind === 'color') x.fillStyle = up ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.12)'
        else x.fillStyle = up ? 'rgba(255,255,255,0.5)' : 'rgba(0,0,0,0.5)'
        x.fill()
      }
      // szwy (rowki) — ciemne w color, wcięte (ciemne) w bump
      x.strokeStyle = kind === 'color' ? '#0c0c0d' : '#000000'
      x.lineCap = 'round'
      x.lineWidth = Math.round(H * 0.03)
      for (const u of [0, 0.25, 0.5, 0.75, 1]) {
        const px = u * W; x.beginPath(); x.moveTo(px, 0); x.lineTo(px, H); x.stroke()
      }
      x.beginPath(); x.moveTo(0, H / 2); x.lineTo(W, H / 2); x.stroke()
      const tex = new THREE.CanvasTexture(c)
      tex.anisotropy = 8
      return tex
    }

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true })
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2))

    const scene = new THREE.Scene()
    const camera = new THREE.PerspectiveCamera(34, 1, 0.1, 100)
    camera.position.set(0, 0, 3.25)

    const ball = new THREE.Mesh(
      new THREE.SphereGeometry(1, 96, 96),
      new THREE.MeshStandardMaterial({
        map: makeTexture('color'),
        bumpMap: makeTexture('bump'),
        bumpScale: 0.012,
        roughness: 0.82,
        metalness: 0.0,
      }),
    )
    const group = new THREE.Group()
    group.add(ball)
    group.rotation.x = 0.38
    group.rotation.z = 0.16
    scene.add(group)

    // Światło: miękkie wypełnienie + key z góry-prawej + chłodny rim od tyłu (odbicie od tła)
    scene.add(new THREE.HemisphereLight(0x9fb3cc, 0x0a0c10, 0.75))
    const key = new THREE.DirectionalLight(0xffffff, 1.35); key.position.set(4, 5, 5); scene.add(key)
    const rim = new THREE.DirectionalLight(0x5aa0e6, 0.6); rim.position.set(-5, -2, -4); scene.add(rim)

    function resize() {
      const s = Math.max(1, Math.min(wrap.clientWidth, wrap.clientHeight))
      renderer.setSize(s, s, false)
      camera.aspect = 1; camera.updateProjectionMatrix()
    }
    resize()
    new ResizeObserver(resize).observe(wrap)

    function frame() {
      group.rotation.y += 0.0042
      renderer.render(scene, camera)
      if (!reduce) requestAnimationFrame(frame)
    }
    frame()
  }
</script>
