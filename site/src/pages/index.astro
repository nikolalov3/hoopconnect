---
import Base from '../layouts/Base.astro'
import PlayerCard from '../components/PlayerCard.astro'
import { APP_URL, RANK_URL, COACH_OFFER_URL, BRAND, APP_SCHEMA } from '../consts'
import QRCode from 'qrcode'

// QR w sekcji końcowej — ktoś czyta na laptopie, gra z telefonu. Generowany w buildzie.
const qrSvg = await QRCode.toString(APP_URL, {
  type: 'svg', margin: 0, errorCorrectionLevel: 'M',
  color: { dark: '#0E0F12', light: '#FFFFFF' },
})

// Ticker pod hero — same fakty o produkcie, żadnych wymyślonych liczb.
const TICKER = [
  'King of the Court', 'Ranking XP na żywo', 'Siedem aren', 'Karta gracza', 'Asystent treningu',
  'Draft Score', 'Darmowa dla graczy', 'Kraków i cała Polska', 'Phone down, game up',
]

// Losowanie składów w kaflu KotC: 9 graczy, start w siatce 3x3, po „losowaniu" kolumna = drużyna.
// dx/dy = przesunięcie w komórkach siatki (ustawiane w CSS jako translate).
// Start (wiersz,kolumna) → cel: drużyna A = kolumna 0, B = 1, C = 2; każda komórka celu unikalna.
const DRAW = [
  { l: 'K', dx: 0, dy: 2, t: 'a' },  { l: 'M', dx: 0, dy: 2, t: 'b' },  { l: 'F', dx: 0, dy: 1, t: 'c' },
  { l: 'A', dx: 1, dy: -1, t: 'b' }, { l: 'B', dx: -1, dy: -1, t: 'a' }, { l: 'S', dx: 0, dy: -1, t: 'c' },
  { l: 'J', dx: 1, dy: -1, t: 'b' }, { l: 'O', dx: -1, dy: -1, t: 'a' }, { l: 'W', dx: 0, dy: 0, t: 'c' },
]

// Pięć kart gracza na boisku (hero). Pozycje w % kontenera boiska. Dane poglądowe, bez nazwisk.
// Elementy karty = te same, co w apce: hex z inicjałem, arena, pasek XP do następnej areny, wygrane.
// toNext liczone z progów aren (500/1500/2700/3900/5500/7500) dla p% postępu.
const CARDS = [
  { pos: 'Rozgrywający', name: 'Kuba',     l: 'K', arena: 4, arenaName: 'Ankh Court',   next: 'Void Gem',     p: 62, toNext: 608,  w: 12, k: 3, id: '20251', frame: 'default', x: 41.8, y: 22.3,
    desc: 'Prowadzi grę i rozdaje piłkę. Najwięcej sesji King of the Court w ekipie.' },
  { pos: 'Rzucający', name: 'Michał',        l: 'M', arena: 1, arenaName: 'Street Court', next: 'City Run',     p: 35, toNext: 650,  w: 4,  k: 0, id: '20318', frame: 'none',    x: 58.2, y: 22.3,
    desc: 'Dopiero zaczyna. Pierwsza arena odblokowana po czterech wygranych.' },
  { pos: 'Skrzydłowy', name: 'Bartek',       l: 'B', arena: 2, arenaName: 'City Run',     next: 'Golden Reign', p: 48, toNext: 624,  w: 7,  k: 1, id: '20277', frame: 'default', x: 25.5, y: 57.9,
    desc: 'Gra regularnie w sobotnich sesjach. Pierwszy tytuł króla boiska za nim.' },
  { pos: 'Silny skrzydłowy', name: 'Olek', l: 'O', arena: 3, arenaName: 'Golden Reign', next: 'Ankh Court',   p: 71, toNext: 348,  w: 9,  k: 2, id: '20194', frame: 'none',    x: 74.5, y: 57.9,
    desc: 'Walczy pod koszem. Blisko kolejnej areny, brakuje kilku meczów.' },
  { pos: 'Środkowy', name: 'Alex',         l: 'A', arena: 5, arenaName: 'Void Gem',     next: 'Seraphim',     p: 22, toNext: 1560, w: 15, k: 4, id: '20102', frame: 'default', live: true, x: 50.0, y: 85.2,
    desc: 'Najwyżej w ekipie. Cztery wygrane sesje KotC i najwięcej meczów na koncie.' },
]

// Areny z aplikacji (src/lib/arenas.js) — do karuzeli w kaflu „Siedem aren".
const ARENAS = [
  { n: 1, name: 'Street Court', xp: 500 }, { n: 2, name: 'City Run', xp: 1500 }, { n: 3, name: 'Golden Reign', xp: 2700 },
  { n: 4, name: 'Ankh Court', xp: 3900 }, { n: 5, name: 'Void Gem', xp: 5500 }, { n: 6, name: 'Seraphim', xp: 7500 },
]

// Teaser FAQ na stronie głównej — cytowalne odpowiedzi + FAQPage schema (rich results).
const HOME_FAQ = [
  {
    q: 'Czym jest HoopConnect?',
    a: 'HoopConnect to darmowa aplikacja do koszykówki ulicznej 3x3 i indywidualnego treningu. ' +
      'Znajdujesz grę i graczy w okolicy, grasz King of the Court, trenujesz i zbierasz XP w publicznych rankingach.',
  },
  {
    q: 'Ile kosztuje HoopConnect?',
    a: 'Dla graczy aplikacja jest darmowa. Płatny jest osobny panel dla trenerów i klubów.',
  },
  {
    q: 'Jak znaleźć grę w koszykówkę 3x3 w okolicy?',
    a: 'W zakładce Klub widzisz, kto gra lub planuje sesję na boiskach w pobliżu. Dołączasz do meczu albo ' +
      'tworzysz własny, a aplikacja losuje trzyosobowe drużyny.',
  },
  {
    q: 'Czy HoopConnect ma coś dla trenerów?',
    a: 'Tak. Panel dla trenerów pozwala prowadzić drużynę: dodawać zawodników, sprawdzać frekwencję na ' +
      'treningach i rozliczać składki.',
  },
]
const homeFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: HOME_FAQ.map((it) => ({
    '@type': 'Question',
    name: it.q,
    acceptedAnswer: { '@type': 'Answer', text: it.a },
  })),
}
---
<Base schema={[APP_SCHEMA, homeFaqSchema]}>
  <!-- ═══ HERO ═══ -->
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="wrap hero-copy">
      <span class="tag live"><b></b>{BRAND.tagline}</span>
      <h1>Zostań królem<br /><span class="hl">swojego boiska</span></h1>
      <p class="lead">
        Osiedlowy pickup 3x3 z wynikiem, rankingiem i historią. Znajdujesz grę, dołączasz jednym ruchem,
        wygrywasz i zgarniasz XP. Ekipa widzi, kto naprawdę gra.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary btn-lg" href={APP_URL} target="_blank" rel="noopener">Zagraj dziś<span class="arw">→</span></a>
        <a class="btn btn-ghost btn-lg" href={RANK_URL} target="_blank" rel="noopener">Zobacz ranking</a>
      </div>
      <ul class="hero-proof">
        <li>Darmowa dla graczy</li>
        <li>Bez instalacji, z przeglądarki</li>
        <li>Ranking bez logowania</li>
      </ul>
      <p class="stage-hint"><span aria-hidden="true"></span>Dotknij podświetlonej karty, żeby zobaczyć, jak działa karta gracza</p>
    </div>

    <!-- Boisko na całą szerokość: linia końcowa = dolna krawędź hero, zaraz pod nią pasek. Pięć kart stoi na pozycjach. -->
    <div class="court-stage" id="courtStage">
        <svg class="court-bg" viewBox="-0.7750 0.5000 1.5500 0.5964" aria-hidden="true" preserveAspectRatio="none">
          <!-- Boisko 3x3 (15×11 m, linie FIBA) w rzucie perspektywicznym; kamera za linią końcową (d=11 m, h=12 m).
               Wygenerowane: ta sama projekcja liczy pozycje kart (CARDS x/y), dół kadru = linia końcowa.
               Warstwy: podłoże, reflektor, nawierzchnia, strefa za 3, malowana trumna, poświata kosza, linie z glow,
               błysk sunący po liniach (pathLength=1 → jeden przebieg na linię na cykl), ziarno. -->
          <defs>
            <linearGradient id="cg-ground" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#0E1118" stop-opacity="0" />
              <stop offset="0.3" stop-color="#111A2B" stop-opacity="0.85" />
              <stop offset="1" stop-color="#16233D" />
            </linearGradient>
            <radialGradient id="cg-spot" cx="0.5" cy="0.5" r="0.5">
              <stop offset="0" stop-color="#6FC3FF" stop-opacity="0.28" />
              <stop offset="0.5" stop-color="#2F91D6" stop-opacity="0.10" />
              <stop offset="1" stop-color="#2F91D6" stop-opacity="0" />
            </radialGradient>
            <radialGradient id="cg-hoop" cx="0.5" cy="0.5" r="0.5">
              <stop offset="0" stop-color="#BFE3FF" stop-opacity="0.6" />
              <stop offset="1" stop-color="#6FC3FF" stop-opacity="0" />
            </radialGradient>
            <filter id="cg-glow" x="-10%" y="-10%" width="120%" height="120%">
              <feGaussianBlur stdDeviation="0.0045" result="b" />
              <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
            </filter>
            <filter id="cg-glint" x="-10%" y="-10%" width="120%" height="120%">
              <feGaussianBlur stdDeviation="0.006" result="b" />
              <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
            </filter>
            <filter id="cg-grain" x="0" y="0" width="100%" height="100%">
              <feTurbulence type="fractalNoise" baseFrequency="230" numOctaves="2" stitchTiles="stitch" />
              <feColorMatrix type="saturate" values="0" />
              <feComponentTransfer><feFuncA type="table" tableValues="0 0.5" /></feComponentTransfer>
            </filter>
          </defs>
          <path d="M-2.2642 1.1321 L2.2642 1.1321 L1.0526 0.5263 L-1.0526 0.5263 Z" fill="url(#cg-ground)" />
          <ellipse cx="0.0000" cy="0.8333" rx="0.62" ry="0.25" fill="url(#cg-spot)" />
          <path d="M-0.6818 1.0909 L0.6818 1.0909 L0.3409 0.5455 L-0.3409 0.5455 Z" fill="#2F91D6" fill-opacity="0.07" />
