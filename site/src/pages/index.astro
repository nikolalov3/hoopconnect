    font-size: clamp(64px, 9vw, 120px); line-height: 1; color: var(--accent); opacity: 0.55; display: none; }
  .press blockquote { font-family: var(--display); font-weight: 700; text-transform: none; letter-spacing: -0.3px;
    font-size: clamp(24px, 3.6vw, 40px); line-height: 1.18; margin: 22px 0 20px; }
  .press-src { font-family: var(--display); font-weight: 700; text-transform: uppercase; letter-spacing: 1px;
    color: var(--accent-hi); font-size: 15px; }
  @media (min-width: 760px) { .press-mark { display: block; } }

  /* ═══ FAQ ═══ */
  .faq-grid { display: grid; gap: clamp(28px, 4vw, 64px); align-items: start; }
