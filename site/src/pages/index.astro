          <rect x="-0.7750" y="0.5000" width="1.5500" height="0.5964" filter="url(#cg-grain)" opacity="0.05" style="mix-blend-mode: screen" />
        </svg>
        <ul class="cards" aria-label="Przykładowe karty graczy na pozycjach">
          {CARDS.map((c, i) => (
            <li class:list={[{ live: c.live }]} style={`--x:${c.x}%; --y:${c.y}%`}>
              {c.live ? (
                <button class="pcbtn" type="button" data-i={i} aria-label={`Karta gracza: ${c.name}, ${c.pos}. Pokaż podgląd`}>
                  <PlayerCard name={c.name} letter={c.l} arena={c.arena} arenaName={c.arenaName} nextArena={c.next}
                    pct={c.p} toNext={c.toNext} wins={c.w} kotc={c.k} hcId={c.id} frame={c.frame as 'default' | 'none'} uid={`h${i}`} />
                </button>
              ) : (
                <div class="pcbtn static" aria-hidden="true">
                  <PlayerCard name={c.name} letter={c.l} arena={c.arena} arenaName={c.arenaName} nextArena={c.next}
                    pct={c.p} toNext={c.toNext} wins={c.w} kotc={c.k} hcId={c.id} frame={c.frame as 'default' | 'none'} uid={`h${i}`} />
                </div>
              )}
            </li>
          ))}
        </ul>
    </div>
  </section>

  <!-- Podgląd karty (modal). Treść wstawia skrypt z CARDS_JSON. -->
  <div class="cm" id="cardModal" hidden>
    <div class="cm-backdrop" data-cm-close></div>
    <div class="cm-card cutbox" role="dialog" aria-modal="true" aria-labelledby="cmTitle">
      <button class="cm-x" data-cm-close aria-label="Zamknij">×</button>
      <div class="cm-big" id="cmBig"></div>
      <div class="cm-tx">
        <span class="kicker on" id="cmKicker">Karta gracza</span>
        <h2 id="cmTitle">Kuba</h2>
        <p class="cm-desc" id="cmDesc"></p>
        <ul class="cm-legend">
          <li><b>Hex z inicjałem</b> to Twój awatar. Obramowanie zmienia się z areną.</li>
          <li><b>Arena</b> pokazuje poziom. Pasek pod nią to XP do następnej.</li>
          <li><b>Mecze i KotC</b> liczą tylko to, co realnie zagrałeś.</li>
        </ul>
        <a class="btn btn-primary" href={APP_URL} target="_blank" rel="noopener">Stwórz swoją kartę<span class="arw">→</span></a>
      </div>
    </div>
  </div>
  <script type="application/json" id="cardsData" set:html={JSON.stringify(CARDS.map((c) => ({ name: c.name, pos: c.pos, desc: c.desc })))} />

  <!-- ═══ TICKER ═══ -->
  <div class="marquee under-court" aria-hidden="true">
    <div class="marquee-track">
      {TICKER.map((t) => <span>{t}</span>)}
      {TICKER.map((t) => <span>{t}</span>)}
    </div>
  </div>

  <!-- ═══ BENTO: produkt ═══ -->
  <section class="section">
    <div class="wrap">
      <div class="head rv">
        <span class="kicker on">Jak to działa</span>
        <h2>Każda wygrana<br />zostaje z Tobą</h2>
        <p class="lead">Od pierwszego „kto gra?" do zapisanego wyniku. Jedna apka zamiast grupy na Messengerze.</p>
      </div>

      <div class="bento">
        <article class="tile cutbox clip t-session rv">
          <div class="tile-tx">
            <h3>Zawsze jest z kim zagrać</h3>
            <p>Widzisz, kto gra na boiskach obok i o której. Dołączasz jednym ruchem albo zakładasz mecz i patrzysz, jak skład się zapełnia.</p>
          </div>
          <img class="tile-art art-session" src="/brand/session.webp" width="900" height="1607" alt="Zakładka Klub: spotkania w pobliżu" loading="lazy" />
        </article>

        <article class="tile cutbox clip t-kotc rv rv-d1">
          <div class="tile-tx">
            <h3>Składy losuje apka. Ty grasz.</h3>
            <p>Dziewięciu graczy, trzy trójki, jeden król boiska. Nikt nie wybiera kumpli, każdy ma równe szanse.</p>
          </div>
          <div class="draw" aria-hidden="true">
            <div class="draw-labels"><span class="ta">A</span><span class="tb">B</span><span class="tc">C</span></div>
            <div class="draw-grid">
              {DRAW.map((p) => (
                <span class={`hx t-${p.t}`} style={`--dx:${p.dx}; --dy:${p.dy}`}><i>{p.l}</i></span>
              ))}
            </div>
          </div>
        </article>

        <article class="tile cutbox clip t-rank rv rv-d2">
          <div class="tile-tx">
            <h3>Ranking, który widzą wszyscy</h3>
            <p>XP, mecze i King of the Court z filtrem po mieście. Link podsyłasz ekipie.</p>
          </div>
          <img class="tile-art art-rank" src="/brand/rank-mobile.webp" width="780" height="1688" alt="Ranking HoopConnect" loading="lazy" />
        </article>

        <article class="tile cutbox clip t-arenas rv rv-d3">
          <div class="tile-tx">
            <h3>Siedem aren do zdobycia</h3>
            <p>Każda wygrana przybliża Cię do następnej. Zdobyte XP zostaje na zawsze.</p>
          </div>
          <!-- Karuzela aren: przesuwa się sama, pauza na hover -->
          <div class="arenas" aria-hidden="true">
            <div class="arenas-track">
              {[...ARENAS, ...ARENAS].map((a) => (
                <figure>
                  <img src={`/arenas/arena-${a.n}.png`} width="72" height="72" alt="" loading="lazy" />
                  <figcaption><b>{a.name}</b><span>{a.xp} XP</span></figcaption>
                </figure>
              ))}
            </div>
          </div>
        </article>

        <article class="tile cutbox clip t-train rv">
          <div class="ring" aria-hidden="true">
            <svg viewBox="0 0 120 120">
              <circle class="ring-bg" cx="60" cy="60" r="52" />
              <circle class="ring-fg" cx="60" cy="60" r="52" />
            </svg>
            <div class="ring-tx"><b>270</b><span>Draft Score</span></div>
          </div>
          <div class="tile-tx">
            <h3>Nie ma meczu? Jest plan.</h3>
            <p>Codzienne ćwiczenia pod Twoje dni treningowe, regeneracja w wolne. Forma tygodnia zamienia się w XP, a Ty wracasz na boisko mocniejszy.</p>
            <ul class="checks">
              <li>Zestaw na każdy dzień układa się sam</li>
              <li>Dni odpoczynku z regeneracją</li>
              <li>Draft Score: 10% trafia do stałego XP</li>
            </ul>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ═══ KING OF THE COURT ═══ -->
  <section class="section ruled">
    <div class="wrap split">
      <div class="split-copy rv">
        <span class="kicker on">King of the Court</span>
        <h2>Jedna sesja.<br />Jeden król.</h2>
        <p class="lead">
          Ktoś zakłada sesję, reszta dołącza w apce albo kodem QR. Apka losuje trójki, liczy wygrane
          i na koniec wskazuje króla boiska. Bez dyskusji, kto wygrał.
        </p>
        <ul class="checks">
          <li>Trójki losowane automatycznie, bez wybierania kumpli</li>
          <li>Gracie do progu punktów albo zwycięstw, Wy ustalacie</li>
          <li>Wynik zapisany i XP naliczone, zanim zejdziecie z boiska</li>
        </ul>
        <a class="btn btn-ghost" href="/klub">Jak działa Klub<span class="arw">→</span></a>
      </div>
      <div class="rv rv-d1 tilt-wrap">
        <div class="cutbox clip matchcard tilt" data-tilt>
          <img src="/brand/match.webp" width="1600" height="1224" alt="Zakończony mecz 3x3 w HoopConnect: 21 do 16" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ RANKING ═══ -->
  <section class="section ruled">
    <div class="wrap">
      <div class="head rv">
        <span class="tag live"><b></b>Ranking na żywo · beta</span>
        <h2 class="mt">Widać, kto naprawdę gra</h2>
        <p class="lead">
          Nie kto najwięcej klika. Kto wychodzi na boisko. Trzy tablice: XP, mecze i King of the Court,
          filtr po mieście, bez logowania. Podeślij link ekipie i sprawdź, kto jest wyżej.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href={RANK_URL} target="_blank" rel="noopener">Otwórz ranking<span class="arw">→</span></a>
          <a class="btn btn-ghost" href="/ranking">Za co jest XP</a>
        </div>
      </div>
      <div class="browser cutbox clip rv rv-d1">
        <div class="browser-bar"><span class="url">app.hoopconnect.pl/rank</span></div>
        <img src="/brand/rank-desktop.webp" width="1600" height="1000" alt="Publiczny ranking HoopConnect w przeglądarce" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ═══ DLA TRENERÓW ═══ -->
  <section class="section ruled">
    <div class="wrap">
      <div class="coach cutbox rv">
        <div class="coach-head">
          <span class="kicker on">Dla trenerów i klubów</span>
          <h2>Prowadzisz drużynę?<br />Masz osobny panel.</h2>
          <a class="btn btn-primary" href={COACH_OFFER_URL} target="_blank" rel="noopener">Zobacz ofertę<span class="arw">→</span></a>
        </div>
        <div class="coach-facts">
          <div>
            <h3>Frekwencja</h3>
            <p>Odhaczasz obecność na treningu w kilka sekund. Także zawodników, którzy nie mają konta.</p>
          </div>
          <div>
            <h3>Składki</h3>
            <p>Widzisz, kto zapłacił, a kto zalega. Statystyki na miesiąc, bez arkusza w Excelu.</p>
          </div>
          <div>
            <h3>Zawodnicy</h3>
            <p>Profil, historia treningów i wzór zgody rodzica do druku. RODO ogarnięte.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ MANIFEST ═══ -->
  <section class="section ruled">
    <div class="wrap manifest rv">
      <p>Najlepsza statystyka nie brzmi <em>„spędziłem godzinę w aplikacji"</em>.</p>
      <p>Brzmi <strong>„zagrałem jeszcze jeden mecz"</strong>.</p>
    </div>
  </section>

  <!-- ═══ O NAS PISZĄ ═══ -->
  <section class="section ruled">
    <div class="wrap press rv">
      <span class="press-mark" aria-hidden="true">„</span>
      <blockquote>
        HoopConnect powstał, aby uporządkować koszykówkę uliczną i pozwolić graczom skupić się na grze."
      </blockquote>
      <a class="press-src" href="https://3x3basket.pl" target="_blank" rel="noopener">3x3basket.pl<span class="arw"> →</span></a>
    </div>
  </section>

  <!-- ═══ FAQ ═══ -->
  <section class="section ruled">
    <div class="wrap faq-grid">
      <div class="head rv">
        <span class="kicker on">FAQ</span>
        <h2>Częste pytania</h2>
        <p class="lead">Krótko o tym, jak działa HoopConnect. Więcej w pełnym <a class="inline-link" href="/faq">FAQ</a>.</p>
        <a class="btn btn-ghost faq-more" href="/faq">Wszystkie pytania<span class="arw">→</span></a>
      </div>
      <div class="home-faq rv rv-d1">
        {HOME_FAQ.map((it) => (
          <details class="hf-item">
            <summary><span class="q">{it.q}</span><span class="chev" aria-hidden="true"></span></summary>
            <p>{it.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="section ruled">
    <div class="wrap">
      <div class="final cutbox rv">
        <div class="final-copy">
          <h2>Następny mecz<br />jest Twój</h2>
          <p class="lead">Apka działa w przeglądarce telefonu. Bez sklepu, bez instalacji. Zeskanuj, załóż kartę gracza i wyjdź na boisko.</p>
          <div class="cta-row">
            <a class="btn btn-primary btn-lg" href={APP_URL} target="_blank" rel="noopener">Załóż kartę gracza<span class="arw">→</span></a>
          </div>
        </div>
        <div class="final-qr" aria-hidden="true">
          <div class="qr-img" set:html={qrSvg} />
          <span>app.hoopconnect.pl</span>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ═══ HERO: tekst, pod nim boisko na całą szerokość, pasek tuż pod linią końcową ═══ */
  .hero { position: relative; overflow: hidden; padding-block: clamp(40px, 6vw, 80px) 0; }
  .hero-glow { position: absolute; inset: auto -10% -10% -10%; height: 70%; pointer-events: none; z-index: 0;
    background: radial-gradient(ellipse 50% 70% at 50% 100%, rgba(47,145,214,0.16), transparent 70%); }
  .hero-copy { position: relative; z-index: 2; max-width: 760px; animation: rise .7s cubic-bezier(.2,.7,.2,1) both; }
  .hero-copy .tag { margin-bottom: 28px; }
  .hero h1 { margin-bottom: 26px; }
  .hl { color: var(--accent-hi); }
  .hero .lead { margin-bottom: 34px; max-width: 54ch; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 14px; }
  .hero-proof { list-style: none; padding: 0; margin-top: 32px; display: flex; flex-wrap: wrap; gap: 10px 26px;
    font-size: 13px; font-weight: 600; letter-spacing: 0.3px; color: var(--text-2); }
  .hero-proof li { display: inline-flex; align-items: center; gap: 9px; }
  .hero-proof li::before { content: ''; width: 6px; height: 6px; background: var(--accent); transform: rotate(45deg); }
  .stage-hint { margin-top: 26px; display: inline-flex; align-items: center; gap: 10px; font-family: var(--display); font-weight: 700;
    font-size: 11px; letter-spacing: 1.8px; text-transform: uppercase; color: var(--text-3); }
  .stage-hint span { width: 7px; height: 7px; background: var(--accent); transform: rotate(45deg); animation: pulse 2.4s ease-in-out infinite; }
  @keyframes pulse { 0%, 100% { box-shadow: 0 0 0 3px rgba(47,145,214,0.18); } 50% { box-shadow: 0 0 0 8px rgba(47,145,214,0.06); } }
  @keyframes rise { from { opacity: 0; transform: translateY(16px); } }

  /* ── Scena: proporcje = viewBox boiska (1.5500 : 0.5964), więc % pozycji z projekcji trafiają w punkty boiska.
     Dół sceny = linia końcowa. Karta stoi stopą w punkcie (translate -50%, -100%). ── */
  .court-stage { position: relative; z-index: 1; width: 100%; max-width: 1320px; aspect-ratio: 1.5500 / 0.5964;
    margin: clamp(28px, 4vw, 44px) auto 0; animation: rise .8s .12s cubic-bezier(.2,.7,.2,1) both; touch-action: pan-y; }
  .court-bg { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none;
    -webkit-mask-image: linear-gradient(transparent 0%, #000 16%, #000 100%);
    mask-image: linear-gradient(transparent 0%, #000 16%, #000 100%); }
  /* Reflektor z góry + winieta po bokach (pod kartami) */
  .court-stage::before { content: ''; position: absolute; inset: 0 -5% 0; pointer-events: none;
    background:
      radial-gradient(ellipse 40% 70% at 50% 0%, rgba(111,195,255,0.12), transparent 70%),
      linear-gradient(90deg, rgba(14,15,18,0.75), transparent 9%, transparent 91%, rgba(14,15,18,0.75)); }
  /* Błysk sunący po liniach: krótka jasna kreska (5% długości) przebiega każdą linię raz na cykl, fazy przesunięte */
  .court-bg :global(.glint path) { stroke-dasharray: 0.05 1; stroke-dashoffset: 1.05; stroke-opacity: 0.85;
    animation: glint 7s linear infinite; }
  .court-bg :global(.glint path:nth-child(2)) { animation-delay: -1.2s; }
  .court-bg :global(.glint path:nth-child(3)) { animation-delay: -2.1s; }
  .court-bg :global(.glint path:nth-child(4)) { animation-delay: -3.4s; }
  .court-bg :global(.glint path:nth-child(5)) { animation-delay: -4.6s; }
  .court-bg :global(.glint path:nth-child(6)) { animation-delay: -5.3s; }
  .court-bg :global(.glint path:nth-child(7)) { animation-delay: -6.1s; }
  @keyframes glint { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .court-bg :global(.glint) { display: none; } }
  /* Bez preserve-3d (karta ma clip-path; zagnieżdżone 3D psuje przycinanie na WebKit — patrz PlayerCard3D w apce) */
  .cards { list-style: none; padding: 0; position: absolute; inset: 0; }
  .cards li { position: absolute; left: var(--x); top: var(--y); z-index: var(--z, 1); transform: translate(-50%, -100%); }
  .cards li::after { content: ''; position: absolute; left: 50%; bottom: -3%; width: 150%; height: 14%;
    transform: translateX(-50%); background: radial-gradient(ellipse, rgba(0,0,0,0.6), rgba(0,0,0,0.25) 40%, transparent 68%); z-index: -1; }

  /* Skala bazowa per pozycja (lekkie karty, środkowy najbliżej) i kolejność */
  .cards li:nth-child(1) { --pcsb: 0.19; --z: 1; }
  .cards li:nth-child(2) { --pcsb: 0.19; --z: 1; }
  .cards li:nth-child(3) { --pcsb: 0.29; --z: 2; }
  .cards li:nth-child(4) { --pcsb: 0.29; --z: 2; }
  .cards li:nth-child(5) { --pcsb: 0.46; --z: 4; }
  /* Karta interaktywna (Alex): poświata pod stopą, reszta statyczna */
  .cards li.live::after { width: 190%; height: 22%; bottom: -8%;
    background: radial-gradient(ellipse, rgba(111,195,255,0.5), rgba(47,145,214,0.18) 42%, transparent 70%);
    animation: livepulse 2.6s ease-in-out infinite; }
  @keyframes livepulse { 0%, 100% { opacity: 0.75; transform: translateX(-50%) scale(1); } 50% { opacity: 1; transform: translateX(-50%) scale(1.12); } }
  .pcbtn.static { cursor: default; }
  /* :global, bo .pc3d-wrap renderuje komponent (nie ma atrybutu scope tej strony) */
  .cards :global(.pc3d-wrap) { --pcs: var(--pcsb); }
  /* Tilt bierze się z --rx0/--ry0 ustawianych skryptem na przycisku (bliskość kursora / przeciąganie) */
  .pcbtn { --rx0: -6; --ry0: 0; display: block; background: transparent; border: none; padding: 0; cursor: pointer; touch-action: none; }
  .pcbtn :global(.pc3d-card) { transition: none; }
  .pcbtn:focus-visible { outline: 2px solid var(--accent-hi); outline-offset: 4px; }
  .cards li:nth-child(1) .pcbtn { --ry0: 10; }  .cards li:nth-child(2) .pcbtn { --ry0: -10; }
  .cards li:nth-child(3) .pcbtn { --ry0: 18; }  .cards li:nth-child(4) .pcbtn { --ry0: -18; }
  .cards li:nth-child(5) .pcbtn { --ry0: 0; }
  .cards li:has(.pcbtn:hover), .cards li:has(.pcbtn:focus-visible) { z-index: 5; }

  /* Podgląd karty: panel wysuwany od dołu (tap na kartę), duża karta + opis */
  .cm { position: fixed; inset: 0; z-index: 300; display: flex; align-items: flex-end; justify-content: center; }
  .cm[hidden] { display: none; }
  .cm-backdrop { position: absolute; inset: 0; background: rgba(6,8,12,0.66); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
  .cm-card { --cut: 24px; --fill: var(--panel); --bd: var(--accent); position: relative; z-index: 1; width: 100%; max-width: 820px;
    padding: clamp(22px, 4vw, 40px) clamp(20px, 4vw, 44px) calc(clamp(22px, 4vw, 36px) + env(safe-area-inset-bottom));
    display: grid; gap: clamp(20px, 4vw, 44px); align-items: center;
    animation: cm-up .3s cubic-bezier(.2,.8,.3,1) both; max-height: calc(100vh - 24px); overflow: auto; }
  .cm-card::before, .cm-card::after { clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, 0 100%); }
  @keyframes cm-up { from { opacity: 0; transform: translateY(40px); } }
  .cm-x { position: absolute; top: 10px; right: 14px; z-index: 2; background: transparent; border: none; color: var(--text-3);
    font-size: 26px; line-height: 1; cursor: pointer; padding: 4px; }
  .cm-x:hover { color: var(--text); }
