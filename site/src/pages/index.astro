---
import Base from '../layouts/Base.astro'
import HeroCourt from '../components/HeroCourt.astro'
import PlayerCard from '../components/PlayerCard.astro'
import MatchCard from '../components/MatchCard.astro'
import RankBoard from '../components/RankBoard.astro'
import DraftRing from '../components/DraftRing.astro'
import NewsletterPop from '../components/NewsletterPop.astro'
import court from '../data/court.json'
import { APP_URL, RANK_URL, COACH_OFFER_URL, APP_SCHEMA, NEWSLETTER } from '../consts'
import QRCode from 'qrcode'

// QR w zamknięciu: ktoś czyta na laptopie, gra z telefonu. Generowany w buildzie.
const qrSvg = await QRCode.toString(APP_URL, {
  type: 'svg', margin: 0, errorCorrectionLevel: 'M',
  color: { dark: '#0E0F12', light: '#FFFFFF' },
})

// Pasek pod linią końcową boiska: same fakty o produkcie, żadnych wymyślonych liczb.
const TICKER = [
  'King of the Court', 'Ranking XP na żywo', 'Siedem aren', 'Karta gracza', 'Asystent treningu',
  'Draft Score', 'Darmowa dla graczy', 'Kraków i cała Polska', 'Phone down, game up.',
]

// Pięć kart gracza na boisku (hero). Pozycje w % sceny liczy scripts/gen-court.py (src/data/court.json),
// tą samą projekcją co linie boiska, osobno dla desktopu i telefonu. Dane poglądowe, bez nazwisk.
// toNext wynika z progów aren (500 / 1500 / 2700 / 3900 / 5500 / 7500 XP) dla p% postępu.
type Spot = keyof typeof court.desk.spots
const CARDS: {
  spot: Spot; pos: string; name: string; l: string; arena: number; arenaName: string; next: string
  p: number; toNext: number; w: number; k: number; id: string; frame: 'default' | 'none'; live?: boolean
}[] = [
  { spot: 'pg', pos: 'Rozgrywający', name: 'Kuba', l: 'K', arena: 4, arenaName: 'Ankh Court', next: 'Void Gem', p: 62, toNext: 608, w: 12, k: 3, id: '20251', frame: 'default' },
  { spot: 'sg', pos: 'Rzucający', name: 'Michał', l: 'M', arena: 1, arenaName: 'Street Court', next: 'City Run', p: 35, toNext: 650, w: 4, k: 0, id: '20318', frame: 'none' },
  { spot: 'sf', pos: 'Skrzydłowy', name: 'Bartek', l: 'B', arena: 2, arenaName: 'City Run', next: 'Golden Reign', p: 48, toNext: 624, w: 7, k: 1, id: '20277', frame: 'default' },
  { spot: 'pf', pos: 'Silny skrzydłowy', name: 'Olek', l: 'O', arena: 3, arenaName: 'Golden Reign', next: 'Ankh Court', p: 71, toNext: 348, w: 9, k: 2, id: '20194', frame: 'none' },
  { spot: 'c', pos: 'Środkowy', name: 'Alex', l: 'A', arena: 5, arenaName: 'Void Gem', next: 'Seraphim', p: 22, toNext: 1560, w: 15, k: 4, id: '20102', frame: 'default', live: true },
]

// Karty meczu to komponent przeniesiony z apki (MatchCard.astro, port z ClubPage.jsx), nie obrazki.
// Rozdział 2: zakończony mecz 21:16. Rozdział 3 (telefon): otwarty mecz, w którym zajmujesz wolne miejsce.
const MATCH_HOME = { name: 'HoopConnect', mine: true, players: [{ l: 'K', f: true }, { l: 'M' }, { l: 'F', f: true }] }
const MATCH_AWAY = { name: 'Street Kings', players: [{ l: 'A' }, { l: 'B', f: true }, { l: 'S' }] }
const CLUB_HOME = { name: 'HoopConnect', players: [{ l: 'K', f: true }, { l: 'M' }, { l: 'F', f: true }] }
const CLUB_AWAY = { name: 'Rywale', players: [{ l: 'A' }, null, null] }

// Rozdział „Znajdź grę obok": trzy kroki tekstu; aktywny krok zmienia stan karty meczu (klasa na scenie).
const CLUB_STEPS = [
  { t: 'Widzisz, kto gra obok', d: 'Mecze z godziną, miejscem i składem. Od razu wiesz, ile to kilometrów i ile miejsc zostało.' },
  { t: 'Dołączasz jednym ruchem', d: 'Twój hex wskakuje do składu. Ekipa widzi, że wchodzisz, bez pisania na grupie.' },
  { t: 'Skład się zapełnia', d: 'Sześć miejsc, sześć hexów. Jest mecz. Nie ma gry w okolicy? Zakładasz własną i czekasz na skład.' },
]

// Losowanie w King of the Court: dziewięciu graczy solo, trzy trójki w kolorach z apki
// (src/features/kotc/KotcSolo.jsx: Blue / Green / Red). Przebieg losowania robi skrypt na dole.
const DRAW_PLAYERS = ['K', 'M', 'F', 'A', 'B', 'S', 'J', 'O', 'W']
const DRAW_TEAMS = [
  { name: 'Blue', color: '#3B82F6' }, { name: 'Green', color: '#22C55E' }, { name: 'Red', color: '#F43F5E' },
]
// Zasady z apki: „Pickup 3v3 · wchodzisz solo · wygrany zostaje", min. 9 graczy, wynik potwierdza czekająca drużyna.
const KOTC_FACTS = [
  { t: 'Wchodzisz solo', d: 'Kodem sesji albo jednym tapnięciem z listy aktywnych sesji.' },
  { t: 'Trójki z losowania', d: 'Od dziewięciu graczy apka dzieli Was na drużyny. Nikt nie wybiera kumpli.' },
  { t: 'Wygrany zostaje', d: 'Przegrani schodzą, wchodzi następna trójka. Wynik potwierdza drużyna, która czeka.' },
]

// Rozdział „Karta gracza": cztery kroki, każdy podświetla jeden element karty.
const CARD_STEPS = [
  { t: 'Hex z inicjałem', d: 'Twój znak w składzie, w rankingu i na karcie. Z ramką, jeśli ją zdobyłeś.' },
  { t: 'Arena', d: 'Siedem poziomów, od Rozgrzewki po Seraphim. Nazwa na karcie mówi, jak daleko zaszedłeś.' },
  { t: 'Pasek XP', d: 'Ile brakuje do następnej areny. Każdy mecz przesuwa go w prawo. Nigdy w lewo.' },
  { t: 'Wygrane mecze i KotC', d: 'Dwie liczby, których nie da się wyklikać. Tylko to, co zagrałeś.' },
]

// Siedem aren z apki (src/lib/arenas.js): Rozgrzewka bez ramki, potem sześć z grafiką.
const ARENAS = [
  { n: 0, name: 'Rozgrzewka', xp: 0 },
  { n: 1, name: 'Street Court', xp: 500 }, { n: 2, name: 'City Run', xp: 1500 }, { n: 3, name: 'Golden Reign', xp: 2700 },
  { n: 4, name: 'Ankh Court', xp: 3900 }, { n: 5, name: 'Void Gem', xp: 5500 }, { n: 6, name: 'Seraphim', xp: 7500 },
]

const TRAIN_FACTS = [
  { t: 'Plan pod Ciebie', d: 'Gotowy zestaw na każdy dzień treningowy. Liczbę dni zmieniasz, kiedy chcesz.' },
  { t: 'Regeneracja', d: 'W dni odpoczynku dostajesz podpowiedzi: rozciąganie, mobilność, sen.' },
  { t: 'Draft Score', d: 'Forma tygodnia, tylko dla Ciebie. Na koniec tygodnia 10% zamienia się w stałe XP.' },
]

const COACH_FACTS = [
  { t: 'Frekwencja', d: 'Obecność na treningu odhaczasz w kilka sekund. Także zawodników bez konta.' },
  { t: 'Składki', d: 'Widzisz, kto zapłacił, a kto zalega. Miesiąc po miesiącu.' },
  { t: 'Zgody rodziców', d: 'Gotowy wzór do druku i podpisu.' },
]

// Teaser FAQ na stronie głównej: cytowalne odpowiedzi + FAQPage schema (rich results).
const HOME_FAQ = [
  {
    q: 'Czym jest HoopConnect?',
    a: 'HoopConnect to darmowa aplikacja do koszykówki ulicznej (streetbasketu) i indywidualnego treningu. ' +
      'Znajdujesz grę i graczy w okolicy, grasz King of the Court, trenujesz i zbierasz XP w publicznych rankingach.',
  },
  {
    q: 'Ile kosztuje HoopConnect?',
    a: 'Dla graczy aplikacja jest darmowa. Płatny jest osobny panel dla trenerów i klubów.',
  },
  {
    q: 'Jak znaleźć grę w koszykówkę uliczną w okolicy?',
    a: 'W zakładce Klub widzisz mecze 2v2, 3v3 i 5v5 na boiskach w pobliżu. Dołączasz ze swoim klubem albo zakładasz własny mecz. ' +
      'Do sesji King of the Court wchodzisz solo, a aplikacja losuje trzyosobowe drużyny.',
  },
  {
    q: 'Czy HoopConnect ma coś dla trenerów?',
    a: 'Tak. Panel dla trenerów pozwala prowadzić drużynę: dodawać zawodników, sprawdzać frekwencję na ' +
      'treningach i rozliczać składki.',
  },
]
const homeFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: HOME_FAQ.map((it) => ({
    '@type': 'Question',
    name: it.q,
    acceptedAnswer: { '@type': 'Answer', text: it.a },
  })),
}
---
<Base schema={[APP_SCHEMA, homeFaqSchema]}>
  <!-- ═══ 1. OTWARCIE: nagłówek nad boiskiem, boisko na środku, pasek pod linią końcową, reszta pod spodem ═══ -->
  <section class="hero">
    <div class="wrap hero-head">
      <h1>
        <span class="ln"><span class="w">Boisko zna</span></span>
        <span class="ln"><span class="hl">Twoje imię</span></span>
      </h1>
    </div>

    <div class="court-wrap" data-loop style={`--cw:${court.desk.courtWidth}%`}>
      <div class="court-stage" id="courtStage" style={`--ar-desk:${court.desk.ar}; --ar-mob:${court.mob.ar}`}>
        <HeroCourt />
        <ul class="cards" aria-label="Przykładowe karty graczy na boisku">
          {CARDS.map((c, i) => {
            const d = court.desk.spots[c.spot]
            const m = court.mob.spots[c.spot]
            return (
              <li class:list={[{ live: c.live }]} style={`--x:${d[0]}%; --y:${d[1]}%; --mx:${m[0]}%; --my:${m[1]}%`}>
                {c.live ? (
                  <button class="pcbtn" type="button" data-i={i} aria-pressed="false" aria-label={`Karta gracza: ${c.name}. Naciśnij, żeby ją podnieść i obrócić`}>
                    <PlayerCard name={c.name} letter={c.l} arena={c.arena} arenaName={c.arenaName} nextArena={c.next}
                      pct={c.p} toNext={c.toNext} wins={c.w} kotc={c.k} hcId={c.id} frame={c.frame} uid={`h${i}`} />
                  </button>
                ) : (
                  <div class="pcbtn static" aria-hidden="true">
                    <PlayerCard name={c.name} letter={c.l} arena={c.arena} arenaName={c.arenaName} nextArena={c.next}
                      pct={c.p} toNext={c.toNext} wins={c.w} kotc={c.k} hcId={c.id} frame={c.frame} uid={`h${i}`} />
                  </div>
                )}
              </li>
            )
          })}
        </ul>
        <!-- Tryb podglądu karty Alexa: reszta sceny ciemnieje, pod kartą pojawia się podpis z wyjściem -->
        <div class="stage-dim" aria-hidden="true"></div>
        <p class="focus-cap"><span>Przeciągnij, żeby obrócić kartę</span><button class="focus-x" type="button" tabindex="-1">Odłóż</button></p>
      </div>
      <div class="marquee under-court" aria-hidden="true">
        <div class="marquee-track">
          {TICKER.map((t) => <span>{t}</span>)}
          {TICKER.map((t) => <span>{t}</span>)}
        </div>
      </div>
    </div>

    <div class="wrap hero-copy">
      <p class="lead">HoopConnect to aplikacja do koszykówki ulicznej. Widzisz, kto gra obok, dołączasz jednym ruchem, a wynik, XP i wygrane zostają na Twojej karcie gracza.</p>
      <div class="cta-row">
        <a class="btn btn-primary btn-lg" href={APP_URL} target="_blank" rel="noopener">Zagraj dziś<span class="arw">→</span></a>
      </div>
      <ul class="hero-proof">
        <li>Darmowa dla graczy</li>
        <li>Bez instalacji, z przeglądarki</li>
        <li>Ranking bez logowania</li>
      </ul>
      <p class="stage-hint" data-loop><span aria-hidden="true"></span>Dotknij podświetlonej karty i obróć ją.</p>
    </div>
  </section>

  <!-- ═══ 2. KAŻDY MECZ SIĘ LICZY: karta meczu z apki „rozgrywa się" przy wejściu na ekran ═══ -->
  <section class="ch ch-center" id="mecz">
    <div class="wrap">
      <div class="ch-head rv rv-seq">
        <h2><span class="ln"><span>Każdy mecz</span></span> <span class="ln"><span>się liczy</span></span></h2>
        <p class="lead">Po meczu wpisujecie wynik, a kapitan rywali go potwierdza. XP wpada na konto, wygrana zostaje na Twojej karcie. Na stałe.</p>
      </div>
      <figure class="matchcard rv">
        <MatchCard uid="m2" live status="completed" playing={true} dist="2,0 km" home={MATCH_HOME} away={MATCH_AWAY} score={[21, 16]}
          date="Śr, 26 sie · 19:50" address="Aleja 3 Maja, Stare Miasto" />
        <figcaption class="xp-receipts">
          <span class="xp-item"><b>+<span data-xp="75">75</span> XP</b><small>za wygraną</small></span>
          <span class="xp-item"><b>+<span data-xp="40">40</span> XP</b><small>za rozegrany mecz</small></span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ═══ 3. ZNAJDŹ GRĘ OBOK: przyklejony telefon z Klubem, trzy kroki ═══ -->
  <section class="ch" id="klub">
    <div class="wrap">
      <div class="ch-head rv rv-seq">
        <h2><span class="ln"><span>Znajdź grę obok</span></span></h2>
        <p class="lead">Zakładka Klub pokazuje mecze na boiskach w Twojej okolicy: kto gra, gdzie i o której. Reszta to trzy ruchy.</p>
      </div>
      <div class="scene" data-scene="club" data-step="1">
        <div class="scene-visual">
          <div class="phone" aria-hidden="true">
            <div class="screen">
              <div class="ph-chrome">
                <div class="ph-top">Polska</div>
                <div class="ph-title">HoopConnect</div>
                <div class="ph-tabs"><span class="on">Mecze</span><span>Skład</span><span>Statystyki</span></div>
                <div class="ph-label">Spotkania w pobliżu</div>
              </div>
              <div class="ph-match">
                <MatchCard uid="m3" status="open" dist="2,0 km" home={CLUB_HOME} away={CLUB_AWAY} you="S" fill="B"
                  date="Sob, 29 sie · 19:30" address="Aleja 3 Maja, Stare Miasto" cta="Dołącz do meczu" ctaAlt="Twój mecz · szczegóły" />
              </div>
              <div class="ph-next">
                <span class="ph-next-mode">3v3</span><span class="ph-next-dist">3,4 km</span>
                <b>Nd, 30 sie · 17:00</b><span class="ph-next-where">Błonia, Kraków</span>
              </div>
              <div class="ph-nav"><span></span><span></span><span class="on"></span><span></span><span></span></div>
            </div>
          </div>
        </div>
        <ol class="steps">
          {CLUB_STEPS.map((s, i) => (
            <li class:list={['step', { on: i === 0 }]} data-i={i + 1}>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ═══ 4. KING OF THE COURT: losowanie trójek ═══ -->
  <!-- znacznik: gdy czytelnik tu dojedzie (ok. 1/3 strony), od dołu wysuwa się zapis na newsletter -->
  {NEWSLETTER.enabled && <div id="nlMark" aria-hidden="true"></div>}
  <section class="ch" id="kotc">
    <div class="wrap split">
      <div class="split-copy rv rv-seq">
        <h2><span class="ln"><span>Składy losuje apka.</span></span> <span class="ln"><span>Ty grasz.</span></span></h2>
        <p class="lead">King of the Court to sesja pickupu 3x3 dla całej ekipy. Wchodzisz solo, apka losuje trójki, a po sesji wiadomo, kto jest królem boiska.</p>
        <dl class="facts">
          {KOTC_FACTS.map((f) => <div><dt>{f.t}</dt><dd>{f.d}</dd></div>)}
        </dl>
        <p class="fact">Król boiska zgarnia <b>275 XP</b>, drugie miejsce <b>195</b>, trzecie <b>145</b>.</p>
        <a class="inline-link" href="/klub">Więcej o King of the Court<span class="arw">→</span></a>
      </div>
      <div class="draw rv rv-d1" id="draw">
        <div class="draw-labels" aria-hidden="true">
          {DRAW_TEAMS.map((t) => <span style={`--team:${t.color}`}>{t.name}</span>)}
        </div>
        <div class="draw-grid" role="img" aria-label="Dziewięciu graczy losowanych do trzech drużyn">
          {DRAW_PLAYERS.map((l) => <span class="dr-hex"><i>{l}</i></span>)}
        </div>
        <button class="btn btn-ghost" type="button" id="drawAgain">Losuj jeszcze raz</button>
      </div>
    </div>
  </section>

  <!-- ═══ 5. KARTA GRACZA: przyklejona karta, krok podświetla jej element; obraca ją tylko mysz albo palec ═══ -->
  <section class="ch" id="karta">
    <div class="wrap">
      <div class="ch-head rv rv-seq">
        <h2><span class="ln"><span>Karta rośnie z każdym meczem</span></span></h2>
        <p class="lead">Karta gracza zbiera wszystko, co zagrałeś: arenę, XP i wygrane. Złap ją i obróć.</p>
      </div>
      <div class="scene flip" data-scene="card" data-step="1">
        <div class="scene-visual">
          <div class="pc-stage" data-tilt-card aria-hidden="true">
            <PlayerCard name="Kuba" letter="K" arena={4} arenaName="Ankh Court" nextArena="Void Gem" pct={62} toNext={608} wins={12} kotc={3} hcId="20251" frame="default" uid="sc" lazy />
          </div>
        </div>
        <ol class="steps">
          {CARD_STEPS.map((s, i) => (
            <li class:list={['step', { on: i === 0 }]} data-i={i + 1}>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ═══ 6. ARENY: siedem w rzędzie, przesuwają się same ═══ -->
  <section class="ch ch-center" id="areny">
    <div class="wrap">
      <div class="ch-head rv rv-seq">
        <h2><span class="ln"><span>Siedem aren.</span></span> <span class="ln"><span>Jedna droga.</span></span></h2>
        <p class="lead">Wygrana to XP. XP to arena. Arena zostaje. Zaczynasz od Rozgrzewki i idziesz po Seraphim, a raz zdobyte XP nie znika.</p>
      </div>
    </div>
    <div data-loop class="arena-row rv" aria-label="Siedem aren HoopConnect">
      <div class="arena-track">
        {[...ARENAS, ...ARENAS].map((a) => (
          <figure>
            {a.n === 0
              ? <span class="arena-hex"></span>
              : <img src={`/arenas/web/arena-${a.n}.webp`} width="360" height="360" alt="" loading="lazy" decoding="async" />}
            <figcaption><b>{a.name}</b><span>{a.xp} XP</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 7. RANKING: tablica z apki w HTML; „Ty" wygrywa mecz i wyprzedza gracza nad sobą ═══ -->
  <section class="ch ch-center" id="ranking">
    <div class="wrap">
      <div class="ch-head rv rv-seq">
        <h2><span class="ln"><span>Widać, kto naprawdę gra</span></span></h2>
        <p class="lead">Publiczny ranking ma trzy tablice: XP, mecze i King of the Court. Filtrujesz po mieście, otwierasz bez logowania i podsyłasz link ekipie.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={RANK_URL} target="_blank" rel="noopener">Otwórz ranking<span class="arw">→</span></a>
          <a class="inline-link" href="/ranking">Za co jest XP<span class="arw">→</span></a>
        </div>
      </div>
      <div class="rank-show rv">
        <RankBoard uid="hb" story />
        <p class="rank-cap">Wygrany mecz to <b>75 XP</b>. Czasem tyle wystarczy, żeby wskoczyć na podium.</p>
      </div>
    </div>
  </section>

  <!-- ═══ 8. ASYSTENT TRENINGU: pierścień Draft Score ═══ -->
  <section class="ch" id="trening">
    <div class="wrap split">
      <DraftRing uid="home" score={620} />
      <div class="split-copy rv rv-seq">
        <h2><span class="ln"><span>Nie ma meczu?</span></span> <span class="ln"><span>Jest plan.</span></span></h2>
        <p class="lead">Asystent treningu układa Ci tydzień. Ty wybierasz, ile dni trenujesz, a apka codziennie daje gotowy zestaw ćwiczeń.</p>
        <dl class="facts">
          {TRAIN_FACTS.map((f) => <div><dt>{f.t}</dt><dd>{f.d}</dd></div>)}
        </dl>
        <p class="fact">Z treningu wpada do <b>100 XP</b> tygodniowo. Draft Score nigdy nie trafia do rankingu.</p>
        <a class="inline-link" href="/asystent-treningu">Jak działa asystent treningu<span class="arw">→</span></a>
      </div>
    </div>
  </section>

  <!-- ═══ 9. TRENERZY: jeden rozdział, spokojny głos ═══ -->
  <section class="ch" id="trenerzy">
    <div class="wrap coach">
      <div class="coach-copy rv rv-seq">
        <h2><span class="ln"><span>Prowadzisz drużynę?</span></span> <span class="ln"><span>Masz osobny panel.</span></span></h2>
        <p class="lead">Panel trenera porządkuje to, co zwykle żyje w zeszycie i w arkuszu. Spokojnie, w jednym miejscu.</p>
        <div class="cta-row">
          <a class="btn btn-ghost" href={COACH_OFFER_URL} target="_blank" rel="noopener">Zobacz ofertę<span class="arw">→</span></a>
        </div>
        <p class="coach-note">Panel jest płatny, dla trenerów i klubów. Gracze nie płacą nic.</p>
      </div>
      <dl class="facts rv rv-d1">
        {COACH_FACTS.map((f) => <div><dt>{f.t}</dt><dd>{f.d}</dd></div>)}
      </dl>
    </div>
  </section>

  <!-- ═══ 10. MANIFEST ═══ -->
  <section class="ch" id="manifest">
    <div class="wrap manifest">
      <p class="rv">Najlepsza statystyka nie brzmi <em>„spędziłem godzinę w aplikacji"</em>.</p>
      <p class="rv rv-d2">Brzmi <strong>„zagrałem jeszcze jeden mecz"</strong>.</p>
      <p class="manifest-sig rv rv-d3">Boisko, które pamięta.</p>
    </div>
    <div class="wrap press rv">
      <blockquote>„HoopConnect powstał, aby uporządkować koszykówkę uliczną i pozwolić graczom skupić się na grze."</blockquote>
      <a class="press-src" href="https://3x3basket.pl" target="_blank" rel="noopener">3x3basket.pl<span class="arw">→</span></a>
    </div>
  </section>

  <!-- ═══ 11. PYTANIA ═══ -->
  <section class="ch" id="pytania">
    <div class="wrap faq">
      <div class="ch-head rv rv-seq">
        <h2><span class="ln"><span>Częste pytania</span></span></h2>
        <p class="lead">Krótko o tym, jak działa HoopConnect. Więcej w pełnym <a class="inline-link lower" href="/faq">FAQ</a>.</p>
      </div>
      <div class="home-faq rv rv-d1">
        {HOME_FAQ.map((it) => (
          <details class="hf-item">
            <summary><span class="q">{it.q}</span><span class="chev" aria-hidden="true"></span></summary>
            <p>{it.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 12. ZAMKNIĘCIE ═══ -->
  <section class="ch final" id="zagraj">
    <div class="wrap final-grid">
      <div class="final-copy rv rv-seq">
        <h2><span class="ln"><span>Następny mecz</span></span> <span class="ln"><span>jest Twój</span></span></h2>
        <p class="lead">Apka działa w przeglądarce telefonu, bez sklepu i bez instalacji. Zeskanuj kod, załóż kartę gracza i wyjdź na boisko.</p>
        <div class="cta-row">
          <a class="btn btn-primary btn-lg" href={APP_URL} target="_blank" rel="noopener">Załóż kartę gracza<span class="arw">→</span></a>
        </div>
        <p class="final-sig">Phone down, game up.</p>
      </div>
      <div class="final-qr rv rv-d1" aria-hidden="true">
        <div class="qr-img" set:html={qrSvg} />
        <span>app.hoopconnect.pl</span>
      </div>
    </div>
  </section>
  {NEWSLETTER.enabled && <NewsletterPop />}
</Base>

<style>
  /* ═══ 1. HERO ═══ */
  .hero { position: relative; isolation: isolate; overflow: hidden; padding-block: clamp(24px, 3.4vw, 48px) clamp(56px, 7vw, 104px); }
  /* Światło z góry, za nagłówkiem: napis wychodzi z tła zamiast leżeć na czarnym */
  .hero::before { content: ''; position: absolute; z-index: -2; inset: 0 0 auto 0; height: min(76vh, 720px); pointer-events: none;
    background: radial-gradient(ellipse 58% 66% at 50% 0%, rgba(111,195,255,0.12) 0%, rgba(47,145,214,0.045) 46%, transparent 74%); }
  .hero-head { position: relative; z-index: 3; text-align: center; }
  .hero h1 { margin: 0 auto; line-height: 0.92; letter-spacing: -0.01em; filter: drop-shadow(0 16px 40px rgba(47,145,214,0.30)); }
  .hero h1 { font-size: clamp(50px, min(7.8vw, 13.4svh), 124px); }
  .hero h1 .w { background: linear-gradient(180deg, #FFFFFF 36%, #C3D3EA 100%); -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent; }
  .hero h1 .hl { color: var(--accent-hi); text-shadow: 0 0 44px rgba(111,195,255,0.36); }
  /* Wejście nagłówka: linie wysuwają się z maski (raz, przy ładowaniu) */
  .hero .ln > span { transform: none; animation: line-up var(--dur-3) var(--ease) both; animation-delay: calc(60ms + var(--li, 0) * 120ms); }

  /* Boisko: szerokość ogranicza też wysokość okna, żeby cały kort z paskiem mieścił się na pierwszym ekranie */
  .court-wrap { position: relative; z-index: 1; width: min(100%, 1280px); margin: clamp(10px, 1.6vw, 22px) auto 0; }
  @supports (height: 100svh) {
    .court-wrap { width: min(100%, 1400px, max(700px, calc((100svh - 430px) * 2.25))); }
  }
  /* Parkiet: plama światła na całą szerokość okna, która z każdej strony rozpływa się w tło strony (bez krawędzi) */
  .court-wrap::before { content: ''; position: absolute; z-index: -1; left: 50%; top: -26%; bottom: -32%; width: 100vw;
    transform: translateX(-50%); pointer-events: none;
    background:
      radial-gradient(ellipse 32% 48% at 50% 64%, rgba(111,195,255,0.13) 0%, transparent 70%),
      radial-gradient(ellipse 60% 62% at 50% 58%, #18284A 0%, rgba(21,33,58,0.74) 36%, rgba(14,15,18,0) 74%); }
  /* Scena: proporcje = kadr boiska z generatora, więc % pozycji trafiają w punkty parkietu. Dół sceny = linia końcowa. */
  .court-stage { position: relative; width: 100%; aspect-ratio: var(--ar-desk); container-type: inline-size; touch-action: pan-y;
    animation: rise var(--dur-3) .12s var(--ease) both; }
  .court-wrap .marquee.under-court { width: var(--cw); margin-inline: auto; animation: rise var(--dur-2) 1.1s var(--ease) both; }

  /* Karty: skala rośnie razem ze sceną. --k = szerokość sceny / szerokość wzorcowa (iloraz długości przez tan(atan2())). */
  @property --stage-w { syntax: '<length>'; inherits: true; initial-value: 1280px; }
  .cards { --stage-w: 100cqw; --ref: 1280px; --k: 1; list-style: none; padding: 0; margin: 0; position: absolute; inset: 0; }
  @supports (width: calc(1px * tan(atan2(1px, 1px)))) {
    .cards { --k: tan(atan2(var(--stage-w), var(--ref))); }
  }
  @supports not (width: calc(1px * tan(atan2(1px, 1px)))) {
    @media (max-width: 1180px) { .cards { --k: 0.86; } }
    @media (max-width: 980px) { .cards { --k: 0.7; } }
    @media (max-width: 800px) { .cards { --k: 0.56; } }
    @media (max-width: 640px) { .cards { --k: 1; } }
  }
  /* Karta stoi stopą w punkcie boiska (translate -50%, -100%). Wejście: tylny rząd, skrzydła, Alex. */
  .cards li { position: absolute; left: var(--x); top: var(--y); z-index: var(--z, 1); transform: translate(-50%, -100%);
    animation: card-in var(--dur-3) var(--ease) both; animation-delay: calc(.5s + var(--i, 0) * 90ms); }
  @keyframes card-in { from { opacity: 0; transform: translate(-50%, calc(-100% + 30px)); } }
  /* Cień na parkiecie pod stopą karty */
  .cards li::after { content: ''; position: absolute; z-index: -1; left: 50%; bottom: 0; width: 150%; aspect-ratio: 5 / 1;
    transform: translate(-50%, 56%); background: radial-gradient(ellipse, rgba(0,0,0,0.62), rgba(0,0,0,0.26) 42%, transparent 70%); }
  /* Skala bazowa (dla sceny wzorcowej), głębia (dalsze karty mniejsze i ciemniejsze), kolejność wejścia */
  .cards li:nth-child(1) { --pcsb: 0.30; --z: 1; --i: 0; --dim: 0.74; }
  .cards li:nth-child(2) { --pcsb: 0.30; --z: 1; --i: 1; --dim: 0.74; }
  .cards li:nth-child(3) { --pcsb: 0.42; --z: 2; --i: 2; --dim: 0.87; }
  .cards li:nth-child(4) { --pcsb: 0.42; --z: 2; --i: 3; --dim: 0.87; }
  .cards li:nth-child(5) { --pcsb: 0.66; --z: 4; --i: 4; --dim: 1; }
  /* :global, bo .pc3d-wrap renderuje komponent (nie ma atrybutu zakresu tej strony).
     --pc-edge: jasna krawędź, która odcina kartę od parkietu także w małej skali (1 px na ekranie,
     stąd dzielenie przez skalę). Maluje się razem z cieniem karty, nie jako filtr liczony co klatkę. */
  .cards :global(.pc3d-wrap) { --pcs: calc(var(--pcsb) * var(--k)); --pc-edge: drop-shadow(0 0 calc(1px / var(--pcs)) rgba(190,224,255,0.62)); }
  .pcbtn { --rx0: -6; --ry0: 0; display: block; background: transparent; border: 0; padding: 0; cursor: pointer; touch-action: pan-y; }
  .pcbtn.static { cursor: default; pointer-events: none; }
  /* Głębia: dalsze karty ciemniejsze. Filtr siedzi na samej plakietce, więc liczy się raz, przy malowaniu karty. */
  .pcbtn.static :global(.pc3d-face) { filter: brightness(var(--dim, 1)); }
  .pcbtn :global(.pc3d-card) { transition: none; }
  .pcbtn:focus-visible { outline: 2px solid var(--accent-hi); outline-offset: 6px; }
  .cards li:nth-child(1) .pcbtn { --ry0: 10; }
  .cards li:nth-child(2) .pcbtn { --ry0: -10; }
  .cards li:nth-child(3) .pcbtn { --ry0: 18; }
  .cards li:nth-child(4) .pcbtn { --ry0: -18; }

  /* Tryb podglądu karty Alexa (klik albo tap): karta rośnie od stopy, reszta sceny ciemnieje,
     a kartę obraca mysz albo palec, jak w apce. Skala i przyciemnienie to tylko transform i opacity. */
  .cards li.live .pcbtn { transform-origin: 50% 100%; transition: transform var(--dur-2) var(--ease); }
  .cards li.focus .pcbtn { transform: translateY(-3%) scale(var(--fz, 1.3)); touch-action: none; cursor: grab; }
  .cards li.focus .pcbtn:active { cursor: grabbing; }
  .stage-dim { position: absolute; z-index: 3; inset: -8% -10% -4%; pointer-events: none; opacity: 0;
    background: radial-gradient(ellipse 60% 72% at 50% 56%, rgba(7,8,12,0.74) 0%, rgba(7,8,12,0.56) 52%, rgba(7,8,12,0) 100%);
    transition: opacity var(--dur-2) var(--ease); }
  .court-stage.focus .stage-dim { opacity: 1; pointer-events: auto; }
  .focus-cap { position: absolute; z-index: 7; left: 50%; bottom: 1.5%; margin: 0; display: flex; align-items: center; gap: 14px;
    white-space: nowrap; font-family: var(--display); font-weight: 700; font-size: 12px; letter-spacing: 1.8px; text-transform: uppercase;
    color: var(--text-2); opacity: 0; pointer-events: none; transform: translate(-50%, 8px);
    transition: opacity var(--dur-1) var(--ease), transform var(--dur-1) var(--ease); }
  .court-stage.focus .focus-cap { opacity: 1; pointer-events: auto; transform: translate(-50%, 0); }
  .focus-x { appearance: none; border: 1px solid var(--line-2); border-radius: var(--r); background: var(--bg-2); color: var(--text); cursor: pointer;
    padding: 6px 10px; font: inherit; letter-spacing: 1.4px; }
  .focus-x:hover { border-color: var(--line-3); }
  .focus-x:focus-visible { outline: 2px solid var(--accent-hi); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { .cards li.live .pcbtn, .stage-dim, .focus-cap { transition: none; } }
  /* Alex: plama światła pod stopą stoi w miejscu. Dawniej pulsowała w pętli razem z pierścieniem i sam ten puls
     zajmował ok. 85% pracy karty graficznej na pierwszym ekranie (pomiar), bo każda klatka składała od nowa całą scenę.
     Pierścień rozchodzi się po parkiecie tylko dwa razy po wejściu (sygnał „dotknij"). W podglądzie poświata rośnie. */
  .cards li.live::after { width: 210%; aspect-ratio: 3.6 / 1; opacity: 0.86;
    background: radial-gradient(ellipse, rgba(111,195,255,0.55), rgba(47,145,214,0.2) 42%, transparent 70%);
    transition: opacity var(--dur-2) var(--ease), transform var(--dur-2) var(--ease); }
  .cards li.focus::after { opacity: 1; transform: translate(-50%, 56%) scale(1.2); }
  .cards li.live::before { content: ''; position: absolute; z-index: -1; left: 50%; bottom: 0; width: 170%; aspect-ratio: 3.6 / 1;
    border: 1.5px solid rgba(140,208,255,0.85); border-radius: 50%; opacity: 0; transform: translate(-50%, 50%) scale(0.5);
    animation: live-ping 3.2s cubic-bezier(.2,.6,.3,1) 1.8s 2; }
  @keyframes live-ping {
    0% { opacity: 0; transform: translate(-50%, 50%) scale(0.5); }
    14% { opacity: 0.9; }
    72%, 100% { opacity: 0; transform: translate(-50%, 50%) scale(1.45); }
  }
  /* Po wejściu zdejmujemy animacje wejścia: element z dokończoną animacją (fill: both) trzyma własną powierzchnię
     kompozycji i każda klatka w obrębie sceny składa się przez to drożej. Stan końcowy jest równy stylowi bazowemu. */
  .hero.entered :is(.court-stage, .cards li, .hero-copy, .marquee.under-court, .ln > span) { animation: none; }

  .hero-copy { position: relative; z-index: 2; text-align: center; margin-top: clamp(22px, 3.4vw, 40px); animation: rise var(--dur-2) 1.2s var(--ease) both; }
  .hero-copy .lead { margin: 0 auto 28px; max-width: 52ch; font-size: clamp(18px, 1.6vw, 21px); }
  .hero-copy .cta-row { justify-content: center; }
  .hero-proof { list-style: none; padding: 0; margin-top: 28px; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 26px;
    font-size: 13px; font-weight: 600; letter-spacing: 0.3px; color: var(--text-2); }
  .hero-proof li { display: inline-flex; align-items: center; gap: 9px; }
  .hero-proof li::before { content: ''; width: 6px; height: 6px; background: var(--accent); transform: rotate(45deg); }
  .stage-hint { margin-top: 22px; display: inline-flex; align-items: center; gap: 10px; font-family: var(--display); font-weight: 700;
    font-size: 11px; letter-spacing: 1.8px; text-transform: uppercase; color: var(--text-3); }
  .stage-hint span { width: 7px; height: 7px; background: var(--accent); transform: rotate(45deg); animation: pulse 2.4s ease-in-out infinite; }
  @keyframes pulse { 0%, 100% { opacity: 1; transform: rotate(45deg) scale(1); } 50% { opacity: .45; transform: rotate(45deg) scale(1.5); } }

  /* Telefon: osobny kadr boiska (kamera wyżej), scena odrobinę szersza niż ekran, pasek na całą szerokość */
  @media (max-width: 640px) {
    .court-wrap { margin-top: 16px; }
    .court-stage { width: 104%; margin-left: -2%; aspect-ratio: var(--ar-mob); }
    .court-wrap .marquee.under-court { width: 100%; }
    .cards { --ref: 390px; }
    .cards li { left: var(--mx); top: var(--my); }
    .cards li:nth-child(1), .cards li:nth-child(2) { --pcsb: 0.21; }
    .cards li:nth-child(3), .cards li:nth-child(4) { --pcsb: 0.27; }
    .cards li:nth-child(5) { --pcsb: 0.38; }
    .cards li.focus .pcbtn { --fz: 1.5; }
    .focus-cap { font-size: 10.5px; letter-spacing: 1.4px; gap: 10px; bottom: 0.5%; }
  }

  /* ═══ ROZDZIAŁY: wspólny system (.ch, .ch-head, .facts, .scene, .split…) jest w global.css; tu tylko to, co własne strony ═══ */

  /* 2. Karta meczu: komponent z apki, skalowany zmienną --mcs (1 = rozmiar w apce) */
  .matchcard { margin: 0 auto; display: grid; justify-items: center; --mcs: 2.2; }
  .matchcard :global(.mc) { box-shadow: 0 30px 70px rgba(0,0,0,0.55); }
  @media (max-height: 940px) { .matchcard { --mcs: 1.9; } }      /* laptop: karta i XP pod nią mieszczą się na jednym ekranie */
  @media (max-width: 1099px) { .matchcard { --mcs: 1.7; } }
  @media (max-width: 699px) { .matchcard { --mcs: 1.02; } }
  .xp-receipts { margin-top: clamp(28px, 4vw, 44px); display: flex; justify-content: center; gap: clamp(36px, 8vw, 96px); text-align: center; }
  .xp-item { display: grid; gap: 4px; transition: opacity var(--dur-2) var(--ease), transform var(--dur-2) var(--ease); }
  .xp-item:nth-child(2) { transition-delay: 140ms; }
  .xp-item b { font-family: var(--display); font-weight: 700; font-size: clamp(34px, 4.4vw, 60px); line-height: 1; color: var(--accent-hi);
    font-variant-numeric: tabular-nums; letter-spacing: -0.01em; }
  .xp-item:nth-child(2) b { color: var(--text); }
  .xp-item small { font-size: 14px; color: var(--text-2); }
  .matchcard.xp-pre .xp-item { opacity: 0; transform: translateY(14px); }

  /* 3. Telefon z zakładką Klub: obudowa i nagłówek ekranu w HTML, karta meczu to komponent z apki */
  .phone { width: 300px; height: 600px; padding: 10px; border-radius: 46px; background: #0B0F16;
    border: 1px solid rgba(255,255,255,0.16); box-shadow: 0 40px 90px rgba(0,0,0,0.6); }
  .screen { position: relative; height: 100%; border-radius: 37px; overflow: hidden; padding: 42px 16px 0;
    background: radial-gradient(ellipse 120% 68% at 50% -10%, rgba(91,184,245,0.16) 0%, transparent 60%),
      linear-gradient(170deg, #14243E 0%, #0B172A 52%, #060E1A 100%); }
  .screen::before { content: ''; position: absolute; top: 12px; left: 50%; transform: translateX(-50%); width: 86px; height: 24px;
    border-radius: 14px; background: #05080E; }
  .ph-top { display: flex; align-items: center; gap: 7px; font-family: var(--display); font-weight: 700; font-size: 9px;
    letter-spacing: 3px; text-transform: uppercase; color: #6F86A6; }
  .ph-top::before { content: ''; width: 11px; height: 8px; background: linear-gradient(#F4F4F4 50%, #DC143C 50%); border-radius: 1px; }
  .ph-title { font-family: var(--display); font-weight: 900; font-size: 28px; letter-spacing: 0.02em; text-transform: uppercase;
    color: #F2F7FF; line-height: 1; margin: 6px 0 10px; }
  .ph-tabs { display: grid; grid-template-columns: repeat(3, 1fr); padding: 3px; border-radius: 999px; background: rgba(8,16,30,0.7);
    border: 1px solid rgba(150,200,255,0.12); }
  .ph-tabs span { text-align: center; padding: 8px 0; border-radius: 999px; font-family: var(--display); font-weight: 700; font-size: 9.5px;
    letter-spacing: 2px; text-transform: uppercase; color: #7D93B0; }
  .ph-tabs .on { background: linear-gradient(135deg, #3B8FE8, #1E6BB0); color: #fff; }
  .ph-label { margin: 12px 0 6px; font-family: var(--display); font-weight: 700; font-size: 9.5px; letter-spacing: 2.6px;
    text-transform: uppercase; color: #6F86A6; }
  .ph-match { --mcs: 0.78; }
  .ph-match :global(.mc) { width: 100%; }
  .ph-next { margin-top: 10px; display: grid; grid-template-columns: auto 1fr; gap: 2px 8px; align-items: center; padding: 10px 12px;
    border-radius: 14px; border: 1px solid rgba(160,200,255,0.14); background: rgba(9,22,44,0.5);
    opacity: 0; transform: translateY(22px); transition: opacity var(--dur-2) var(--ease), transform var(--dur-2) var(--ease); }
  .ph-next-mode { font-family: var(--display); font-weight: 800; font-size: 8px; letter-spacing: 1.4px; text-transform: uppercase; color: #00CCFF;
    padding: 2px 7px; border-radius: 6px; background: rgba(0,204,255,0.11); justify-self: start; }
  .ph-next-dist { font-size: 9px; font-weight: 700; color: #00CCFF; justify-self: end; }
  .ph-next b { grid-column: 1 / -1; font-family: var(--display); font-weight: 800; font-size: 12px; color: #EAF2FF; margin-top: 4px; }
  .ph-next-where { grid-column: 1 / -1; font-size: 9.5px; color: rgba(224,238,255,0.62); }
  .ph-nav { position: absolute; left: 50%; bottom: 8px; transform: translateX(-50%); display: flex; align-items: center; gap: 20px;
    padding: 7px 18px; border-radius: 999px; background: rgba(8,16,30,0.82); border: 1px solid rgba(150,200,255,0.1); }
  .ph-nav span { width: 13px; height: 13px; border-radius: 3px; border: 1.5px solid #9A7556; }
  .ph-nav span:nth-child(2) { border-radius: 50%; }
  .ph-nav span:nth-child(4) { transform: rotate(45deg); width: 11px; height: 11px; }
  .ph-nav .on { width: 38px; height: 38px; border: 0; border-radius: 50%; background: #2F7FE0; display: grid; place-items: center;
    box-shadow: 0 0 18px rgba(47,127,224,0.55); transform: none; }
  .ph-nav .on::before { content: ''; width: 16px; height: 16px; background: #fff; clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%); }
  /* Karta meczu przełącza się klasami .mc-step-N na scenie (patrz MatchCard.astro); następny mecz wjeżdża w kroku 3 */
  .scene[data-scene="club"][data-step="3"] .ph-next { opacity: 1; transform: none; }
  @media (max-width: 899px) {
    /* Na telefonie telefon w telefonie nie ma sensu: zostaje sama karta meczu, większa */
    .phone { width: auto; height: auto; padding: 0; border: 0; border-radius: 0; background: none; box-shadow: none; }
    .screen { height: auto; padding: 0; border-radius: 0; overflow: visible; background: none; }
    .screen::before, .ph-chrome, .ph-next, .ph-nav { display: none; }
    .ph-match { --mcs: 0.92; display: grid; justify-items: center; }
    .ph-match :global(.mc) { width: 34.3em; }
  }

  /* 4. Losowanie trójek: 9 hexów, pole startowe 3x3, po losowaniu kolumna = drużyna (kolor z apki) */
  .draw { --cell: 78px; --gap: 14px; display: grid; justify-items: center; gap: 28px; justify-self: center; }
  .draw-labels { display: grid; grid-template-columns: repeat(3, var(--cell)); gap: var(--gap); }
  .draw-labels span { text-align: center; font-family: var(--display); font-weight: 700; font-size: 13px; letter-spacing: 2.4px;
    text-transform: uppercase; color: var(--team); opacity: 0; transform: translateY(6px);
    transition: opacity var(--dur-2) var(--ease), transform var(--dur-2) var(--ease); }
  .draw.drawn .draw-labels span { opacity: 1; transform: none; }
  .draw-grid { display: grid; grid-template-columns: repeat(3, var(--cell)); gap: var(--gap); }
  .dr-hex { --team: var(--line-3); --dx: 0; --dy: 0; --d: 0ms; position: relative; width: var(--cell); aspect-ratio: 1; display: grid;
    place-items: center; clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%); background: var(--team);
    transform: translate(calc(var(--dx) * (var(--cell) + var(--gap))), calc(var(--dy) * (var(--cell) + var(--gap))));
    transition: transform var(--dur-3) var(--ease) var(--d); }
  .dr-hex::before { content: ''; position: absolute; inset: 0; background: var(--line-3); transition: opacity var(--dur-2) var(--ease) var(--d); }
  .dr-hex.drawn::before { opacity: 0; }
  .dr-hex i { position: relative; width: calc(100% - 4px); aspect-ratio: 1; display: grid; place-items: center; background: var(--panel-2);
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%); font-style: normal; font-family: var(--display);
    font-weight: 700; font-size: 24px; color: var(--text); }
  .draw .btn { margin-top: 6px; }
  @media (max-width: 599px) { .draw { --cell: 62px; --gap: 10px; } .dr-hex i { font-size: 20px; } }

  /* 5. Karta gracza: stoi nieruchomo; obraca ją tylko mysz w pobliżu albo przeciągnięcie palcem (jak w apce). Krok podświetla element. */
  .pc-stage { --rx0: -6; --ry0: -14; touch-action: pan-y; cursor: grab; }
  .pc-stage:active { cursor: grabbing; }
  .pc-stage :global(.pc3d-wrap) { --pcs: 1.04; }
  .pc-stage :global(.pc3d-card) { transition: none; }
  .pc-stage :global(:is(.pc3d-av, .pc3d-name, .pc3d-arena, .pc3d-prog, .pc3d-cap, .pc3d-stats)) {
    transition: opacity var(--dur-2) var(--ease); }
  .scene[data-scene="card"][data-step="1"] .pc-stage :global(:is(.pc3d-arena, .pc3d-prog, .pc3d-cap, .pc3d-stats)) { opacity: 0.28; }
  .scene[data-scene="card"][data-step="2"] .pc-stage :global(:is(.pc3d-av, .pc3d-prog, .pc3d-cap, .pc3d-stats)) { opacity: 0.28; }
  .scene[data-scene="card"][data-step="3"] .pc-stage :global(:is(.pc3d-av, .pc3d-name, .pc3d-arena, .pc3d-stats)) { opacity: 0.28; }
  .scene[data-scene="card"][data-step="4"] .pc-stage :global(:is(.pc3d-av, .pc3d-name, .pc3d-arena, .pc3d-prog, .pc3d-cap)) { opacity: 0.28; }
  @media (max-width: 899px) { .pc-stage :global(.pc3d-wrap) { --pcs: 0.62; } }

  /* 6. Areny: jeden rząd, przesuwa się sam (pauza na hover), maska po bokach */
  .arena-row { overflow: hidden; margin-top: clamp(8px, 2vw, 24px);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .arena-track { display: flex; width: max-content; gap: clamp(28px, 4vw, 56px); padding: 24px clamp(14px, 2vw, 28px);
    animation: marquee 52s linear infinite; }
  .arena-row:hover .arena-track { animation-play-state: paused; }
  .arena-track figure { display: grid; justify-items: center; gap: 16px; width: clamp(120px, 14vw, 172px); }
  .arena-track img, .arena-hex { width: clamp(96px, 11vw, 140px); height: auto; aspect-ratio: 1; }
  .arena-hex { display: block; width: clamp(78px, 9vw, 112px); margin-block: clamp(9px, 1vw, 14px);
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    background: linear-gradient(135deg, #AABBD8, #5566AA 55%, #0C0E22); }
  .arena-track figcaption { text-align: center; }
  .arena-track figcaption b { display: block; font-family: var(--display); font-weight: 700; font-size: 15px; letter-spacing: 1px;
    text-transform: uppercase; color: var(--text); white-space: nowrap; }
  .arena-track figcaption span { display: block; margin-top: 3px; font-size: 13px; color: var(--accent-hi); font-variant-numeric: tabular-nums; }
  @media (prefers-reduced-motion: reduce) {
    .arena-row { overflow-x: auto; -webkit-mask-image: none; mask-image: none; }
  }

  /* 7. Ranking: tablica z apki (RankBoard), skalowana zmienną --rbs */
  .rank-show { --rbs: 1; }
  .rank-cap { margin: clamp(24px, 3vw, 36px) auto 0; text-align: center; color: var(--text-2); font-size: clamp(16px, 1.3vw, 18px); max-width: 48ch; }
  .rank-cap b { color: var(--accent-hi); font-weight: 600; }
  @media (max-width: 699px) { .rank-show { --rbs: 0.98; } }

  /* 8. Pierścień Draft Score to komponent (DraftRing); na desktopie stoi po prawej */
  @media (min-width: 940px) { #trening :global(.ring-wrap) { order: 2; } }

  /* 9. Trenerzy: typograficzny, bez pudełka; fakty w drugiej kolumnie */
  .coach { display: grid; gap: clamp(32px, 5vw, 80px); align-items: center; }
  .coach-copy h2 { margin-bottom: 18px; font-size: clamp(34px, 4.6vw, 68px); }
  .coach-copy .lead { margin-bottom: 30px; }
  .coach-note { margin-top: 22px; font-size: 15px; color: var(--text-3); }
  .coach .facts { margin-bottom: 0; }
  @media (min-width: 940px) { .coach { grid-template-columns: 1.1fr 0.9fr; } }

  /* 10. Manifest + cytat ze źródłem */
  .manifest { max-width: 1000px; font-family: var(--display); font-weight: 700; text-transform: uppercase;
    font-size: clamp(32px, 5.6vw, 76px); line-height: 1.0; letter-spacing: -0.5px; }
  .manifest p + p { margin-top: 0.35em; }
  .manifest em { font-style: normal; color: var(--text-3); }
  .manifest strong { font-weight: inherit; color: var(--accent-hi); }
  .manifest .manifest-sig { margin-top: 1.1em; font-size: 0.4em; letter-spacing: 2.4px; color: var(--text-2); }
  .press { max-width: 1000px; margin-top: clamp(56px, 7vw, 96px); }
  .press blockquote { font-family: var(--display); font-weight: 500; font-size: clamp(20px, 2.4vw, 28px); line-height: 1.25;
    color: var(--text-2); margin-bottom: 14px; }
  .press-src { display: inline-flex; align-items: center; gap: 8px; font-family: var(--display); font-weight: 700; text-transform: uppercase;
    letter-spacing: 1px; color: var(--accent-hi); font-size: 14px; }

  /* 11. Pytania: rozwijane, bez pudełek i linii */
  .faq { display: grid; gap: clamp(20px, 4vw, 64px); align-items: start; }
  .faq .ch-head { margin-bottom: 0; }
  .home-faq { display: grid; gap: 4px; }
  .hf-item summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 16px 0; }
  .hf-item summary::-webkit-details-marker { display: none; }
  .hf-item .q { font-family: var(--display); font-weight: 600; font-size: clamp(20px, 2.2vw, 26px); letter-spacing: -0.2px;
    color: var(--text); line-height: 1.2; transition: color var(--dur-1) var(--ease); }
  .hf-item summary:hover .q, .hf-item[open] .q { color: var(--accent-hi); }
  .hf-item .chev { flex-shrink: 0; width: 11px; height: 11px; border-right: 2px solid var(--text-2); border-bottom: 2px solid var(--text-2);
    transform: rotate(45deg); transition: transform var(--dur-1) var(--ease); margin-top: -4px; }
  .hf-item[open] .chev { transform: rotate(-135deg); margin-top: 4px; border-color: var(--accent-hi); }
  .hf-item p { color: var(--text-2); font-size: 16px; line-height: 1.65; margin: 0 0 22px; max-width: 62ch; animation: faq-in var(--dur-1) var(--ease) both; }
  @keyframes faq-in { from { opacity: 0; transform: translateY(-4px); } }
  @media (min-width: 940px) { .faq { grid-template-columns: 0.8fr 1.2fr; } }

  /* 12. Zamknięcie: bez ramki, QR na desktopie */
  .final { padding-bottom: clamp(96px, 12vw, 184px); }
  .final-grid { display: grid; gap: 40px; align-items: center; }
  .final h2 { margin-bottom: 18px; font-size: clamp(44px, 6.4vw, 96px); }
  .final .lead { margin-bottom: 30px; max-width: 46ch; }
  .final-sig { margin-top: 28px; font-family: var(--display); font-weight: 700; text-transform: uppercase; letter-spacing: 2.2px;
    font-size: 14px; color: var(--text-3); }
  .final-qr { display: none; flex-direction: column; align-items: center; gap: 12px; justify-self: end; }
  .qr-img { width: 200px; height: 200px; padding: 14px; background: #fff; }
  .qr-img :global(svg) { display: block; width: 100%; height: 100%; }
  .final-qr span { font-family: var(--display); font-weight: 700; letter-spacing: 1.4px; font-size: 13px; color: var(--text-2); text-transform: uppercase; }
  @media (min-width: 820px) { .final-grid { grid-template-columns: 1fr auto; gap: 72px; } .final-qr { display: flex; } }
</style>

<script>
  import { countUp, initCounters, initScenes, onceVisible, prefersReducedMotion, hasIO, wait } from '../scripts/motion'

  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches
  const reduce = prefersReducedMotion()

  // ── Tilt kart (Alex na boisku, karta w rozdziale „Karta gracza"): lekki obrót w stronę kursora w promieniu,
  //    przeciąganie myszą albo palcem obraca kartę jak w apce, puszczenie wraca do spoczynku.
  //    Klik albo tap na Alexie włącza podgląd: karta lekko rośnie, a obrót ma pełny zakres (setFocus niżej).
  //    Jedna pętla rAF, która działa tylko w trakcie ruchu. Ruch niczego nie maluje: skrypt ustawia transform
  //    na trzech elementach (karta i dwie warstwy połysku), resztę składa karta graficzna. W przeglądarkach
  //    bez sin() w CSS zostaje droga przez zmienne --rx0/--ry0 (wtedy połysk to zwykły gradient).
  const TRIG = typeof CSS !== 'undefined' && CSS.supports('width', 'calc(1px * sin(1deg))')
  type Tilt = {
    el: HTMLElement; zone: HTMLElement; rest: { x: number; y: number }; rx: number; ry: number; tx: number; ty: number
    card: HTMLElement | null; holo: HTMLElement | null; spec: HTMLElement | null; px: number; py: number; focus: boolean; t0: number
  }
  const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('.pcbtn[data-i]'))
  const tilts: Tilt[] = []
  const addTilt = (el: HTMLElement, zone: HTMLElement, rest: { x: number; y: number }) => {
    el.classList.add('pc-live')            // połysk dostaje własne warstwy (PlayerCard.astro)
    tilts.push({
      el, zone, rest, rx: rest.x, ry: rest.y, tx: rest.x, ty: rest.y,
      card: el.querySelector('.pc3d-card'), holo: el.querySelector('.pc3d-holo'), spec: el.querySelector('.pc3d-spec'),
      px: NaN, py: NaN, focus: false, t0: 0,
    })
  }
  const stage = document.getElementById('courtStage')
  btns.forEach((b) => addTilt(b, stage ?? b, { x: -6, y: 0 }))
  document.querySelectorAll<HTMLElement>('[data-tilt-card]').forEach((el) => addTilt(el, el.parentElement ?? el, { x: -6, y: -14 }))
  // Te same wzory, co w CSS karty: obrót plakietki, kąt i długość linii połysku, przesunięcie odblasku.
  const paint = (c: Tilt) => {
    if (c.px === c.rx && c.py === c.ry) return
    c.px = c.rx; c.py = c.ry
    if (TRIG && c.card) {
      const a = 118 + c.ry * 1.6, r = (a * Math.PI) / 180
      const len = Math.abs(Math.sin(r)) * 300 + Math.abs(Math.cos(r)) * 452
      c.card.style.transform = `scale(var(--pcs)) translate(150px, 226px) perspective(1150px) rotateX(${c.rx.toFixed(2)}deg) rotateY(${c.ry.toFixed(2)}deg) translate(-150px, -226px)`
      if (c.holo) c.holo.style.transform = `rotate(${a.toFixed(2)}deg) scaleY(${(len / 560).toFixed(4)})`
      if (c.spec) c.spec.style.transform = `translate(${(c.ry * 4.5).toFixed(1)}px, ${(c.rx * -6.328).toFixed(1)}px)`
    } else {
      c.el.style.setProperty('--rx0', c.rx.toFixed(2)); c.el.style.setProperty('--ry0', c.ry.toFixed(2))
    }
  }
  let drag: { t: Tilt; sx: number; sy: number; brx: number; bry: number; moved: boolean } | null = null
  let running = false
  const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v))
  const loop = (now: number) => {
    let busy = false
    for (const c of tilts) {
      let gx = c.tx, gy = c.ty
      if (c.focus && !reduce && (!drag || drag.t !== c)) {
        // podgląd: karta delikatnie się buja (jak w apce), dopóki nikt jej nie trzyma
        const s = (now - c.t0) / 1000
        gx += Math.sin(s * 0.9) * 2.2; gy += Math.sin(s * 0.62) * 5
        busy = true
      }
      c.rx += (gx - c.rx) * 0.12; c.ry += (gy - c.ry) * 0.12
      if (Math.abs(gx - c.rx) > 0.03 || Math.abs(gy - c.ry) > 0.03) busy = true
      paint(c)
    }
    if (busy || drag) requestAnimationFrame(loop); else running = false
  }
  const kick = () => { if (!running) { running = true; requestAnimationFrame(loop) } }

  // Kursor (desktop): w promieniu zależnym od wielkości karty obraca się ona w stronę myszy;
  // w podglądzie karta patrzy za kursorem na całej scenie.
  if (fine && !reduce) {
    new Set(tilts.map((t) => t.zone)).forEach((zone) => {
      zone.addEventListener('pointermove', (e) => {
        if (drag) return
        for (const t of tilts) {
          if (t.zone !== zone) continue
          const r = t.el.getBoundingClientRect()
          const dx = e.clientX - (r.left + r.width / 2), dy = e.clientY - (r.top + r.height / 2)
          if (t.focus) {
            const z = zone.getBoundingClientRect()
            t.ty = clamp((dx / (z.width / 2)) * 28, -20, 20); t.tx = t.rest.x - clamp((dy / (z.height / 2)) * 18, -12, 12)
            continue
          }
          const R = Math.max(190, r.width * 1.1), d = Math.hypot(dx, dy)
          if (d < R) { const k = 1 - d / R; t.ty = t.rest.y + (dx / R) * 22 * k; t.tx = t.rest.x - (dy / R) * 16 * k }
          else { t.tx = t.rest.x; t.ty = t.rest.y }
        }
        kick()
      })
      zone.addEventListener('pointerleave', () => { for (const t of tilts) if (t.zone === zone) { t.tx = t.rest.x; t.ty = t.rest.y } kick() })
    })
  }

  // Przeciąganie = obrót (mysz i dotyk; poza podglądem pionowy ruch palca nadal przewija stronę).
  // Klik po przeciągnięciu jest ignorowany.
  for (const t of tilts) {
    const b = t.el
    b.addEventListener('pointerdown', (e) => {
      drag = { t, sx: e.clientX, sy: e.clientY, brx: t.rx, bry: t.ry, moved: false }
      try { b.setPointerCapture(e.pointerId) } catch {}
      kick()
    })
    b.addEventListener('pointermove', (e) => {
      if (!drag || drag.t !== t) return
      const dx = e.clientX - drag.sx, dy = e.clientY - drag.sy
      if (Math.hypot(dx, dy) > 6) drag.moved = true
      t.ty = clamp(drag.bry + dx * 0.38, -46, 46); t.tx = clamp(drag.brx - dy * 0.34, -34, 34)
    })
    const end = () => {
      if (!drag || drag.t !== t) return
      t.tx = t.rest.x; t.ty = t.rest.y
      const moved = drag.moved
      drag = null; kick()
      if (moved) b.dataset.swallow = '1'
    }
    b.addEventListener('pointerup', end); b.addEventListener('pointercancel', end)
    b.addEventListener('click', (e) => { if (b.dataset.swallow) { delete b.dataset.swallow; e.preventDefault(); e.stopImmediatePropagation() } }, true)
  }

  // Po wejściu hero zdejmujemy dokończone animacje wejścia (patrz .hero.entered w stylach)
  setTimeout(() => document.querySelector('.hero')?.classList.add('entered'), 2600)

  // ── Podgląd karty Alexa: klik albo tap podnosi kartę (lekko rośnie, scena ciemnieje) i daje pełny obrót.
  //    Wyjście: klik obok, przycisk „Odłóż", Esc, ponowny klik w kartę albo zjechanie poza boisko.
  const alexBtn = btns[0]
  const alex = tilts.find((t) => t.el === alexBtn)
  const alexLi = alexBtn?.closest('li')
  const focusX = document.querySelector<HTMLButtonElement>('.focus-x')
  const setFocus = (on: boolean) => {
    if (!alex || !alexBtn || !alexLi || !stage || alex.focus === on) return
    alex.focus = on; alex.t0 = performance.now()
    alex.tx = alex.rest.x; alex.ty = alex.rest.y
    stage.classList.toggle('focus', on); alexLi.classList.toggle('focus', on)
    alexBtn.setAttribute('aria-pressed', String(on))
    alexBtn.setAttribute('aria-label', on
      ? 'Karta gracza: Alex, podniesiona. Przeciągnij, żeby obrócić. Naciśnij ponownie, żeby odłożyć'
      : 'Karta gracza: Alex. Naciśnij, żeby ją podnieść i obrócić')
    if (focusX) focusX.tabIndex = on ? 0 : -1
    kick()
  }
  alexBtn?.addEventListener('click', () => setFocus(!alex?.focus))
  focusX?.addEventListener('click', () => { setFocus(false); alexBtn?.focus() })
  document.addEventListener('click', (e) => { if (alex?.focus && !(e.target as HTMLElement).closest('.pcbtn, .focus-cap')) setFocus(false) })
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && alex?.focus) setFocus(false) })
  if (stage && hasIO()) new IntersectionObserver((en) => { if (!en[0].isIntersecting) setFocus(false) }, { threshold: 0 }).observe(stage)

  // ── Karta meczu „na żywo": hexy wchodzą, wynik nabija się od zera, potem zieleń zwycięzcy, „Zakończony" i XP.
  //    Bez JS albo przy ograniczonym ruchu widać od razu stan końcowy (taki jest w HTML).
  document.querySelectorAll<HTMLElement>('.mc[data-live]').forEach((mc) => {
    const nums = Array.from(mc.querySelectorAll<HTMLElement>('.mc-score b'))
    if (nums.length !== 2 || reduce || !hasIO()) return
    const to = nums.map((n) => Number(n.dataset.to))
    const fig = mc.closest('figure')
    const xp = fig ? Array.from(fig.querySelectorAll<HTMLElement>('[data-xp]')) : []
    nums.forEach((n) => { n.textContent = '0' })
    xp.forEach((x) => { x.textContent = '0' })
    mc.classList.add('mc-pre'); fig?.classList.add('xp-pre')
    onceVisible(mc, async () => {
      mc.classList.add('mc-on')
      await wait(700)
      await Promise.all(nums.map((n, i) => countUp(n, to[i], 1500)))
      mc.classList.remove('mc-pre')
      await wait(350)
      fig?.classList.remove('xp-pre')
      xp.forEach((x, i) => { setTimeout(() => countUp(x, Number(x.dataset.xp), 900), i * 140) })
    }, 0.45)
  })

  // ── Liczniki pojedyncze (Draft Score w pierścieniu) i sceny sticky (Klub, Karta gracza) ze wspólnego modułu.
  //    Karta meczu w scenie Klub przełącza stan klasą .mc-step-N na scenie (patrz MatchCard.astro).
  initCounters()
  initScenes((scene, step) => {
    scene.classList.remove('mc-step-1', 'mc-step-2', 'mc-step-3', 'mc-step-4')
    scene.classList.add(`mc-step-${step}`)
  })

  // ── King of the Court: losowanie trójek. Raz samo, gdy rozdział wjedzie na ekran; potem przycisk losuje od nowa.
  //    Każdy hex leci z pola startowego (siatka 3x3) na cel: kolumna = drużyna, wiersz = miejsce w trójce.
  const draw = document.getElementById('draw')
  const drawBtn = document.getElementById('drawAgain')
  if (draw) {
    const hexes = Array.from(draw.querySelectorAll<HTMLElement>('.dr-hex'))
    const TEAMS = ['#3B82F6', '#22C55E', '#F43F5E']   // Blue / Green / Red, jak w apce
    let busy = false
    const shuffle = (a: number[]) => { for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]] } return a }
    const run = () => {
      shuffle(hexes.map((_, i) => i)).forEach((src, k) => {
        const team = k % 3, row = Math.floor(k / 3), c0 = src % 3, r0 = Math.floor(src / 3)
        const h = hexes[src]
        h.style.setProperty('--dx', String(team - c0)); h.style.setProperty('--dy', String(row - r0))
        h.style.setProperty('--team', TEAMS[team]); h.style.setProperty('--d', `${k * 70}ms`)
        h.classList.add('drawn')
      })
      draw.classList.add('drawn')
    }
    const reset = () => {
      hexes.forEach((h, i) => { h.style.setProperty('--dx', '0'); h.style.setProperty('--dy', '0'); h.style.setProperty('--d', `${i * 30}ms`); h.classList.remove('drawn') })
      draw.classList.remove('drawn')
    }
    onceVisible(draw, () => { setTimeout(run, 500) }, 0.5)
    drawBtn?.addEventListener('click', () => {
      if (busy) return
      busy = true; reset()
      setTimeout(run, 950); setTimeout(() => { busy = false }, 2300)
    })
  }
</script>
